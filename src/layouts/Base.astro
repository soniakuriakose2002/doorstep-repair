---
import '../styles/global.css';
import { site, nav, price } from '../data/site';
import { categories, iconPaths } from '../data/devices';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.tagline} — screens, batteries and more for every major phone brand.` } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Services mega menu. Every link lands on the Services page — the site stays three pages.
const brandLink = (catId: string, q: string) => `/services?cat=${catId}&q=${encodeURIComponent(q)}#catalog`;
const cat = (id: string) => categories.find((c) => c.id === id)!;
const megaHero = cat('mobile');
const megaTiles = ['laptop', 'printer', 'cctv', 'network', 'data'].map(cat);
const megaBrands = [
  ...cat('mobile').brands.slice(0, 6).map((b) => ({ label: b.name, href: brandLink('mobile', b.name.split(' ')[0]) })),
  ...cat('laptop').brands.slice(1, 6).map((b) => ({ label: b.name, href: brandLink('laptop', b.name) })),
];
---

<!doctype html>
<html lang="en" data-theme="blue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const ok = ['green', 'blue', 'red', 'teal', 'yellow', 'orange', 'slate'];
        let t = new URLSearchParams(location.search).get('theme');
        try { if (t && ok.includes(t)) localStorage.setItem('theme', t); else t = localStorage.getItem('theme'); } catch {}
        if (t === 'green') delete document.documentElement.dataset.theme;
        else if (t && ok.includes(t)) document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="grid"></span>
    </div>

    <header class="nav">
      <div class="wrap nav-inner glass">
        <a href="/" class="logo">
          <picture class="logo-img">
            <source srcset="/brand/danat-logo.webp" type="image/webp" />
            <img src="/brand/danat-logo.png" alt="" width="40" height="40" />
          </picture>
          {site.name}
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => n.href === '/services' ? (
              <li class="has-mega">
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined} aria-haspopup="true">
                  {n.label}
                  <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </a>
                <div class="mega" role="region" aria-label="Services menu">
                  <a class="b-tile b-hero" style="--i:0" href={`/services?cat=${megaHero.id}#catalog`}>
                    <span class="b-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
                    <span class="b-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[megaHero.icon]} /></span>
                    <strong>{megaHero.name}</strong>
                    <small>{megaHero.short}. Every major brand, at your door or picked up.</small>
                    <span class="b-count">{megaHero.brands.length} brands · {megaHero.brands.reduce((n, b) => n + b.models.length, 0)} models</span>
                  </a>
                  {megaTiles.map((c, i) => (
                    <a class="b-tile" href={`/services?cat=${c.id}#catalog`} style={`--h:${c.hue}; --i:${i + 1}`}>
                      <span class="b-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
                      <span class="b-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                      <strong>{c.name}</strong>
                      <small>{c.short}</small>
                    </a>
                  ))}
                  <a class="b-tile b-cta" style="--i:6" href="/services#book">
                    <span class="b-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
                    <span class="b-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span>
                    <span class="b-live"><i></i>Technicians available now</span>
                    <strong>Book a repair</strong>
                    <small>Doorstep or pickup across {site.country} · <em>{price()}</em></small>
                  </a>
                  <div class="b-brands" style="--i:7">
                    <span>Brands</span>
                    <div class="b-marquee">
                      <div class="b-track">
                        {[...megaBrands, ...megaBrands].map((b, i) => <a href={b.href} tabindex={i >= megaBrands.length ? -1 : undefined} aria-hidden={i >= megaBrands.length ? 'true' : undefined}>{b.label}</a>)}
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/services#book" class="btn btn-primary nav-cta">Book a repair</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <a href="/" class="logo">{site.name}</a>
          <p class="muted">{site.tagline}. Doorstep repair and pickup across {site.country} since {site.since} — branches in {site.branches.join(', ')}.</p>
          <ul class="contact">
            <li><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>{site.address}</li>
          </ul>
        </div>
        <ul class="footer-nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>All estimates shown as {price()} — pricing to be announced.</span>
      </div>
    </footer>

    <div class="theme-pick" data-theme-pick>
      <button type="button" class="theme-toggle" aria-expanded="false" aria-label="Change colour theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4.1-4-7.6-9-7.6z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10.5" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/></svg>
        Theme
      </button>
      <div class="theme-menu" role="group" aria-label="Colour theme" hidden>
        {[
          ['green', 'Green', '#2fd07f', '#07120e'],
          ['blue', 'Blue', '#1d4ed8', '#f4f7fc'],
          ['red', 'Red', '#e11d2e', '#faf7f7'],
          ['teal', 'Teal', '#0d9488', '#f2f8f7'],
          ['yellow', 'Yellow', '#f5b400', '#17171a'],
          ['orange', 'Orange', '#ff5a1f', '#f7f4ee'],
          ['slate', 'Slate', '#2f6bff', '#e6eaf0'],
        ].map(([id, label, a, b]) => (
          <button type="button" data-theme-id={id} aria-pressed="false">
            <span class="sw" style={`--a:${a};--b:${b}`}></span>{label}
          </button>
        ))}
      </div>
    </div>

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Services menu: open on real pointer entry (not when a page loads under
      // the pointer), close after a link is clicked.
      const megaLi = document.querySelector<HTMLElement>('.has-mega');
      if (megaLi) {
        let t = 0;
        megaLi.addEventListener('pointerenter', () => { clearTimeout(t); t = window.setTimeout(() => megaLi.classList.add('open'), 80); });
        megaLi.addEventListener('pointerleave', () => { clearTimeout(t); t = window.setTimeout(() => megaLi.classList.remove('open'), 120); });
        megaLi.querySelectorAll<HTMLElement>('.b-tile').forEach((tile) => tile.addEventListener('pointermove', (e) => {
          const r = tile.getBoundingClientRect();
          tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
          tile.style.setProperty('--my', `${e.clientY - r.top}px`);
        }));
        megaLi.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => {
          megaLi.classList.remove('open');
          (document.activeElement as HTMLElement | null)?.blur();
        }));
      }

      // Theme switcher
      const pick = document.querySelector<HTMLElement>('[data-theme-pick]')!;
      const menu = pick.querySelector<HTMLElement>('.theme-menu')!;
      const toggle = pick.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const current = () => document.documentElement.dataset.theme ?? 'green';
      const mark = () => menu.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.themeId === current())));
      mark();
      toggle.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        toggle.setAttribute('aria-expanded', String(!menu.hidden));
      });
      menu.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-id]');
        if (!b) return;
        const t = b.dataset.themeId!;
        if (t === 'green') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch {}
        const u = new URL(location.href);
        u.searchParams.set('theme', t);
        history.replaceState(null, '', u);
        mark();
      });
    </script>
  </body>
</html>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .35;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .o1 { width: 40vw; height: 40vw; right: -8vw; top: -12vw; background: var(--glow); }
  @keyframes drift {
    to { transform: translate3d(6vw, 4vh, 0) scale(1.12); }
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(15, 27, 45, .09) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 70%);
  }

  /* Default green theme: engineering grid like the hero mockup */
  :global(:root:not([data-theme])) .grid {
    background-image:
      linear-gradient(rgba(47, 208, 127, .06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 208, 127, .06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(#000, transparent 85%);
  }
  :global(:root:not([data-theme])) .nav-inner { background: rgba(13, 28, 23, .85); border-color: rgba(255,255,255,.08); backdrop-filter: blur(12px); }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    transition: padding .3s;
  }
  .nav.scrolled { padding: 8px 0; }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 10px 10px 20px;
    border-radius: 999px;
    background: var(--surface);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -.02em;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--grad);
    color: var(--on-accent);
  }
  .logo-mark svg { width: 22px; height: 22px; }
  .logo-img img { display: block; width: 40px; height: 40px; border-radius: 10px; background: #fff; object-fit: contain; }
  .contact { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 6px; font-size: 14px; color: rgba(255,255,255,.75); }
  .contact a:hover { color: #fff; text-decoration: underline; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink-2);
    transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--violet); background: var(--accent-soft); font-weight: 600; }
  .nav-cta { padding: 11px 20px; }

  @media (max-width: 720px) {
    .nav-inner { flex-wrap: wrap; border-radius: 22px; gap: 8px; padding: 10px 12px; }
    nav { order: 3; width: 100%; margin: 0; }
    nav ul { justify-content: space-between; }
    nav a { padding: 8px 10px; font-size: 14px; }
    .nav-cta { margin-left: auto; padding: 9px 14px; font-size: 14px; }
  }

  .footer { margin-top: 40px; background: var(--navy); color: #fff; border-radius: 32px 32px 0 0; }
  .footer .logo { color: #fff; }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: 48px 0 32px;
  }
  .muted { color: rgba(255,255,255,.6); margin-top: 10px; max-width: 42ch; }
  .footer-nav { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; color: rgba(255,255,255,.75); }
  .footer-nav a:hover { color: var(--violet); }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 0 32px;
    font-size: 13px;
    color: rgba(255,255,255,.5);
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .theme-pick { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 16px; border-radius: 999px; border: 0;
    background: var(--ink); color: var(--bg); font-weight: 600; font-size: 14px;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, .45);
  }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-menu {
    order: -1; display: grid; gap: 4px; padding: 8px; min-width: 170px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow);
  }
  .theme-menu button {
    display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 0; border-radius: 10px;
    background: none; font-size: 14px; font-weight: 500; color: var(--ink-2); text-align: left;
  }
  .theme-menu button:hover { background: var(--tint-2); color: var(--ink); }
  .theme-menu button[aria-pressed='true'] { background: var(--accent-soft); color: var(--ink); font-weight: 700; }
  .sw { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  /* Services mega menu — bento grid */
  .nav-inner { position: relative; }
  .has-mega > a { display: inline-flex; align-items: center; gap: 4px; }
  .caret { width: 14px; height: 14px; transition: transform .25s; }
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 12px);
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    grid-template-rows: 168px 168px auto;
    gap: 10px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: 0 40px 80px -30px rgba(15, 27, 45, .4), var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(.985);
    transform-origin: top center;
    transition: opacity .22s, transform .22s cubic-bezier(.2,.8,.2,1), visibility 0s .22s;
    z-index: 70;
  }
  /* invisible bridge so the pointer can travel from the link into the panel */
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
  .has-mega.open .mega,
  .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; transition: opacity .22s, transform .3s cubic-bezier(.2,.8,.2,1); }
  .has-mega.open .caret, .has-mega:focus-within .caret { transform: rotate(180deg); }
  .mega ul { list-style: none; margin: 0; padding: 0; }

  nav .b-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border-radius: 20px;
    background: hsl(var(--h) 70% var(--chip-l));
    color: var(--ink);
    overflow: hidden;
    transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s;
  }
  nav .b-tile:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -18px hsl(var(--h) 60% 35% / .6); }
  .b-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--surface); color: hsl(var(--h) 65% var(--chip-ink-l)); margin-bottom: auto; }
  .b-ico svg { width: 21px; height: 21px; }
  .b-tile strong { font-size: 15px; font-weight: 800; letter-spacing: -.01em; margin-top: 14px; }
  .b-tile small { font-size: 12px; line-height: 1.35; color: var(--ink-2); }
  .b-arrow { position: absolute; right: 14px; top: 14px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); color: var(--ink); opacity: 0; transform: translate(-4px, 4px); transition: opacity .2s, transform .2s; }
  .b-arrow svg { width: 14px; height: 14px; }
  nav .b-tile:hover .b-arrow { opacity: 1; transform: none; }

  nav .b-hero { grid-row: span 2; background: var(--grad); color: var(--on-accent); padding: 24px; }
  .b-hero .b-ico { width: 52px; height: 52px; border-radius: 16px; background: rgba(255,255,255,.18); color: inherit; }
  .b-hero .b-ico svg { width: 28px; height: 28px; }
  .b-hero strong { font-size: 24px; line-height: 1.1; }
  .b-hero small { color: inherit; opacity: .85; font-size: 13px; }
  .b-hero .b-count { margin-top: 10px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .b-hero::after { content: ''; position: absolute; right: -50px; top: -50px; width: 180px; height: 180px; border-radius: 50%; background: rgba(255,255,255,.12); }

  nav .b-cta { background: var(--ink); color: var(--bg); }
  .b-cta small { color: inherit; opacity: .7; }
  .b-cta .b-ico { background: rgba(255,255,255,.12); color: inherit; }
  .b-cta em { font-style: normal; color: var(--lime); white-space: nowrap; }

  .b-brands { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 12px 14px 6px; }
  .b-brands > span { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-right: 6px; }
  nav .b-brands a { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); font-size: 13px; font-weight: 600; color: var(--ink-2); transition: border-color .15s, color .15s, background .15s; }
  nav .b-brands a:hover { border-color: var(--violet); color: var(--violet); background: var(--accent-soft); }
  /* --- motion --- */
  .mega > * { opacity: 0; transform: translateY(14px); }
  .has-mega.open .mega > *, .has-mega:focus-within .mega > * {
    animation: bIn .5s cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: calc(var(--i, 0) * 45ms + 40ms);
  }
  @keyframes bIn { to { opacity: 1; transform: none; } }
  /* cursor spotlight (--mx/--my set by script) */
  nav .b-tile::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.55), transparent 60%);
    opacity: 0; transition: opacity .25s;
  }
  nav .b-tile:hover::before { opacity: 1; }
  nav .b-cta::before, nav .b-hero::before { background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.18), transparent 60%); }
  nav .b-tile:hover .b-ico svg { animation: bBounce .6s cubic-bezier(.3,1.6,.5,1); }
  @keyframes bBounce { 0% { transform: scale(1) rotate(0); } 40% { transform: scale(1.22) rotate(-8deg); } 100% { transform: scale(1) rotate(0); } }
  /* hero tile: drifting gradient, sweeping shine, floating icon */
  nav .b-hero { background: linear-gradient(120deg, var(--violet), var(--blue), var(--violet)); background-size: 220% 220%; animation: bDrift 7s ease-in-out infinite; }
  .has-mega.open .mega > .b-hero { animation: bIn .5s cubic-bezier(.2,.8,.2,1) forwards, bDrift 7s ease-in-out infinite; }
  @keyframes bDrift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.tagline} — screens, batteries and more for every major phone brand.` } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="orb o2"></span>
      <span class="orb o3"></span>
      <span class="grid"></span>
    </div>

    <header class="nav">
      <div class="wrap nav-inner glass">
        <a href="/" class="logo">
          <span class="logo-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32"><rect x="9" y="4" width="14" height="24" rx="4" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M13 16l2.4 2.4L20 13.6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          {site.name}
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/services#book" class="btn btn-primary nav-cta">Book a repair</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <a href="/" class="logo">{site.name}</a>
          <p class="muted">{site.tagline}. Doorstep repair and pickup across {site.city}.</p>
        </div>
        <ul class="footer-nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>All estimates shown as ₹0 — pricing to be announced.</span>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: .5;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .o1 { width: 46vw; height: 46vw; left: -12vw; top: -14vw; background: #5b21b6; }
  .o2 { width: 38vw; height: 38vw; right: -10vw; top: 18vh; background: #0e7490; animation-duration: 28s; }
  .o3 { width: 30vw; height: 30vw; left: 30vw; bottom: -18vw; background: #9d174d; opacity: .32; animation-duration: 34s; }
  @keyframes drift {
    to { transform: translate3d(6vw, 4vh, 0) scale(1.12); }
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 70%);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    transition: padding .3s;
  }
  .nav.scrolled { padding: 8px 0; }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 10px 10px 20px;
    border-radius: 999px;
    background: rgba(12, 12, 24, .55);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--grad);
    color: #07070d;
  }
  .logo-mark svg { width: 22px; height: 22px; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink-2);
    transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); background: rgba(255,255,255,.08); }
  .nav-cta { padding: 11px 20px; }

  @media (max-width: 720px) {
    .nav-inner { flex-wrap: wrap; border-radius: 22px; gap: 8px; padding: 10px 12px; }
    nav { order: 3; width: 100%; margin: 0; }
    nav ul { justify-content: space-between; }
    nav a { padding: 8px 10px; font-size: 14px; }
    .nav-cta { margin-left: auto; padding: 9px 14px; font-size: 14px; }
  }

  .footer { border-top: 1px solid var(--line); margin-top: 40px; }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: 48px 0 32px;
  }
  .muted { color: var(--ink-3); margin-top: 10px; max-width: 42ch; }
  .footer-nav { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; color: var(--ink-2); }
  .footer-nav a:hover { color: var(--ink); }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 0 32px;
    font-size: 13px;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
  }
</style>

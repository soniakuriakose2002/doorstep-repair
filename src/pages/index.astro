---
import Base from '../layouts/Base.astro';
import MediaFrame from '../components/MediaFrame.astro';
import HeroSearch from '../components/HeroSearch.astro';
import DeviceArt from '../components/DeviceArt.astro';
import { artFor, note } from '../data/menu';

// Real repair photos supplied by the client (public/media/repairs). Others fall back to the illustration.
const photo: Record<string, string> = {
  'mobile:Screen replacement': 'screen', 'mobile:Battery replacement': 'battery', 'mobile:Charging port': 'charging',
  'mobile:Back glass': 'backglass', 'mobile:Speaker / microphone': 'speaker', 'mobile:Water damage': 'water', 'mobile:Software & data': 'software', 'mobile:Camera': 'camera',
  'tablet:Screen / glass': 'tab-screen', 'tablet:Display / touch not working': 'tab-display', 'tablet:Battery replacement': 'tab-battery',
  'tablet:Charging port': 'tab-charging', 'tablet:Buttons': 'tab-buttons',
};
const heroCopy: Record<string, [string, string]> = {
  mobile: ['Keep Your Phone Working Like New', 'Screen, battery, charging, camera and more – quick and reliable service.'],
  tablet: ['Your Tablet, Good as New', 'Cracked glass, batteries and charging faults fixed fast.'],
  laptop: ['Laptop Trouble? Sorted.', 'Screens, keyboards, hinges, batteries and board-level repair.'],
  desktop: ['Desktops Back to Full Speed', 'Power, boards, upgrades and clean OS installs.'],
  printer: ['Printers That Just Work', 'Jams, print quality, toner and setup – serviced on-site.'],
  cctv: ['Security You Can See', 'Survey, install and remote viewing for homes and shops.'],
  network: ['Wi-Fi in Every Room', 'Mesh, routers, cabling and office networks.'],
  data: ['Get Your Files Back', 'Deleted files, dead drives and formatted disks recovered.'],
  itsupport: ['IT Help When You Need It', 'Software, email, tune-ups and maintenance plans.'],
};
const issueIcon = (s: string) => {
  const t = s.toLowerCase();
  const I: [RegExp, string][] = [
    [/back glass/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><circle cx="10" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/>'],
    [/screen|glass|display/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 6l6 6M9 11l3 3"/>'],
    [/battery/, '<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2h4M12 9l-2 4h4l-2 4"/>'],
    [/charg|power/, '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>'],
    [/camera|cctv|viewing|dvr/, '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'],
    [/water|fire/, '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>'],
    [/speaker|micro/, '<path d="M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6"/>'],
    [/wi-?fi|router|mesh|lan|network|switch/, '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>'],
    [/drive|ssd|ram|disk|deleted|format|recover/, '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 14h18"/>'],
    [/paper|toner|cartridge|roller|print/, '<path d="M7 9V3.5h10V9"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/>'],
  ];
  return I.find(([re]) => re.test(t))?.[1] ?? '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>';
};
import { reviews, sample } from '../data/reviews';
import Testimonials from '../components/Testimonials.astro';
import { serviceModes, price, site } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';
import { coverage } from '../data/coverage';
import { homeServices, milestones, awards, awardsSample, wa } from '../data/home';
import { statSync } from 'node:fs';

const stamp = (f: string) => { try { return `/media/${f}?v=${Math.floor(statSync(`public/media/${f}`).mtimeMs / 1000)}`; } catch { return `/media/${f}`; } };
const heroVideo = stamp('kling.mp4');
const heroPoster = stamp('kling.jpg');
const coverageCount = new Set(Object.values(coverage).flatMap((m) => m.zones.flatMap((z) => z.areas))).size;

const allBrands = [...new Set(categories.flatMap((c) => c.brands.map((b) => b.name)))];

const formats = [
  { id: 'image', label: 'Image' },
  { id: 'post', label: 'Post' },
  { id: 'video', label: 'Video' },
] as const;
const angles = [
  { id: 'flat', label: '0° Flat' },
  { id: 'tilt', label: '15° Tilt' },
  { id: 'iso', label: '3D Isometric' },
] as const;
---

<Base>
  <!-- ============ HERO: background video + Book Your Slot ============ -->
  <section class="vhero">
    <video class="vhero-video" src={heroVideo} poster={heroPoster} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    <div class="vhero-shade" aria-hidden="true"></div>
    <div class="wrap vhero-in">
      <span class="eyebrow" data-reveal>Doorstep electronics repair · {site.country}</span>
      <h1 class="h-xl" data-reveal style="--d:.08s">Technology, <span class="grad-text">repaired right.</span></h1>
      <p class="devices-line" data-reveal style="--d:.12s">Phone &bull; Laptop &bull; Computer &bull; Printer &bull; CCTV &bull; Networking</p>
      <div class="vhero-cta" data-reveal style="--d:.18s">
        <a href="#book-services" class="btn btn-primary btn-xl" data-scroll>
          Book Your Slot
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
        <a href={wa('Hi Danat, I want to book a repair.')} target="_blank" rel="noopener" class="btn btn-wa"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp us</a>
      </div>
      <div class="vhero-search" data-reveal style="--d:.24s"><HeroSearch /></div>
      <ul class="hero-facts" data-reveal style="--d:.3s">
        <li><b>{homeServices.length}+</b> services</li>
        <li><b>{site.branches.length}</b> branches</li>
        <li><b>{site.since}</b> since</li>
      </ul>
    </div>
    <a href="#book-services" class="vhero-down" data-scroll aria-label="Scroll to services"><span></span></a>
  </section>

  <!-- ============ BOOK A SERVICE (30–40 services, WhatsApp) ============ -->
  <section class="section" id="book-services">
    <div class="wrap">
      <div class="bk" data-bk>
        <aside class="bk-side">
          <h3>Our Services</h3>
          <p>Choose a category to find the service you need.</p>
          <div class="bk-cats" role="tablist" aria-label="Service category">
            {categories.map((c, k) => (
              <button type="button" role="tab" class="bk-cat" data-bk-tab={c.id} aria-selected={k === 0 ? 'true' : 'false'} style={`--h:${c.hue}`}>
                <span class="bk-ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                <span class="bk-cn"><b>{c.name}</b><small>{c.issues.length} services</small></span>
                <span class="bk-cc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span>
              </button>
            ))}
          </div>
        </aside>

        <div class="bk-main">
          {categories.map((c, k) => (
            <div class="bk-panel" data-bk-panel={c.id} hidden={k !== 0} style={`--h:${c.hue}`}>
              <div class="bk-hero">
                <div class="bk-hero-copy">
                  <span class="bk-eye">{c.name} services</span>
                  <h3>{heroCopy[c.id][0]}</h3>
                  <p>{heroCopy[c.id][1]}</p>
                  <ul class="bk-feats">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><span><b>Fast Service</b><small>In most areas</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span><b>Genuine Parts</b><small>Trusted repairs</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg><span><b>Affordable Price</b><small>Transparent pricing</small></span></li>
                  </ul>
                </div>
                <div class="bk-hero-art">
                  <span class="bk-orb"></span>
                  <span class="bk-dev"><DeviceArt kind={artFor[c.id]} /></span>
                  <span class="bk-from"><small>From</small><b>{price()}</b><i></i></span>
                </div>
              </div>
              <div class="bk-sel-head">
                <h4><span>1.</span> Select the repair service</h4>
                <small>Showing <b>{c.issues.length}</b> services</small>
              </div>
              <div class="bk-grid" role="radiogroup" aria-label={`Services for ${c.name}`}>
                {c.issues.map((iss, i) => (
                  <button type="button" role="radio" class="bk-card" aria-checked={i === 0 ? 'true' : 'false'} data-name={iss} data-wa={wa(`Hi Danat, I want to book a ${iss} service for my ${c.name.replace(/ &.*$/, '').replace(/s$/, '').toLowerCase()}.`)}>
                    <span class:list={['bk-pic', { photo: photo[`${c.id}:${iss}`] }]}>{photo[`${c.id}:${iss}`] ? <img src={`/media/repairs/${photo[`${c.id}:${iss}`]}.jpg`} alt={iss} loading="lazy" width="360" height="200" /> : <span class="bk-pic-art"><DeviceArt kind={artFor[c.id]} /></span>}<span class="bk-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${issueIcon(iss)}</svg>`} /></span>
                    <b>{iss}</b>
                    <small>{note(iss)}</small>
                    <span class="bk-foot"><span>From <em>{price()}</em></span><span class="bk-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
                  </button>
                ))}
              </div>
            </div>
          ))}
          <div class="bk-bar">
            <div class="bk-bar-t"><h4><span>2.</span> Book on WhatsApp</h4><small>Click the button and send your request.</small></div>
            <a class="bk-cta" data-bk-cta target="_blank" rel="noopener" href={wa(`Hi Danat, I want to book a ${categories[0].issues[0]} service for my mobile phone.`)}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> <span>Book <b data-bk-name>{categories[0].issues[0]}</b> on WhatsApp</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <p class="bk-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Your message is pre-filled.<br />Just press send.</p>
          </div>
        </div>
      </div>    </div>
  </section>

  <!-- ============ SERVICE MODES (short) ============ -->
  <section class="section tight-sec">
    <div class="wrap">
      <div class="modes">
        {serviceModes.map((m, i) => (
          <a href={`/services?mode=${m.id}#modes`} class="mode glass" data-reveal style={`--d:${.1 + i * .1}s`}>
            <span class="mode-icon" aria-hidden="true">
              {m.id === 'doorstep' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>
              )}
            </span>
            <h3 class="h-md">{m.title}</h3>
            <ol class="mode-steps">
              {m.steps.map((s, n) => <li><span>{n + 1}</span>{s}</li>)}
            </ol>
            <span class="mode-foot">Check your area <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BRAND MARQUEE ============ -->
  <section class="brands-band">
    <div class="marquee" aria-label="Brands we repair">
      <div class="marquee-track">
        {[...allBrands, ...allBrands].map((b) => <span class="marquee-item">{b}</span>)}
      </div>
    </div>
  </section>
  <!-- ============ WHAT OUR CLIENTS SAY ============ -->
  <section class="section" id="reviews">
    <Testimonials />
    <div class="wrap rv4">
      <div class="tst" data-tst>
        <div class="tst-intro">
          <span class="tst-eyebrow">Testimonials</span>
          <h2>What our clients say</h2>
          <p>Doorstep visits, pickups and installs across {site.country} — in our customers’ words.</p>
          {sample && <span class="tst-sample">Sample reviews — real ones coming soon</span>}
          <div class="tst-ctrl">
            <button type="button" data-tst-prev aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
            <button type="button" data-tst-next aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
            <span class="tst-count"><b data-tst-n>01</b> / {String(reviews.length).padStart(2, '0')}</span>
          </div>
          <div class="tst-bar"><i data-tst-bar></i></div>
        </div>

        <div class="tst-stage">
          <div class="tst-deck" aria-live="polite">
            {reviews.map((r, i) => (
              <figure class="tq" data-tq={i}>
                <svg class="tq-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 10C11 13 6 20 6 29v9h14V24h-8c0-6 3-9 9-11zM42 10c-9 3-14 10-14 19v9h14V24h-8c0-6 3-9 9-11z" /></svg>
                <span class="tq-tag">{r.service}</span>
                <blockquote>{r.text}</blockquote>
                <figcaption>
                  <span class="tq-av">{r.area[0]}</span>
                  <span class="tq-who"><b>{r.name}</b><small>{r.area}</small></span>
                  <span class="tq-stars" aria-label={`${r.rating} out of 5`}>
                    {[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 24 24" class:list={[{ off: n > r.rating }]}><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>)}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class="tst-tabs" role="tablist" aria-label="Choose a review">
            {reviews.map((r, i) => <button type="button" role="tab" data-tst-go={i}>{r.service}</button>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============ ROADMAP ============ -->
  <section class="section" id="roadmap">
    <div class="wrap">
      <div class="center-head">
        <span class="eyebrow" data-reveal>Our journey</span>
        <h2 class="h-lg" data-reveal style="--d:.06s">From one shop to doorstep repair</h2>
      </div>
      <ol class="road">
        {milestones.map((m, i) => (
          <li class:list={['rm', { tbc: !m.verified || m.year === 'Year TBC' }]} data-reveal style={`--d:${i * .1}s`}>
            <span class="rm-dot" aria-hidden="true"></span>
            <span class="rm-year">{m.year}</span>
            <b>{m.title}</b>
            <small>{m.text}</small>
          </li>
        ))}
      </ol>
      <p class="rm-note">Years marked “TBC” are waiting for confirmation from Danat.</p>
    </div>
  </section>

  <!-- ============ AWARDS + NETWORK ============ -->
  <section class="section tight-sec">
    <div class="wrap an">
      <div class="aw" data-reveal>
        <div class="an-h"><span class="eyebrow">Recognition</span><h2 class="h-md">Awards</h2></div>
        {awardsSample && <span class="an-sample">Sample — awards to be confirmed</span>}
        <ul>
          {awards.map((a) => (
            <li>
              <span class="aw-medal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/></svg></span>
              <span><b>{a.title}</b><small>{a.by} · {a.year}</small></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="nw" data-reveal style="--d:.1s">
        <div class="an-h"><span class="eyebrow">Support network</span><h2 class="h-md">Across {site.country}, for brands worldwide</h2></div>
        <div class="nw-map" aria-hidden="true">
          <span class="pin" style="--x:74%;--y:30%"><i></i>Ruwi</span>
          <span class="pin" style="--x:52%;--y:18%"><i></i>Sohar</span>
          <span class="pin" style="--x:24%;--y:80%"><i></i>Salalah</span>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M74 30 Q60 20 52 18 M74 30 Q48 58 24 80" /></svg>
        </div>
        <ul class="nw-stats">
          <li><b>{site.branches.length}</b><small>branches</small></li>
          <li><b>{coverageCount}</b><small>areas covered</small></li>
          <li><b>{totals.brands}</b><small>global brands</small></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->  <section class="section">
    <div class="wrap">
      <div class="cta glass" data-reveal>
        <h2 class="h-lg">Something broken? <span class="grad-text">Stay home.</span></h2>
        <div class="vhero-cta center"><a href="#book-services" class="btn btn-primary" data-scroll>Book Your Slot</a><a href={wa('Hi Danat, I want to book a repair.')} target="_blank" rel="noopener" class="btn btn-wa"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp</a></div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Smooth scroll for Book Your Slot (offset for the sticky nav via scroll-margin)
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll]').forEach((a) => a.addEventListener('click', (e) => {
    const t = document.querySelector(a.getAttribute('href')!);
    if (!t) return;
    e.preventDefault();
    t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));


  // Booking: category sidebar → service cards → one WhatsApp button
  const bk = document.querySelector<HTMLElement>('[data-bk]');
  if (bk) {
    const cta = bk.querySelector<HTMLAnchorElement>('[data-bk-cta]')!;
    const setCta = (card: HTMLElement) => { cta.href = card.dataset.wa!; bk.querySelector('[data-bk-name]')!.textContent = card.dataset.name!; };
    bk.querySelectorAll<HTMLElement>('.bk-card').forEach((card) => card.addEventListener('click', () => {
      card.parentElement!.querySelectorAll('.bk-card').forEach((o) => o.setAttribute('aria-checked', String(o === card)));
      setCta(card);
    }));
    bk.querySelectorAll<HTMLElement>('[data-bk-tab]').forEach((t) => t.addEventListener('click', () => {
      bk.querySelectorAll('[data-bk-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      bk.querySelectorAll<HTMLElement>('[data-bk-panel]').forEach((p) => (p.hidden = p.dataset.bkPanel !== t.dataset.bkTab));
      const panel = bk.querySelector<HTMLElement>(`[data-bk-panel="${t.dataset.bkTab}"]`)!;
      setCta(panel.querySelector<HTMLElement>('.bk-card[aria-checked="true"]')!);
      if (bk.getBoundingClientRect().top < 0) bk.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
  }
  const lab = document.getElementById('lab') ?? document.createElement('div');
  const names: Record<string, string> = { image: 'Image', post: 'Post', video: 'Video', flat: '0° Flat', tilt: '15° Tilt', iso: '3D Isometric' };
  const FORMATS = ['image', 'post', 'video'];
  const ANGLES = ['flat', 'tilt', 'iso'];

  // Videos only load and play while they are on screen and displayed.
  const onScreen = new Set<HTMLVideoElement>();
  const syncVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((v) => {
      const shown = v.offsetParent !== null && onScreen.has(v);
      if (shown) {
        if (!v.src) v.src = v.dataset.src!;
        v.play().catch(() => {});
      } else if (!v.paused) v.pause();
    });
  };
  const vio = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      e.isIntersecting ? onScreen.add(v) : onScreen.delete(v);
    });
    syncVideos();
  });
  document.querySelectorAll('video[data-src]').forEach((v) => vio.observe(v));

  const press = (sel: string, attr: string, val: string) =>
    document.querySelectorAll<HTMLButtonElement>(`[${sel}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(sel) === val)));

  const apply = (format: string, angle: string, writeUrl = true) => {
    if (!FORMATS.includes(format)) format = 'video';
    if (!ANGLES.includes(angle)) angle = 'tilt';
    lab.dataset.format = format;
    lab.dataset.angle = angle;
    press('data-set-format', 'aria-pressed', format);
    press('data-set-angle', 'aria-pressed', angle);
    const now = document.querySelector('[data-now]'); if (now) now.textContent = `${names[format]} · ${names[angle]}`;

    if (writeUrl) {
      const u = new URL(location.href);
      u.searchParams.set('format', format);
      u.searchParams.set('angle', angle);
      history.replaceState(null, '', u);
    }
    requestAnimationFrame(syncVideos);
  };

  const q = new URLSearchParams(location.search);
  if (document.getElementById('lab')) apply(q.get('format') ?? 'video', q.get('angle') ?? 'tilt', q.has('format') || q.has('angle'));

  document.querySelectorAll<HTMLButtonElement>('[data-set-format]').forEach((b) =>
    b.addEventListener('click', () => apply(b.dataset.setFormat!, lab.dataset.angle!)));
  document.querySelectorAll<HTMLButtonElement>('[data-set-angle]').forEach((b) =>
    b.addEventListener('click', () => apply(lab.dataset.format!, b.dataset.setAngle!)));

  // Testimonials deck: auto-advance, pause on hover, arrows, tabs
  const tst = document.querySelector<HTMLElement>('[data-tst]');
  if (tst) {
    const cards = [...tst.querySelectorAll<HTMLElement>('[data-tq]')];
    const tabs = [...tst.querySelectorAll<HTMLButtonElement>('[data-tst-go]')];
    const bar = tst.querySelector<HTMLElement>('[data-tst-bar]')!;
    const MS = 6000;
    let cur = 0, timer = 0, left = MS, started = 0, paused = false;
    const n = cards.length;
    const render = (prev?: number) => {
      cards.forEach((c, i) => {
        const pos = (i - cur + n) % n;
        c.dataset.pos = i === prev ? 'out' : pos < 3 ? String(pos) : 'hidden';
        c.setAttribute('aria-hidden', String(pos !== 0));
      });
      if (prev !== undefined) setTimeout(() => { const pos = (prev - cur + n) % n; cards[prev].dataset.pos = pos < 3 ? String(pos) : 'hidden'; }, 650);
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === cur)));
      tst.querySelector('[data-tst-n]')!.textContent = String(cur + 1).padStart(2, '0');
      bar.classList.remove('run'); void bar.offsetWidth; bar.classList.add('run');
    };
    const go = (i: number) => { const prev = cur; cur = (i + n) % n; render(prev !== cur && i === prev + 1 ? prev : undefined); schedule(MS); };
    const schedule = (ms: number) => { clearTimeout(timer); left = ms; started = Date.now(); if (!paused) timer = window.setTimeout(() => go(cur + 1), ms); };
    tst.style.setProperty('--tst-ms', `${MS}ms`);
    tst.addEventListener('pointerenter', () => { paused = true; clearTimeout(timer); left -= Date.now() - started; });
    tst.addEventListener('pointerleave', () => { paused = false; schedule(Math.max(left, 400)); });
    tst.querySelector('[data-tst-next]')!.addEventListener('click', () => go(cur + 1));
    tst.querySelector('[data-tst-prev]')!.addEventListener('click', () => go(cur - 1));
    tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    render();
    schedule(MS);
  }
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', async () => {
    const u = new URL(location.href);
    u.searchParams.set('format', lab.dataset.format!);
    u.searchParams.set('angle', lab.dataset.angle!);
    u.hash = 'lab';
    try {
      await navigator.clipboard.writeText(u.href);
      copy!.textContent = 'Link copied';
    } catch {
      copy!.textContent = u.search;
    }
    setTimeout(() => (copy!.textContent = 'Copy link to this look'), 1800);
  });
</script>


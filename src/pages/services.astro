---
import Base from '../layouts/Base.astro';
import { serviceModes, issues, price, site } from '../data/site';
import { brands, modelCount } from '../data/brands';
import { coverage } from '../data/coverage';

const payload = JSON.stringify({
  brands: brands.map((b) => ({ id: b.id, name: b.name, models: b.models })),
  coverage,
});
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base title="Services" description="Doorstep repair and pickup & service for every major phone brand. Coverage areas, all models, ₹0 estimates.">
  <script type="application/json" id="svc-data" set:html={payload} />

  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Services</span>
      <h1 class="h-xl" data-reveal style="--d:.06s">Doorstep repair, <span class="grad-text">or we pick it up.</span></h1>
      <p class="lead" data-reveal style="--d:.12s">
        Choose how you want the repair done, check that we reach your area, then pick your phone.
        {brands.length} brands and {modelCount}+ models, every estimate {price()}.
      </p>
    </div>
  </section>

  <!-- ============ SERVICE MODE + COVERAGE ============ -->
  <section class="section tight" id="modes">
    <div class="wrap">
      <div class="mode-pick" role="radiogroup" aria-label="Service type">
        {serviceModes.map((m, i) => (
          <button type="button" role="radio" class="mode-card glass" data-mode={m.id} aria-checked={i === 0 ? 'true' : 'false'} data-reveal style={`--d:${i * .08}s`}>
            <span class="mode-radio" aria-hidden="true"></span>
            <span class="mode-icon" aria-hidden="true">
              {m.id === 'doorstep' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>
              )}
            </span>
            <span class="mode-title">{m.title}</span>
            <span class="mode-short">{m.short}</span>
            <span class="mode-body">{m.body}</span>
            <span class="mode-fee">Visit / pickup fee <span class="price-tag">{price()}</span></span>
          </button>
        ))}
      </div>

      <div class="coverage glass" data-reveal>
        <div class="cov-head">
          <div>
            <h2 class="h-md">Service coverage · <span data-cov-title>Doorstep Service</span></h2>
            <p class="cov-eta" data-cov-eta>{coverage.doorstep.eta}</p>
          </div>
          <label class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" placeholder="Check your area" data-area-search autocomplete="off" aria-label="Search your area" />
          </label>
        </div>
        <p class="cov-result" data-cov-result aria-live="polite"></p>
        {serviceModes.map((m, i) => (
          <div class="zones" data-zones={m.id} hidden={i !== 0}>
            {coverage[m.id].zones.map((z) => (
              <div class="zone">
                <h3>{z.name} <small>{z.areas.length} areas</small></h3>
                <div class="areas">
                  {z.areas.map((a) => <button type="button" class="area" data-area={a}>{a}</button>)}
                </div>
              </div>
            ))}
          </div>
        ))}
        <p class="cov-note">Area not listed? Book anyway — we confirm coverage before the visit. Coverage shown is for {site.city}.</p>
      </div>
    </div>
  </section>

  <!-- ============ CATALOG ============ -->
  <section class="section tight" id="catalog">
    <div class="wrap">
      <div class="cat-head">
        <div>
          <span class="eyebrow" data-reveal>Mobile repair catalog</span>
          <h2 class="h-lg" data-reveal style="--d:.06s">Every brand, every model</h2>
        </div>
        <label class="search" data-reveal style="--d:.12s">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input type="search" placeholder="Search a model, e.g. S24" data-model-search autocomplete="off" aria-label="Search models" />
        </label>
      </div>

      <div class="brand-chips" role="group" aria-label="Filter by brand">
        <button type="button" class="bchip" data-brand-filter="all" aria-pressed="true">All brands</button>
        {brands.map((b) => (
          <button type="button" class="bchip" data-brand-filter={b.id} aria-pressed="false" style={`--h:${b.hue}`}>
            {b.name} <small>{b.models.length}</small>
          </button>
        ))}
      </div>

      <div class="brands">
        {brands.map((b) => (
          <div class="brand" data-brand={b.id} style={`--h:${b.hue}`}>
            <div class="brand-head">
              <span class="brand-dot" aria-hidden="true"></span>
              <h3>{b.name}</h3>
              <span class="brand-count" data-brand-count>{b.models.length} models</span>
            </div>
            <ul class="models">
              {b.models.map((m) => (
                <li>
                  <button type="button" class="model" data-model={m} data-model-brand={b.id} data-q={`${b.name} ${m}`.toLowerCase()}>
                    <span class="model-name">{m}</span>
                    <span class="model-price">from <span class="price-tag">{price()}</span></span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="empty" data-empty hidden>No model matches that search. Try just the number, e.g. “15”.</p>
      </div>
    </div>
  </section>

  <!-- ============ BOOKING ============ -->
  <section class="section tight" id="book">
    <div class="wrap book">
      <form class="book-form glass" data-book novalidate>
        <span class="eyebrow">Book a repair</span>
        <h2 class="h-lg">Four quick steps</h2>

        <fieldset>
          <legend><span>1</span>Service type</legend>
          <div class="seg" role="radiogroup">
            {serviceModes.map((m, i) => (
              <label class="seg-radio"><input type="radio" name="mode" value={m.id} checked={i === 0} /><span>{m.title}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend><span>2</span>Your area</legend>
          <select name="area" required data-f-area></select>
        </fieldset>

        <fieldset>
          <legend><span>3</span>Your phone</legend>
          <div class="two">
            <select name="brand" required data-f-brand>
              <option value="">Brand</option>
              {brands.map((b) => <option value={b.id}>{b.name}</option>)}
            </select>
            <select name="model" required data-f-model disabled><option value="">Model</option></select>
          </div>
        </fieldset>

        <fieldset>
          <legend><span>4</span>What needs fixing?</legend>
          <div class="issues">
            {issues.map((iss) => (
              <label class="issue-chk"><input type="checkbox" name="issue" value={iss} /><span>{iss}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="two">
          <input name="name" placeholder="Your name" required autocomplete="name" />
          <input name="phone" placeholder="Phone number" required inputmode="tel" autocomplete="tel" />
        </div>

        <p class="form-msg" data-form-msg aria-live="polite"></p>
        <button type="submit" class="btn btn-primary">Request {price()} estimate</button>
      </form>

      <aside class="summary glass" aria-label="Booking summary">
        <h3>Your booking</h3>
        <dl>
          <div><dt>Service</dt><dd data-s-mode>Doorstep Service</dd></div>
          <div><dt>Area</dt><dd data-s-area>—</dd></div>
          <div><dt>Phone</dt><dd data-s-phone>—</dd></div>
          <div><dt>Repairs</dt><dd data-s-issues>—</dd></div>
        </dl>
        <ul class="bill">
          <li><span>Repair estimate</span><span class="price-tag">{price()}</span></li>
          <li><span>Visit / pickup</span><span class="price-tag">{price()}</span></li>
          <li class="total"><span>Total</span><span class="price-tag">{price()}</span></li>
        </ul>
        <p class="bill-note">Prices are not live yet — every amount is shown as {price()}.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  type Data = {
    brands: { id: string; name: string; models: string[] }[];
    coverage: Record<string, { eta: string; zones: { name: string; areas: string[] }[] }>;
  };
  const data: Data = JSON.parse(document.getElementById('svc-data')!.textContent!);
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const titles: Record<string, string> = { doorstep: 'Doorstep Service', pickup: 'Pickup & Service' };
  const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();

  const form = $<HTMLFormElement>('[data-book]');
  const fArea = $<HTMLSelectElement>('[data-f-area]');
  const fBrand = $<HTMLSelectElement>('[data-f-brand]');
  const fModel = $<HTMLSelectElement>('[data-f-model]');
  const areaSearch = $<HTMLInputElement>('[data-area-search]');

  let mode = 'doorstep';

  // ---------- service mode + coverage ----------
  const fillAreas = () => {
    const keep = fArea.value;
    fArea.innerHTML = '<option value="">Select your area</option>' + data.coverage[mode].zones
      .map((z) => `<optgroup label="${z.name}">${z.areas.map((a) => `<option>${a}</option>`).join('')}</optgroup>`)
      .join('');
    fArea.value = data.coverage[mode].zones.some((z) => z.areas.includes(keep)) ? keep : '';
  };

  const filterAreas = () => {
    const q = norm(areaSearch.value);
    const panel = $(`[data-zones="${mode}"]`);
    let hits = 0;
    $$<HTMLButtonElement>('.area', panel).forEach((b) => {
      const match = !!q && norm(b.dataset.area!).includes(q);
      b.classList.toggle('hit', match);
      b.classList.toggle('dim', !!q && !match);
      if (match) hits++;
    });
    const out = $('[data-cov-result]');
    if (!q) out.textContent = '';
    else if (hits) out.innerHTML = `<b>Yes</b> — ${titles[mode]} reaches ${hits === 1 ? 'this area' : hits + ' matching areas'}.`;
    else {
      const other = mode === 'doorstep' ? 'pickup' : 'doorstep';
      const inOther = data.coverage[other].zones.some((z) => z.areas.some((a) => norm(a).includes(q)));
      out.innerHTML = inOther
        ? `Not on the ${titles[mode]} list, but <button type="button" class="linkish" data-switch="${other}">${titles[other]}</button> covers it.`
        : 'Not listed yet — book anyway and we will confirm.';
    }
  };

  const setMode = (m: string, fromForm = false) => {
    if (!data.coverage[m]) return;
    mode = m;
    $$('[data-mode]').forEach((c) => c.setAttribute('aria-checked', String(c.dataset.mode === m)));
    $$('[data-zones]').forEach((z) => (z.hidden = z.dataset.zones !== m));
    $('[data-cov-title]').textContent = titles[m];
    $('[data-cov-eta]').textContent = data.coverage[m].eta;
    if (!fromForm) $$<HTMLInputElement>('input[name="mode"]').forEach((r) => (r.checked = r.value === m));
    fillAreas();
    filterAreas();
    summary();
  };

  $$('[data-mode]').forEach((c) => c.addEventListener('click', () => setMode(c.dataset.mode!)));
  $$<HTMLInputElement>('input[name="mode"]').forEach((r) => r.addEventListener('change', () => setMode(r.value, true)));
  areaSearch.addEventListener('input', filterAreas);
  $('[data-cov-result]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-switch]');
    if (b) setMode(b.dataset.switch!);
  });
  $$<HTMLButtonElement>('.area').forEach((b) => b.addEventListener('click', () => {
    fArea.value = b.dataset.area!;
    summary();
    $$('.area').forEach((x) => x.classList.toggle('picked', x === b));
  }));

  // ---------- catalog ----------
  let brandFilter = 'all';
  const modelSearch = $<HTMLInputElement>('[data-model-search]');
  const filterCatalog = () => {
    const q = norm(modelSearch.value);
    let any = false;
    $$('[data-brand]').forEach((block) => {
      const brandOk = brandFilter === 'all' || block.dataset.brand === brandFilter;
      let n = 0;
      $$<HTMLButtonElement>('.model', block).forEach((m) => {
        const ok = brandOk && (!q || m.dataset.q!.includes(q));
        m.parentElement!.hidden = !ok;
        if (ok) n++;
      });
      block.hidden = n === 0;
      $('[data-brand-count]', block).textContent = `${n} model${n === 1 ? '' : 's'}`;
      if (n) any = true;
    });
    $('[data-empty]').hidden = any;
  };
  $$('[data-brand-filter]').forEach((b) => b.addEventListener('click', () => {
    brandFilter = b.dataset.brandFilter!;
    $$('[data-brand-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    filterCatalog();
  }));
  modelSearch.addEventListener('input', filterCatalog);

  // ---------- booking ----------
  const fillModels = (keep = '') => {
    const brand = data.brands.find((b) => b.id === fBrand.value);
    fModel.disabled = !brand;
    fModel.innerHTML = '<option value="">Model</option>' + (brand?.models.map((m) => `<option>${m}</option>`).join('') ?? '');
    if (keep) fModel.value = keep;
  };
  fBrand.addEventListener('change', () => { fillModels(); summary(); });

  $$<HTMLButtonElement>('.model').forEach((m) => m.addEventListener('click', () => {
    fBrand.value = m.dataset.modelBrand!;
    fillModels(m.dataset.model!);
    summary();
    $('#book').scrollIntoView({ behavior: 'smooth' });
  }));

  function summary() {
    $('[data-s-mode]').textContent = titles[mode];
    $('[data-s-area]').textContent = fArea.value || '—';
    const brand = data.brands.find((b) => b.id === fBrand.value);
    $('[data-s-phone]').textContent = brand ? `${brand.name}${fModel.value ? ' · ' + fModel.value : ''}` : '—';
    const iss = $$<HTMLInputElement>('input[name="issue"]:checked').map((i) => i.value);
    $('[data-s-issues]').textContent = iss.length ? iss.join(', ') : '—';
  }
  form.addEventListener('change', summary);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = $('[data-form-msg]');
    const fd = new FormData(form);
    const missing = ['area', 'brand', 'model', 'name', 'phone'].filter((k) => !String(fd.get(k) ?? '').trim());
    if (!fd.getAll('issue').length) missing.push('a repair');
    if (missing.length) {
      msg.className = 'form-msg err';
      msg.textContent = `Please add: ${missing.join(', ')}.`;
      return;
    }
    msg.className = 'form-msg ok';
    msg.textContent = `Thanks, ${fd.get('name')}. Your ${titles[mode].toLowerCase()} request for ${fd.get('model')} is noted — estimate ₹0. (Demo: bookings are not sent anywhere yet.)`;
  });

  // Start from ?mode= when linked from the home page.
  const start = new URLSearchParams(location.search).get('mode');
  setMode(start && data.coverage[start] ? start : 'doorstep');
</script>

<style>
  .page-head { padding: clamp(48px, 8vw, 100px) 0 20px; }
  .page-head h1 { margin: 18px 0 20px; max-width: 16ch; }
  .section.tight { padding: clamp(48px, 7vw, 88px) 0; }

  /* mode cards */
  .mode-pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .mode-card {
    position: relative;
    display: grid;
    gap: 8px;
    justify-items: start;
    text-align: left;
    padding: 28px;
    transition: border-color .3s, box-shadow .3s, transform .3s, background .3s;
  }
  .mode-card:hover { transform: translateY(-3px); }
  .mode-card[aria-checked='true'] {
    border-color: transparent;
    background:
      linear-gradient(#10101d, #10101d) padding-box,
      var(--grad) border-box;
    border: 1.5px solid transparent;
    box-shadow: 0 20px 60px -20px rgba(139, 92, 246, .7);
  }
  .mode-radio {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--ink-3);
    transition: border-color .2s, box-shadow .2s;
  }
  [aria-checked='true'] > .mode-radio { border-color: var(--cyan); box-shadow: inset 0 0 0 4px #10101d, inset 0 0 0 12px var(--cyan); }
  .mode-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 15px; background: rgba(255, 255, 255, .07); margin-bottom: 8px; transition: background .3s, color .3s; }
  [aria-checked='true'] .mode-icon { background: var(--grad); color: #07070d; }
  .mode-icon svg { width: 26px; height: 26px; }
  .mode-title { font-family: var(--display); font-size: 24px; font-weight: 600; }
  .mode-short { color: var(--cyan); font-weight: 500; font-size: 15px; }
  .mode-body { color: var(--ink-2); font-size: 15px; }
  .mode-fee { margin-top: 6px; font-size: 14px; color: var(--ink-3); }
  @media (max-width: 720px) { .mode-pick { grid-template-columns: 1fr; } }

  /* coverage */
  .coverage { margin-top: 20px; padding: clamp(20px, 3vw, 32px); }
  .cov-head { display: flex; justify-content: space-between; align-items: start; gap: 20px; flex-wrap: wrap; }
  .cov-eta { color: var(--ink-2); margin-top: 6px; }
  .cov-result { min-height: 1.6em; margin: 14px 0 4px; color: var(--ink-2); }
  .cov-result :global(b) { color: var(--lime); }
  .cov-result :global(.linkish) { border: 0; background: none; padding: 0; color: var(--cyan); text-decoration: underline; }
  .zones { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; margin-top: 10px; animation: fadeUp .5s both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } }
  .zone h3 { font-family: var(--body); font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
  .zone h3 small { font-weight: 500; letter-spacing: 0; text-transform: none; margin-left: 4px; }
  .areas { display: flex; flex-wrap: wrap; gap: 8px; }
  .area {
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .04);
    font-size: 14px;
    color: var(--ink-2);
    transition: all .2s;
  }
  .area:hover { color: var(--ink); border-color: rgba(255, 255, 255, .25); }
  .area.hit { color: #07070d; background: var(--lime); border-color: var(--lime); }
  .area.picked { color: #07070d; background: var(--cyan); border-color: var(--cyan); }
  .area.dim { opacity: .3; }
  .cov-note { margin-top: 22px; font-size: 13px; color: var(--ink-3); }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 48px;
    min-width: min(320px, 100%);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .05);
    transition: border-color .2s;
  }
  .search:focus-within { border-color: var(--cyan); }
  .search svg { width: 18px; height: 18px; color: var(--ink-3); flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: var(--ink); font: inherit; }

  /* catalog */
  .cat-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .cat-head h2 { margin-top: 14px; }
  .brand-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 32px; }
  .bchip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .04);
    font-size: 14px;
    color: var(--ink-2);
    transition: all .2s;
  }
  .bchip small { color: var(--ink-3); margin-left: 4px; }
  .bchip:hover { color: var(--ink); }
  .bchip[aria-pressed='true'] { background: var(--ink); color: #07070d; border-color: var(--ink); }
  .bchip[aria-pressed='true'] small { color: #55576d; }
  .brands { display: grid; gap: 36px; }
  .brand-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .brand-dot { width: 12px; height: 12px; border-radius: 50%; background: hsl(var(--h) 90% 65%); box-shadow: 0 0 14px hsl(var(--h) 90% 60%); }
  .brand-head h3 { font-size: 22px; }
  .brand-count { font-size: 13px; color: var(--ink-3); }
  .models { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .model {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .03);
    text-align: left;
    transition: border-color .2s, background .2s, transform .2s;
  }
  .model:hover { transform: translateY(-2px); border-color: hsl(var(--h) 80% 60% / .6); background: hsl(var(--h) 80% 60% / .08); }
  .model-name { font-weight: 500; }
  .model-price { font-size: 13px; color: var(--ink-3); }
  .empty { color: var(--ink-2); }

  /* booking */
  .book { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .book-form { padding: clamp(22px, 3vw, 36px); display: grid; gap: 22px; }
  .book-form h2 { margin-top: -8px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  legend { display: flex; align-items: center; gap: 10px; font-weight: 600; margin-bottom: 10px; }
  legend span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--grad); color: #07070d; font-size: 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  select, .book-form input:not([type='radio']):not([type='checkbox']) {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #0f0f1c;
    color: var(--ink);
    font: inherit;
    outline: none;
  }
  select:focus, .book-form input:focus { border-color: var(--cyan); }
  select:disabled { opacity: .5; }
  .seg-radio { position: relative; }
  .seg-radio input { position: absolute; opacity: 0; }

---
// Displays prices in the visitor's local currency.
// All decisions (IP → country → currency → live rate, admin ON/OFF, fallbacks) are made on
// the server by GET /api/currency (src/lib/currency). This script only *displays*:
// it asks once per session, then rewrites every "OMR n" text on the page (and anything
// added later, e.g. the cart) as e.g. "₹2,497". Stored amounts are never changed; the
// WhatsApp booking messages keep the base currency. If anything fails, prices stay in OMR.
import { site } from '../data/site';
const base = site.currency.trim();
---

<script is:inline define:vars={{ base }}>
(() => {
  // No browser-side copy: the server already caches countries and rates, so asking on each
  // page load is ~2 ms and an admin change shows on the very next reload.
  try { localStorage.removeItem('fx-v1'); sessionStorage.removeItem('fx-v2'); } catch {} // old browser-side caches

  const valid = (fx) => fx && /^[A-Z]{3}$/.test(fx.currency) && typeof fx.rate === 'number' && isFinite(fx.rate) && fx.rate > 0
    && fx.format && typeof fx.format.decimals === 'number';

  async function load() {
    const test = new URLSearchParams(location.search).get('country'); // only honoured by the server in dev/test mode
    try {
      const r = await fetch('/api/currency' + (test ? `?country=${encodeURIComponent(test)}` : ''), { headers: { accept: 'application/json' }, cache: 'no-store' });
      if (!r.ok) return null;
      const fx = await r.json();
      return valid(fx) ? fx : null;
    } catch { return null; }
  }

  const RE = new RegExp(`${base}\\s?(\\d[\\d,]*(?:\\.\\d+)?)`, 'g');
  function apply(fx) {
    if (!valid(fx) || fx.currency === base) return; // same currency / disabled / fallback → page stays as built
    let fmt;
    try {
      fmt = new Intl.NumberFormat(fx.format.locale || undefined, {
        style: 'currency', currency: fx.currency, currencyDisplay: fx.format.display || 'symbol',
        minimumFractionDigits: fx.format.decimals, maximumFractionDigits: fx.format.decimals,
      });
    } catch { return; }
    const swap = (s) => s.replace(RE, (_, n) => fmt.format(parseFloat(n.replace(/,/g, '')) * fx.rate).replace(/ /g, ' '));
    const fix = (n) => { const v = swap(n.nodeValue); if (v !== n.nodeValue) n.nodeValue = v; };
    const ok = (n) => n.parentElement && !n.parentElement.closest('script,style,textarea,[data-no-fx]');
    const walk = (root) => {
      const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, { acceptNode: (n) => (ok(n) && n.nodeValue.includes(base) ? 1 : 3) });
      const hits = []; while (w.nextNode()) hits.push(w.currentNode);
      hits.forEach(fix);
    };
    walk(document.body);
    new MutationObserver((ms) => ms.forEach((m) => {
      if (m.type === 'characterData') { if (ok(m.target) && m.target.nodeValue.includes(base)) fix(m.target); }
      m.addedNodes.forEach((n) => (n.nodeType === 3 ? ok(n) && n.nodeValue.includes(base) && fix(n) : n.nodeType === 1 && walk(n)));
    })).observe(document.body, { childList: true, subtree: true, characterData: true });
    document.documentElement.dataset.currency = fx.currency;
  }

  const go = async () => apply(await load());
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', go) : go();
})();
</script>

---
import '../styles/global.css';
import { site, nav, price, whatsappLink, branchList } from '../data/site';
import { categories, iconPaths } from '../data/devices';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.tagline} — screens, batteries and more for every major phone brand.` } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const footerBrands = ['Apple', 'Samsung', 'Google Pixel', 'Dell', 'HP', 'Lenovo'].map((name) => {
  const c = categories.find((x) => x.brands.some((b) => b.name.startsWith(name)))!;
  return { label: name, href: `/services?cat=${c.id}&q=${encodeURIComponent(name)}#catalog` };
});

// Services mega menu. Every link lands on the Services page — the site stays three pages.
---

<!doctype html>
<html lang="en" data-theme="blue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const ok = ['green', 'blue', 'red', 'teal', 'yellow', 'orange', 'slate'];
        let t = new URLSearchParams(location.search).get('theme');
        try { if (t && ok.includes(t)) localStorage.setItem('theme', t); else t = localStorage.getItem('theme'); } catch {}
        if (t === 'green') delete document.documentElement.dataset.theme;
        else if (t && ok.includes(t)) document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="grid"></span>
    </div>

    <header class="nav">
      <div class="wrap nav-inner glass">
        <a href="/" class="logo">
          <picture class="logo-img">
            <source srcset="/brand/danat-logo.webp" type="image/webp" />
            <img src="/brand/danat-logo.png" alt="" width="40" height="40" />
          </picture>
          {site.name}
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => n.href === '/services' ? (
              <li class="has-mega">
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined} aria-haspopup="true">
                  {n.label}
                  <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </a>
                <div class="mega" role="region" aria-label="Services menu">
                  <ul class="d-list">
                    {categories.map((c, i) => (
                      <li>
                        <a href={`/services?cat=${c.id}#catalog`} class:list={['d-item', { on: i === 0 }]} data-d={c.id}>
                          <svg class="d-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconPaths[c.icon]} />
                          {c.name}
                          <svg class="d-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <div class="d-panels">
                    {categories.map((c, i) => (
                      <div class:list={['d-panel', { on: i === 0 }]} data-dp={c.id}>
                        <h4>{c.name}</h4>
                        <p>{c.short}</p>
                        <ul>
                          {c.brands.slice(0, 10).map((b) => <li><a href={`/services?cat=${c.id}&q=${encodeURIComponent(b.name)}#catalog`}>{b.name}</a></li>)}
                        </ul>
                        <a class="d-all" href={`/services?cat=${c.id}#catalog`}>See all {c.brands.reduce((n, b) => n + b.models.length, 0)} models →</a>
                      </div>
                    ))}
                  </div>
                  <div class="d-foot">
                    <span>Doorstep or pickup across {site.country} · estimate <b>{price()}</b></span>
                    <a href="/services#book">Book a repair</a>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/services#book" class="btn btn-primary nav-cta">Book a repair</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="f-brand">
          <a href="/" class="logo">
            <picture class="logo-img"><source srcset="/brand/danat-logo.webp" type="image/webp" /><img src="/brand/danat-logo.png" alt="" width="40" height="40" /></picture>
            {site.name}
          </a>
          <p class="muted">Electronics repair across {site.country} since {site.since} — phones, laptops, computers, printers, CCTV and networking, at your door, by pickup or in-store.</p>
          <div class="f-social">
            <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3a5 5 0 0 0-5 5v2H7v4h2v7h4v-7h3l1-4h-4V9a1 1 0 0 1 1-1z"/></svg></a>
            <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
            <a href={whatsappLink()} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg></a>
          </div>
        </div>
        <div>
          <h4>Quick links</h4>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/services#book">Book a repair</a></li>
            <li><a href="/services#faq">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h4>Head office</h4>
          <ul class="f-contact">
            <li><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>{site.address}</li>
          </ul>
        </div>
        <div>
          <h4>Branches</h4>
          <ul>{branchList.map((b) => <li><a href={`/#branches`}>{b.name}</a></li>)}</ul>
        </div>
        <div>
          <h4>Devices</h4>
          <ul>{categories.map((c) => <li><a href={`/services?cat=${c.id}#catalog`}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h4>Popular brands</h4>
          <ul>{footerBrands.map((b) => <li><a href={b.href}>{b.label}</a></li>)}</ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
        <span>All estimates shown as {price()} — pricing to be announced.</span>
      </div>
    </footer>

    <a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg></a>

    <div class="theme-pick" data-theme-pick>
      <button type="button" class="theme-toggle" aria-expanded="false" aria-label="Change colour theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4.1-4-7.6-9-7.6z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10.5" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/></svg>
        Theme
      </button>
      <div class="theme-menu" role="group" aria-label="Colour theme" hidden>
        {[
          ['green', 'Green', '#2fd07f', '#07120e'],
          ['blue', 'Blue', '#1d4ed8', '#f4f7fc'],
          ['red', 'Red', '#e11d2e', '#faf7f7'],
          ['teal', 'Teal', '#0d9488', '#f2f8f7'],
          ['yellow', 'Yellow', '#f5b400', '#17171a'],
          ['orange', 'Orange', '#ff5a1f', '#f7f4ee'],
          ['slate', 'Slate', '#2f6bff', '#e6eaf0'],
        ].map(([id, label, a, b]) => (
          <button type="button" data-theme-id={id} aria-pressed="false">
            <span class="sw" style={`--a:${a};--b:${b}`}></span>{label}
          </button>
        ))}
      </div>
    </div>

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Services dropdown. Opens on hover — but not when a page loads with the
      // pointer already over it: it arms only after the pointer has been
      // outside the menu once. Clicking a link closes and disarms it.
      const megaLi = document.querySelector<HTMLElement>('.has-mega');
      if (megaLi) {
        let t = 0;
        let armed = false;
        const close = () => { clearTimeout(t); megaLi.classList.remove('open'); };
        document.addEventListener('pointermove', (e) => { if (!megaLi.contains(e.target as Node)) armed = true; }, { passive: true });
        megaLi.addEventListener('pointerenter', () => { if (!armed) return; clearTimeout(t); t = window.setTimeout(() => megaLi.classList.add('open'), 60); });
        megaLi.addEventListener('pointerleave', () => { clearTimeout(t); t = window.setTimeout(close, 140); });
        megaLi.addEventListener('focusin', () => megaLi.classList.add('open'));
        megaLi.addEventListener('focusout', (e) => { if (!megaLi.contains(e.relatedTarget as Node)) close(); });
        megaLi.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); megaLi.querySelector<HTMLElement>('a')?.focus(); } });
        // Hovering a device shows its brands on the right
        const items = megaLi.querySelectorAll<HTMLElement>('[data-d]');
        const panels = megaLi.querySelectorAll<HTMLElement>('[data-dp]');
        const show = (id: string) => {
          items.forEach((x) => x.classList.toggle('on', x.dataset.d === id));
          panels.forEach((x) => x.classList.toggle('on', x.dataset.dp === id));
        };
        // Small hover intent so a diagonal move toward the brands doesn't flip the panel.
        let dt = 0;
        items.forEach((x) => {
          x.addEventListener('pointerenter', () => { clearTimeout(dt); dt = window.setTimeout(() => { if (x.matches(':hover')) show(x.dataset.d!); }, 90); });
          x.addEventListener('pointerleave', () => clearTimeout(dt));
          x.addEventListener('focus', () => show(x.dataset.d!));
        });
        megaLi.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => {
          close();
          armed = false;
          (document.activeElement as HTMLElement | null)?.blur();
        }));
      }
      // Theme switcher
      const pick = document.querySelector<HTMLElement>('[data-theme-pick]')!;
      const menu = pick.querySelector<HTMLElement>('.theme-menu')!;
      const toggle = pick.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const current = () => document.documentElement.dataset.theme ?? 'green';
      const mark = () => menu.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.themeId === current())));
      mark();
      toggle.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        toggle.setAttribute('aria-expanded', String(!menu.hidden));
      });
      menu.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-id]');
        if (!b) return;
        const t = b.dataset.themeId!;
        if (t === 'green') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch {}
        const u = new URL(location.href);
        u.searchParams.set('theme', t);
        history.replaceState(null, '', u);
        mark();
      });
    </script>
  </body>
</html>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .35;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .o1 { width: 40vw; height: 40vw; right: -8vw; top: -12vw; background: var(--glow); }
  @keyframes drift {
    to { transform: translate3d(6vw, 4vh, 0) scale(1.12); }
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(15, 27, 45, .09) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 70%);
  }

  /* Default green theme: engineering grid like the hero mockup */
  :global(:root:not([data-theme])) .grid {
    background-image:
      linear-gradient(rgba(47, 208, 127, .06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 208, 127, .06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(#000, transparent 85%);
  }
  :global(:root:not([data-theme])) .nav-inner { background: rgba(13, 28, 23, .85); border-color: rgba(255,255,255,.08); backdrop-filter: blur(12px); }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    transition: padding .3s;
  }
  .nav.scrolled { padding: 8px 0; }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 10px 10px 20px;
    border-radius: 999px;
    background: var(--surface);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -.02em;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--grad);
    color: var(--on-accent);
  }
  .logo-mark svg { width: 22px; height: 22px; }
  .logo-img img { display: block; width: 40px; height: 40px; border-radius: 10px; background: #fff; object-fit: contain; }
  .contact { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 6px; font-size: 14px; color: rgba(255,255,255,.75); }
  .contact a:hover { color: #fff; text-decoration: underline; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink-2);
    transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--violet); background: var(--accent-soft); font-weight: 600; }
  .nav-cta { padding: 11px 20px; }

  @media (max-width: 720px) {
    .nav-inner { flex-wrap: wrap; border-radius: 22px; gap: 8px; padding: 10px 12px; }
    nav { order: 3; width: 100%; margin: 0; }
    nav ul { justify-content: space-between; }
    nav a { padding: 8px 10px; font-size: 14px; }
    .nav-cta { margin-left: auto; padding: 9px 14px; font-size: 14px; }
  }

  .footer { margin-top: 40px; background: var(--navy); color: #fff; border-radius: 32px 32px 0 0; }
  .footer .logo { color: #fff; }
  .footer-grid { display: grid; grid-template-columns: 1.35fr .7fr 1.55fr .8fr 1.05fr .8fr; gap: 26px; padding: 56px 0 36px; }
  .footer h4 { font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: 14px; }
  .footer-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; font-size: 14px; }
  .footer-grid ul a { color: rgba(255,255,255,.78); transition: color .15s; }
  .footer-grid ul a:hover { color: #fff; }
  .f-contact li { color: rgba(255,255,255,.78); line-height: 1.45; }
  .f-contact a[href^="mailto"] { font-size: 13px; white-space: nowrap; }
  .muted { color: rgba(255,255,255,.6); margin-top: 14px; max-width: 38ch; font-size: 14px; }
  .f-social { display: flex; gap: 10px; margin-top: 20px; }
  .f-social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,.08); color: #fff; transition: background .2s, transform .2s; }
  .f-social a:hover { background: var(--violet); transform: translateY(-2px); }
  .f-social svg { width: 18px; height: 18px; }
  @media (max-width: 1000px) { .footer-grid { grid-template-columns: 1fr 1fr 1fr; } .f-brand { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 0 32px;
    font-size: 13px;
    color: rgba(255,255,255,.5);
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .wa-float {
    position: fixed; right: 18px; bottom: 84px; z-index: 60;
    display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%;
    background: #25d366; color: #fff; box-shadow: 0 12px 30px -8px rgba(37, 211, 102, .6);
    transition: transform .2s;
  }
  .wa-float::after { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 0 0 0 rgba(37,211,102,.5); animation: waPulse 2.4s infinite; }
  @keyframes waPulse { 70% { box-shadow: 0 0 0 16px rgba(37,211,102,0); } 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); } }
  .wa-float:hover { transform: scale(1.08); }
  .wa-float svg { width: 30px; height: 30px; }
  .theme-pick { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 16px; border-radius: 999px; border: 0;
    background: var(--ink); color: var(--bg); font-weight: 600; font-size: 14px;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, .45);
  }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-menu {
    order: -1; display: grid; gap: 4px; padding: 8px; min-width: 170px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow);
  }
  .theme-menu button {
    display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 0; border-radius: 10px;
    background: none; font-size: 14px; font-weight: 500; color: var(--ink-2); text-align: left;
  }
  .theme-menu button:hover { background: var(--tint-2); color: var(--ink); }
  .theme-menu button[aria-pressed='true'] { background: var(--accent-soft); color: var(--ink); font-weight: 700; }
  .sw { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  /* Services dropdown — compact: device list · brand preview · footer */
  .has-mega { position: relative; }
  .has-mega > a { display: inline-flex; align-items: center; gap: 4px; }
  .caret { width: 14px; height: 14px; transition: transform .25s; }
  .mega {
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    width: 680px;
    margin-left: -340px;
    display: grid;
    grid-template-columns: 270px 1fr;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 24px 60px -24px rgba(15, 27, 45, .35), var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(.98);
    transform-origin: top center;
    transition: opacity .18s, transform .22s cubic-bezier(.2,.8,.2,1), visibility 0s .22s;
    z-index: 70;
  }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -20px; height: 20px; }

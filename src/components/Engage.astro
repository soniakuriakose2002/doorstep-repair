---
// Re-engagement (manager brief):
//  • Idle 35 s (no mouse, scroll, key or touch) → "Book Your Slot" image slider
//    with a quick phone/email field that sends to WhatsApp.
//  • Exit intent (pointer leaves through the top) or cursor still for 15 s →
//    slide-in panel from the LEFT asking what service they need.
// Each shows at most once per browser session, and never on top of another popup.
import { site, price } from '../data/site';
import { categories, iconPaths } from '../data/devices';
const label: Record<string, string> = { mobile: 'Mobile repair', laptop: 'Laptop repair', printer: 'Printer repair', cctv: 'CCTV installation', network: 'Wi-Fi & networking', data: 'Data recovery' };

const tel = site.phone.tel.replace('+', '');
const slides = ['mobile', 'laptop', 'printer', 'cctv', 'network', 'data'].map((id) => categories.find((c) => c.id === id)!);
const pitch: Record<string, string> = {
  mobile: 'Screens, batteries and charging ports fixed at your door.',
  laptop: 'Screens, keyboards, batteries and board repair.',
  printer: 'Jams, print quality and setup — on-site.',
  cctv: 'Survey, install and phone viewing.',
  network: 'Wi-Fi dead zones, mesh and cabling.',
  data: 'Deleted files and dead drives recovered.',
};
---

<!-- Book your slot popup (on open, and after 35 s idle) -->
<div class="ig" data-idle hidden data-tel={tel}>
  <div class="ig-bg" data-idle-x></div>
  <div class="ig-card" role="dialog" aria-modal="true" aria-labelledby="ig-title">
    <button type="button" class="ig-x" data-idle-x aria-label="Close">×</button>
    <h2 id="ig-title">Book your slot</h2>
    <div class="ig-slider">
      {slides.map((c, i) => (
        <div class:list={['ig-slide', { on: i === 0 }]} data-slide={i}>
          <span class="ig-circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
          <div class="ig-txt">
            <b>{label[c.id]}</b>
            <p>{pitch[c.id]}</p>
            <a class="ig-go" target="_blank" rel="noopener" href={`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat, I want to book a ${label[c.id].toLowerCase()}.`)}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Book {label[c.id].toLowerCase()}</a>
          </div>
        </div>
      ))}
      <button type="button" class="ig-arrow prev" data-prev aria-label="Previous">‹</button>
      <button type="button" class="ig-arrow next" data-next aria-label="Next">›</button>
    </div>
    <div class="ig-dots">{slides.map((_, i) => <button type="button" data-dot={i} class:list={[{ on: i === 0 }]} aria-label={`Slide ${i + 1}`}></button>)}</div>
    <form class="ig-quick" data-quick>
      <label for="ig-contact">Your phone or email</label>
      <div class="ig-row">
        <input id="ig-contact" name="contact" required placeholder="9XXX XXXX or name@email.com" autocomplete="tel" />
        <button type="submit"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Send</button>
      </div>
      <p class="ig-msg" data-quick-msg aria-live="polite">We reply on WhatsApp during working hours.</p>
    </form>
  </div>
</div>
<!-- Left slide-in -->
<aside class="sl" data-slide-in hidden aria-label="Need help?">
  <button type="button" class="sl-x" data-sl-x aria-label="Close">×</button>
  <span class="sl-wave" aria-hidden="true">👋</span>
  <b>Before you go…</b>
  <p>What do you need fixed today?</p>
  <div class="sl-chips">
    {categories.map((c) => (
      <a target="_blank" rel="noopener" href={`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat, I need help with my ${c.name}.`)}`}>{c.name}</a>
    ))}
  </div>
  <a class="sl-cta" href="/#book-services">See all services & book →</a>
</aside>

<script>
  const idle = document.querySelector<HTMLElement>('[data-idle]');
  const sl = document.querySelector<HTMLElement>('[data-slide-in]');
  if (idle && sl) {
    const tel = idle.dataset.tel!;
    const ss = (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } };
    const sset = (k: string) => { try { sessionStorage.setItem(k, '1'); } catch {} };
    const q = new URLSearchParams(location.search);
    const IDLE_MS = Number(q.get('idle')) * 1000 || 35000;
    const STILL_MS = Number(q.get('still')) * 1000 || 15000;
    const busy = () => document.documentElement.style.overflow === 'hidden' || ![...document.querySelectorAll<HTMLElement>('[data-po],[data-sw],[data-idle]')].every((m) => m.hidden);

    // ---- idle slider ----
    let slideT = 0, cur = 0;
    const slides = [...idle.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...idle.querySelectorAll<HTMLElement>('[data-dot]')];
    const go = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('on', k === cur));
      dots.forEach((d, k) => d.classList.toggle('on', k === cur));
      clearTimeout(slideT);
      slideT = window.setTimeout(() => go(cur + 1), 3200);
    };
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    idle.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    idle.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    const openIdle = (force = false) => {
      if (!force && (ss('idle-shown') || busy())) return;
      sset('idle-shown');
      hideSl();
      idle.hidden = false;
      requestAnimationFrame(() => idle.classList.add('in'));
      document.documentElement.style.overflow = 'hidden';
      go(0);
    };
    const closeIdle = () => {
      idle.classList.remove('in');
      document.documentElement.style.overflow = '';
      clearTimeout(slideT);
      setTimeout(() => (idle.hidden = true), 350);
    };
    idle.querySelectorAll('[data-idle-x]').forEach((b) => b.addEventListener('click', closeIdle));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !idle.hidden) closeIdle(); });

    idle.querySelector<HTMLFormElement>('[data-quick]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (new FormData(e.target as HTMLFormElement).get('contact') as string).trim();
      const msg = idle.querySelector('[data-quick-msg]')!;
      const ok = /^\+?[\d\s-]{7,}$/.test(v) || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
      if (!ok) { msg.textContent = 'Please enter a phone number or email.'; msg.className = 'ig-msg err'; return; }
      window.open(`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat, please contact me about a repair: ${v}`)}`, '_blank', 'noopener');
      msg.textContent = 'Thanks — opening WhatsApp to send it to our team.';
      msg.className = 'ig-msg ok';
    });

    // Opens on arrival too (Popups.astro calls this as the default welcome popup)
    (window as any).__openSlot = () => openIdle(true);

    // ---- left slide-in ----
    const showSl = () => {
      if (ss('sl-shown') || busy()) return;
      sset('sl-shown');
      sl.hidden = false;
      requestAnimationFrame(() => sl.classList.add('in'));
    };
    const hideSl = () => { sl.classList.remove('in'); setTimeout(() => (sl.hidden = true), 400); };
    sl.querySelector('[data-sl-x]')!.addEventListener('click', hideSl);
    document.addEventListener('mouseout', (e) => { if (!e.relatedTarget && e.clientY <= 0) showSl(); });

    // ---- timers ----
    let idleT = 0, stillT = 0;
    const armIdle = () => { clearTimeout(idleT); idleT = window.setTimeout(openIdle, IDLE_MS); };
    const armStill = () => { clearTimeout(stillT); stillT = window.setTimeout(showSl, STILL_MS); };
    ['scroll', 'keydown', 'touchstart', 'wheel'].forEach((ev) => addEventListener(ev, armIdle, { passive: true }));
    addEventListener('mousemove', () => { armIdle(); armStill(); }, { passive: true });
    armIdle();
    if (matchMedia('(pointer: fine)').matches) armStill();
  }
</script>

<style>
  .ig { position: fixed; inset: 0; z-index: 88; display: grid; place-items: center; padding: 16px; }
  .ig[hidden] { display: none; }
  .ig-bg { position: absolute; inset: 0; background: rgba(8, 14, 22, .55); backdrop-filter: blur(6px); opacity: 0; transition: opacity .35s; }
  .ig.in .ig-bg { opacity: 1; }
  .ig-card { position: relative; width: min(520px, 100%); max-height: calc(100vh - 32px); overflow: auto; padding: 28px 26px 22px; background: var(--surface); border-radius: 26px; box-shadow: 0 40px 100px -30px rgba(0,0,0,.6); transform: translateY(26px) scale(.96); opacity: 0; transition: transform .5s cubic-bezier(.2,1.2,.3,1), opacity .35s; }
  .ig.in .ig-card { transform: none; opacity: 1; }
  .ig-x { position: absolute; right: 16px; top: 16px; z-index: 2; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--tint-2); color: var(--ink); font-size: 20px; line-height: 1; }
  .ig-card h2 { font-size: 28px; margin: 4px 0 18px; }
  .ig-slider { position: relative; display: grid; height: 226px; border-radius: 20px; overflow: hidden;
    background: radial-gradient(circle at 25% 50%, color-mix(in srgb, var(--violet) 70%, #000) 0, transparent 60%), linear-gradient(135deg, color-mix(in srgb, var(--violet) 55%, #000), color-mix(in srgb, var(--violet) 25%, #000)); }
  .ig-slide { grid-area: 1 / 1; display: grid; grid-template-columns: 170px 1fr; align-items: center; gap: 18px; padding: 0 44px 0 30px; color: #fff; opacity: 0; transform: translateX(24px); transition: opacity .45s, transform .55s cubic-bezier(.2,.8,.2,1); pointer-events: none; }
  .ig-slide.on { opacity: 1; transform: none; pointer-events: auto; }
  .ig-circle { position: relative; display: grid; place-items: center; width: 140px; height: 140px; border-radius: 50%; background: color-mix(in srgb, var(--violet) 60%, #fff 8%); color: #fff; }
  .ig-circle::before { content: ''; position: absolute; inset: -22px; border-radius: 50%; border: 1px dashed rgba(255,255,255,.28); animation: igSpin 18s linear infinite; }
  @keyframes igSpin { to { transform: rotate(360deg); } }
  .ig-circle svg { width: 64px; height: 64px; }
  .ig-slide.on .ig-circle svg { animation: igPop .6s cubic-bezier(.3,1.6,.5,1); }
  @keyframes igPop { from { transform: scale(.6); opacity: 0; } }
  .ig-txt { display: grid; gap: 8px; justify-items: start; }
  .ig-txt b { font-family: var(--display); font-size: 26px; line-height: 1.1; }
  .ig-txt p { font-size: 14px; color: rgba(255,255,255,.82); line-height: 1.45; }
  .ig-go { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; padding: 10px 16px; border-radius: 10px; background: #25d366; color: #fff; font-weight: 700; font-size: 14px; transition: transform .2s; }
  .ig-go:hover { transform: translateY(-2px); }
  .ig-go svg { width: 16px; height: 16px; }
  .ig-arrow { position: absolute; top: 50%; z-index: 2; width: 34px; height: 34px; margin-top: -17px; border: 0; border-radius: 50%; background: rgba(255,255,255,.18); color: #fff; font-size: 22px; line-height: 1; backdrop-filter: blur(4px); transition: background .2s; }
  .ig-arrow:hover { background: rgba(255,255,255,.32); }
  .ig-arrow.prev { left: 10px; } .ig-arrow.next { right: 10px; }
  .ig-dots { display: flex; justify-content: center; gap: 6px; margin: 14px 0 18px; }
  .ig-dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 999px; background: var(--line); transition: width .3s, background .3s; }
  .ig-dots button.on { width: 22px; background: var(--violet); }
  .ig-quick label { display: block; font-weight: 700; font-size: 14.5px; margin-bottom: 8px; }
  .ig-row { display: flex; gap: 10px; }
  .ig-row input { flex: 1; min-width: 0; height: 48px; padding: 0 16px; border: 1px solid var(--line); border-radius: 12px; outline: none; font: inherit; background: var(--tint); color: var(--ink); }
  .ig-row input:focus { border-color: var(--violet); background: var(--surface); }
  .ig-row button { display: inline-flex; align-items: center; gap: 8px; padding: 0 20px; border: 0; border-radius: 12px; background: var(--violet); color: var(--on-accent); font-weight: 700; box-shadow: 0 10px 24px -10px rgba(var(--a1), .8); }
  .ig-row button svg { width: 16px; height: 16px; }
  .ig-msg { font-size: 12.5px; margin-top: 10px; color: var(--ink-3); }
  .ig-msg.err { color: #be123c; }
  .ig-msg.ok { color: var(--lime); }
  @media (max-width: 520px) { .ig-slide { grid-template-columns: 1fr; justify-items: center; text-align: center; padding: 20px 44px; } .ig-circle { width: 90px; height: 90px; } .ig-circle svg { width: 42px; height: 42px; } .ig-slider { height: 300px; } .ig-txt { justify-items: center; } }
  .sl { position: fixed; left: 18px; bottom: 120px; z-index: 86; width: min(320px, calc(100% - 36px)); display: grid; gap: 8px; padding: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 30px 70px -20px rgba(0,0,0,.45); transform: translateX(-120%); transition: transform .55s cubic-bezier(.2,1.1,.3,1); }
  .sl[hidden] { display: none; }
  .sl.in { transform: none; }
  .sl-x { position: absolute; right: 12px; top: 12px; width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--tint-2); font-size: 18px; line-height: 1; color: var(--ink); }
  .sl-wave { font-size: 30px; animation: wave 1.6s ease-in-out infinite; transform-origin: 70% 80%; display: inline-block; width: max-content; }
  @keyframes wave { 0%, 60%, 100% { transform: rotate(0); } 10%, 30% { transform: rotate(16deg); } 20%, 40% { transform: rotate(-10deg); } }
  .sl b { font-size: 20px; font-family: var(--display); }
  .sl p { font-size: 14px; color: var(--ink-2); }
  .sl-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0; }
  .sl-chips a { padding: 6px 11px; border-radius: 999px; border: 1px solid var(--line); font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
  .sl-chips a:hover { border-color: #25d366; color: #1f7a3a; background: #e8faf0; }
  .sl-cta { font-size: 13.5px; font-weight: 700; color: var(--violet); }
</style>

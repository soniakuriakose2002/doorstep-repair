---
// "Spin the wheel" offer popup. PLACEHOLDER PRIZES — replace with the client's
// real offers. Every slice is a win; the result and code are remembered.
import { site } from '../data/site';

const prizes = [
  { label: 'Free diagnosis', code: 'SPIN-DIAG' },
  { label: 'Free pickup', code: 'SPIN-PICK' },
  { label: 'Free cleaning', code: 'SPIN-CLEAN' },
  { label: 'Priority slot', code: 'SPIN-FAST' },
  { label: 'Free data backup', code: 'SPIN-DATA' },
  { label: 'Free screen guard', code: 'SPIN-GUARD' },
];
const n = prizes.length;
const seg = 360 / n;
const R = 150;
const pt = (deg: number, r = R) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return `${(160 + r * Math.cos(a)).toFixed(2)} ${(160 + r * Math.sin(a)).toFixed(2)}`;
};
const wa = (msg: string) => `https://wa.me/${site.phone.tel.replace('+', '')}?text=${encodeURIComponent(msg)}`;
---

<div class="sw" data-sw hidden data-prizes={JSON.stringify(prizes)}>
  <div class="sw-bg" data-sw-x></div>
  <div class="sw-card" role="dialog" aria-modal="true" aria-labelledby="sw-title">
    <button type="button" class="sw-x" data-sw-x aria-label="Close">×</button>

    <div class="sw-wheel-wrap">
      <span class="sw-pointer" aria-hidden="true"></span>
      <svg class="sw-wheel" data-sw-wheel viewBox="0 0 320 320" aria-hidden="true">
        <circle cx="160" cy="160" r="158" class="rim" />
        {prizes.map((p, i) => {
          const a0 = i * seg, a1 = (i + 1) * seg, mid = a0 + seg / 2;
          return (
            <g>
              <path d={`M160 160 L${pt(a0)} A${R} ${R} 0 0 1 ${pt(a1)} Z`} class:list={['slice', i % 2 ? 'b' : 'a']} />
              <text transform={`rotate(${mid} 160 160)`} x="160" y="52" class="lbl">
                {p.label.split(' ').map((w, k) => <tspan x="160" dy={k ? 15 : 0}>{w}</tspan>)}
              </text>
            </g>
          );
        })}
        {[...Array(n * 2)].map((_, i) => { const [x, y] = pt(i * (seg / 2), 154).split(' '); return <circle cx={x} cy={y} r="3.5" class="bulb" style={`--i:${i}`} />; })}
        <circle cx="160" cy="160" r="30" class="hub" />
        <text x="160" y="166" class="hub-t">SPIN</text>
      </svg>
    </div>

    <div class="sw-body">
      <div data-sw-before>
        <span class="sw-badge">🎁 Spin &amp; win</span>
        <h2 id="sw-title">Try your luck</h2>
        <p>Spin the wheel for a free extra on your next repair. Every slice wins.</p>
        <button type="button" class="btn btn-primary sw-go" data-sw-spin>Spin the wheel</button>
        <button type="button" class="sw-later" data-sw-x>Maybe later</button>
      </div>
      <div data-sw-after hidden>
        <span class="sw-badge win">🎉 You won</span>
        <h2 data-sw-prize>—</h2>
        <p>Use this code when you book. Valid for your next repair.</p>
        <button type="button" class="sw-code" data-sw-code><span>Code</span><b data-sw-codetext>—</b><em data-sw-copied>Tap to copy</em></button>
        <div class="sw-btns">
          <a href="/services#book" class="btn btn-primary" data-sw-book>Book now</a>
          <a href="#" target="_blank" rel="noopener" class="btn" data-sw-wa data-base={wa('Hello Danat — I won on the spin wheel, code: ')}>WhatsApp us</a>
        </div>
      </div>
    </div>
    <div class="confetti" data-confetti aria-hidden="true"></div>
  </div>
</div>

<script>
  const sw = document.querySelector<HTMLElement>('[data-sw]');
  if (sw) {
    const prizes: { label: string; code: string }[] = JSON.parse(sw.dataset.prizes!);
    const wheel = sw.querySelector<SVGElement>('[data-sw-wheel]')!;
    const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const put = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const seg = 360 / prizes.length;

    const show = (i: number) => {
      const p = prizes[i];
      sw.querySelector('[data-sw-before]')!.setAttribute('hidden', '');
      sw.querySelector('[data-sw-after]')!.removeAttribute('hidden');
      sw.querySelector('[data-sw-prize]')!.textContent = p.label;
      sw.querySelector('[data-sw-codetext]')!.textContent = p.code;
      const wa = sw.querySelector<HTMLAnchorElement>('[data-sw-wa]')!;
      wa.href = wa.dataset.base! + encodeURIComponent(p.code);
    };
    const confetti = () => {
      const box = sw.querySelector<HTMLElement>('[data-confetti]')!;
      box.innerHTML = '';
      for (let k = 0; k < 60; k++) {
        const s = document.createElement('i');
        s.style.cssText = `--x:${Math.random() * 100}%;--r:${Math.random() * 720 - 360}deg;--d:${1.4 + Math.random()}s;--c:${['#2e8b46', '#f5b400', '#e0362c', '#1d4ed8', '#fff'][k % 5]};animation-delay:${Math.random() * .3}s`;
        box.appendChild(s);
      }
    };

    // Popup open/close is driven by Popups.astro (window.__openOffer)
    (window as any).__openSpin = () => {
      const won = get('spin-won');
      if (won !== null) show(Number(won));
      sw.hidden = false;
      requestAnimationFrame(() => sw.classList.add('in'));
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => {
      sw.classList.remove('in');
      document.documentElement.style.overflow = '';
      setTimeout(() => (sw.hidden = true), 350);
      (window as any).__offerClosed?.();
    };
    sw.querySelectorAll('[data-sw-x]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sw.hidden) close(); });

    let spinning = false;
    sw.querySelector('[data-sw-spin]')!.addEventListener('click', () => {
      if (spinning) return;
      spinning = true;
      const i = Math.floor(Math.random() * prizes.length);
      const target = 360 * 6 + (360 - (i * seg + seg / 2)) + (Math.random() * seg * .6 - seg * .3);
      wheel.style.transition = 'transform 4.6s cubic-bezier(.12,.8,.12,1)';
      wheel.style.transform = `rotate(${target}deg)`;
      sw.classList.add('spinning');
      setTimeout(() => {
        sw.classList.remove('spinning');
        put('spin-won', String(i));
        show(i);
        confetti();
      }, 4700);
    });
    sw.querySelector('[data-sw-code]')!.addEventListener('click', async () => {
      const code = sw.querySelector('[data-sw-codetext]')!.textContent!;
      try { await navigator.clipboard.writeText(code); sw.querySelector('[data-sw-copied]')!.textContent = 'Copied ✓'; }
      catch { sw.querySelector('[data-sw-copied]')!.textContent = code; }
    });
  }
</script>

<style>
  .sw { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 16px; }
  .sw[hidden] { display: none; }
  .sw-bg { position: absolute; inset: 0; background: rgba(8, 14, 12, .6); backdrop-filter: blur(4px); opacity: 0; transition: opacity .35s; }
  .sw.in .sw-bg { opacity: 1; }
  .sw-card {
    position: relative; width: min(820px, 100%); display: grid; grid-template-columns: 1.05fr 1fr; align-items: center;
    background: var(--surface); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 100px -30px rgba(0,0,0,.6);
    transform: translateY(30px) scale(.94); opacity: 0; transition: transform .5s cubic-bezier(.2,1.2,.3,1), opacity .35s;
  }
  .sw.in .sw-card { transform: none; opacity: 1; }
  .sw-x { position: absolute; right: 14px; top: 14px; z-index: 3; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--tint-2); color: var(--ink); font-size: 22px; line-height: 1; }

  .sw-wheel-wrap { position: relative; padding: 38px 26px 30px; background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--violet) 70%, #fff), var(--violet) 55%, color-mix(in srgb, var(--violet) 40%, #000)); }
  .sw-wheel { display: block; width: 100%; max-width: 330px; margin: auto; filter: drop-shadow(0 18px 30px rgba(0,0,0,.35)); }
  .rim { fill: #11261a; }
  .slice.a { fill: #ffffff; }
  .slice.b { fill: #f5b400; }
  .lbl { font: 800 12.5px var(--body); fill: #11261a; text-anchor: middle; text-transform: uppercase; letter-spacing: .02em; }
  .bulb { fill: #fff3c4; animation: bulb 1s infinite; animation-delay: calc(var(--i) * .1s); }
  .spinning .bulb { animation-duration: .25s; }
  @keyframes bulb { 50% { fill: #ffb400; } }
  .hub { fill: #11261a; stroke: #fff; stroke-width: 4; }
  .hub-t { font: 800 13px var(--display); fill: #fff; text-anchor: middle; letter-spacing: .06em; }
  .sw-pointer { position: absolute; left: 50%; top: 22px; z-index: 2; width: 0; height: 0; margin-left: -16px; border: 16px solid transparent; border-top: 30px solid #e0362c; border-bottom: 0; filter: drop-shadow(0 4px 4px rgba(0,0,0,.35)); }
  .spinning .sw-pointer { animation: tick .12s infinite alternate; }
  @keyframes tick { to { transform: rotate(-12deg); } }

  .sw-body { padding: 34px 32px; }
  .sw-body > div { display: grid; gap: 12px; }
  .sw-body [hidden] { display: none !important; }
  .sw-badge { justify-self: start; padding: 6px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--violet); font-size: 13px; font-weight: 800; }
  .sw-badge.win { background: #fff4d6; color: #8a5a00; }
  .sw-body h2 { font-size: clamp(28px, 3.2vw, 38px); line-height: 1.08; }
  .sw-body p { color: var(--ink-2); font-size: 15px; }
  .sw-go { justify-self: start; padding: 14px 26px; font-size: 16px; animation: nudge 2s ease-in-out infinite; }
  @keyframes nudge { 0%, 80%, 100% { transform: none; } 85% { transform: scale(1.06) rotate(-2deg); } 92% { transform: scale(1.06) rotate(2deg); } }
  .sw-later { justify-self: start; border: 0; background: none; padding: 0; font-size: 13px; color: var(--ink-3); text-decoration: underline; }
  .sw-code { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 2px dashed var(--violet); border-radius: 14px; background: var(--accent-soft); color: var(--ink); text-align: left; }
  .sw-code span { font-size: 12px; color: var(--ink-3); }
  .sw-code b { font-family: var(--display); font-size: 18px; letter-spacing: .08em; color: var(--violet); }
  .sw-code em { margin-left: auto; font-style: normal; font-size: 12px; font-weight: 700; color: var(--violet); }
  .sw-btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .sw-btns .btn { padding: 12px 20px; font-size: 14px; }

  .confetti { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .confetti :global(i) { position: absolute; top: -12px; left: var(--x); width: 8px; height: 12px; border-radius: 2px; background: var(--c); animation: fall var(--d) ease-in forwards; }
  @keyframes fall { to { transform: translateY(560px) rotate(var(--r)); opacity: 0; } }

  @media (max-width: 700px) {
    .sw-card { grid-template-columns: 1fr; max-height: calc(100vh - 32px); overflow-y: auto; }
    .sw-wheel { max-width: 240px; }
    .sw-body { padding: 22px; }
  }
</style>

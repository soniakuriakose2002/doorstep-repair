---
import Base from '../layouts/Base.astro';
import { serviceModes, price, site } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';
import { coverage } from '../data/coverage';
import { note as issueNote } from '../data/menu';
const issueSvg = (s: string) => {
  const t = s.toLowerCase();
  const I: [RegExp, string][] = [
    [/back glass/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><circle cx="10" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/>'],
    [/screen|glass|display/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 6l6 6M9 11l3 3"/>'],
    [/battery/, '<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2h4M12 9l-2 4h4l-2 4"/>'],
    [/charg|power/, '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>'],
    [/camera|cctv|viewing|dvr|nvr/, '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'],
    [/water|fire/, '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>'],
    [/speaker|micro/, '<path d="M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6"/>'],
    [/wi-?fi|router|mesh|lan|network|switch|cabling/, '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>'],
    [/drive|ssd|ram|disk|deleted|format|recover|backup/, '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 14h18"/>'],
    [/paper|toner|cartridge|roller|print|head/, '<path d="M7 9V3.5h10V9"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/>'],
    [/keyboard|trackpad|button/, '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h1M11 10h1M15 10h1M7 14h10"/>'],
    [/software|os |install|virus|email|365|setup|tune/, '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/>'],
  ];
  return I.find(([re]) => re.test(t))?.[1] ?? '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>';
};

// Map centre for each coverage zone, in zone order (Muscat, Sohar/Al Batinah, Salalah/Dhofar).
const zoneGeo: [number, number][] = [[23.593, 58.556], [24.347, 56.709], [17.019, 54.089]];

// Common questions, answered from how this site's service actually works.
const faqs = [
  { q: 'Is there a charge if you only inspect the device?', a: `No. Diagnosis and the visit or pickup are shown as ${price()} — you get an estimate before any work starts.` },
  { q: 'How long does a repair take?', a: 'Most phone and laptop repairs are done on the spot during a doorstep visit. Pickup repairs come back in 24–48 hours; board-level work can take longer and we tell you upfront.' },
  { q: 'Which devices can be repaired at my door?', a: 'Phones, tablets, laptops, desktops and printers can be done at your door or picked up. CCTV and networking are always installed on-site.' },
  { q: 'Is my data safe?', a: 'Your data stays on your device. We only access what the repair needs, and data recovery jobs are handled in our lab.' },
  { q: 'Which areas do you cover?', a: `Areas around our ${site.branches.length} branches — ${site.branches.join(', ')}. Check your area in the coverage section above.` },
];

const payload = JSON.stringify({
  categories: categories.map((c) => ({
    id: c.id,
    name: c.name,
    onsiteOnly: !!c.onsiteOnly,
    issues: c.issues,
    brands: c.brands.map((b) => ({ id: b.id, name: b.name, models: b.models })),
  })),
  coverage,
});
---

<Base title="Services" description="Doorstep repair and pickup & service for phones, laptops, desktops, printers, CCTV and networking. Coverage areas across Oman, all brands and models, OMR 0 estimates.">
  <script type="application/json" id="svc-data" set:html={payload} />

  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Services</span>
      <h1 class="h-xl" data-reveal style="--d:.06s">Doorstep repair, <span class="grad-text">or we pick it up.</span></h1>
      <p class="lead" data-reveal style="--d:.12s">
        Choose how you want the service done, check that we reach your area, then pick your device.
        {totals.categories} device types, {totals.brands} brands and {totals.models}+ models, every estimate {price()}.
      </p>
    </div>
  </section>

  <!-- ============ SERVICE MODE + COVERAGE ============ -->
  <section class="section tight" id="modes">
    <div class="wrap">
      <div class="step-head" data-reveal>
        <span class="step-no">1</span>
        <div><span class="eyebrow">Choose your service</span><h2 class="h-lg">How should we reach you?</h2></div>
      </div>

      <div class="mode-pick" role="radiogroup" aria-label="Service type">
        {serviceModes.map((m, i) => (
          <button type="button" role="radio" class="mode-card" data-mode={m.id} aria-checked={i === 0 ? 'true' : 'false'} data-reveal style={`--d:${i * .08}s`}>
            <span class="mode-radio" aria-hidden="true"></span>
            <span class="mc-top">
              <span class="mode-icon" aria-hidden="true">
                {m.id === 'doorstep' ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>
                )}
              </span>
              <span class="mc-titles">
                <span class="mode-title">{m.title}</span>
                <span class="mode-short">{m.short}</span>
              </span>
            </span>
            <span class="mc-eta">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {coverage[m.id].eta}
            </span>
            <ol class="mc-steps">
              {m.steps.map((st, n) => <li><b>{n + 1}</b><span>{st}</span></li>)}
            </ol>
            <span class="mc-for">
              <small>Works for</small>
              <span class="mc-icons">
                {categories.filter((c) => m.id === 'doorstep' || !c.onsiteOnly).map((c) => (
                  <span class="mc-ic" title={c.name} aria-label={c.name}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                ))}
              </span>
            </span>
            <span class="mc-foot">
              <span>Visit / pickup fee <span class="price-tag">{price()}</span></span>
              <span class="mc-choose"><span data-choose>{i === 0 ? 'Selected' : 'Choose'}</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </button>
        ))}
      </div>

      <div class="step-head sh2" data-reveal>
        <span class="step-no">2</span>
        <div><span class="eyebrow">Check your area</span><h2 class="h-lg">Where we cover · <span data-cov-title>Doorstep Service</span></h2></div>
      </div>

      <div class="coverage" data-reveal>
        <div class="cov-head">
          <p class="cov-eta" data-cov-eta>{coverage.doorstep.eta}</p>
          <label class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" placeholder="Type your area, e.g. Qurum" data-area-search autocomplete="off" aria-label="Search your area" />
          </label>
        </div>
        <p class="cov-result" data-cov-result aria-live="polite"></p>
        {serviceModes.map((m, i) => (
          <div class="zones" data-zones={m.id} hidden={i !== 0}>
            <div class="z-tabs" role="tablist" aria-label="Branch area">
              {coverage[m.id].zones.map((z, k) => (
                <button type="button" role="tab" class="z-tab" data-ztab={k} aria-selected={k === 0 ? 'true' : 'false'}>
                  <span class="z-dot" aria-hidden="true"></span>
                  <span><b>{z.name.replace(/ \(.*\)/, '')}</b><small>{z.areas.length} areas{/\((.*)\)/.test(z.name) ? ` · ${z.name.match(/\((.*)\)/)![1]}` : ''}</small></span>
                </button>
              ))}
            </div>
            <div class="z-panels">
              {coverage[m.id].zones.map((z, k) => (
                <div class="zone" data-zpanel={k} hidden={k !== 0} role="tabpanel">
                  <h3>{z.name}</h3>
                  <div class="areas">
                    {z.areas.map((a) => <button type="button" class="area" data-area={a}>{a}</button>)}
                  </div>
                </div>
              ))}
            </div>
            <div class="z-map">
              {coverage[m.id].zones.map((z, k) => (
                <iframe
                  data-zmap={k}
                  hidden={k !== 0}
                  title={`Map of ${z.name}`}
                  loading="lazy"
                  src={`https://www.openstreetmap.org/export/embed.html?bbox=${zoneGeo[k][1] - .09}%2C${zoneGeo[k][0] - .06}%2C${zoneGeo[k][1] + .09}%2C${zoneGeo[k][0] + .06}&layer=mapnik&marker=${zoneGeo[k][0]}%2C${zoneGeo[k][1]}`}
                ></iframe>
              ))}
            </div>
          </div>
        ))}
        <ul class="trust">
          <li><span>✓</span>Diagnosis before any work</li>
          <li><span>✓</span>Visit or pickup {price()}</li>
          <li><span>✓</span>Updates on WhatsApp</li>
          <li><span>✓</span>Not listed? Book anyway — we confirm</li>
        </ul>
      </div>
    </div>
  </section>
  <!-- ============ BOOKING WIZARD: device → brand & model → issue → estimate ============ -->
  <section class="section tight" id="catalog">
    <div class="wrap">
      <div class="cat-head">
        <div>
          <span class="eyebrow" data-reveal>Book a repair</span>
          <h2 class="h-lg" data-reveal style="--d:.06s">Get your estimate in 4 steps</h2>
        </div>
      </div>

      <div class="wz" data-wz data-reveal>
        <ol class="wz-steps" aria-label="Progress">
          {['Device', 'Brand & model', 'Service', 'Estimate'].map((t, i) => (
            <li class:list={['wz-step', { on: i === 0 }]} data-wz-dot={i + 1}><button type="button" data-wz-goto={i + 1}><b>{i + 1}<span class="wz-tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></b><span>{t}</span></button></li>
          ))}
          <span class="wz-rail" aria-hidden="true"><i data-wz-fill></i></span>
        </ol>

        <!-- 1 · device -->
        <div class="wz-panel on" data-wz-panel="1">
          <h3 class="wz-q">What needs fixing?</h3>
          <div class="wz-devs">
            {categories.map((c) => (
              <button type="button" class="wz-dev" data-wz-cat={c.id} style={`--h:${c.hue}`}>
                <span class="wz-di"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                <b>{c.name}</b>
                <small>{c.brands.length} brands · {c.issues.length} services</small>
              </button>
            ))}
          </div>
        </div>

        <!-- 2 · brand & model -->
        <div class="wz-panel" data-wz-panel="2" hidden>
          <h3 class="wz-q">Which <span data-wz-catname>device</span>?</h3>
          <div class="wz-bm">
            <div class="wz-brands">
              {categories.flatMap((c) => c.brands.map((b) => (
                <button type="button" class="wz-brand" data-wz-brand={b.id} data-wz-brand-cat={c.id} data-name={b.name} style={`--h:${b.hue}`} hidden>
                  <span class="wz-mono">{b.name[0]}</span><span><b>{b.name}</b><small>{b.models.length} {c.id === 'cctv' ? 'types' : 'models'}</small></span>
                </button>
              )))}
            </div>
            <div class="wz-models">
              <label class="wz-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input type="search" data-model-search placeholder="Search model, e.g. S24, LaserJet" autocomplete="off" aria-label="Search models" />
              </label>
              <p class="wz-mhint" data-wz-mhint>Pick a brand to see its models.</p>
              <ul class="wz-mlist" data-wz-mlist>
                {categories.flatMap((c) => c.brands.flatMap((b) => b.models.map((m) => (
                  <li hidden><button type="button" class="wz-model" data-model={m} data-model-brand={b.id} data-model-cat={c.id} data-q={`${b.name} ${m}`.toLowerCase()}><span>{m}<small>{b.name}</small></span><i aria-hidden="true">→</i></button></li>
                ))))}
              </ul>
              <button type="button" class="wz-skip" data-wz-skip>I don't know my model — skip →</button>
            </div>
          </div>
        </div>

        <!-- 3 · issue -->
        <div class="wz-panel" data-wz-panel="3" hidden>
          <h3 class="wz-q">What's the problem? <small>Choose one or more</small></h3>
          {categories.map((c) => (
            <div class="wz-issues" data-wz-issues={c.id} hidden>
              {c.issues.map((iss) => (
                <button type="button" class="wz-iss" data-iss={iss} aria-pressed="false" style={`--h:${c.hue}`}>
                  <span class="wz-ii" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${issueSvg(iss)}</svg>`} />
                  <span class="wz-in"><b>{iss}</b><small>{issueNote(iss)}</small></span>
                  <span class="wz-ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                </button>
              ))}
            </div>
          ))}
        </div>

        <!-- 4 · estimate -->
        <div class="wz-panel" data-wz-panel="4" hidden>
          <h3 class="wz-q">Your estimate</h3>
          <div class="wz-est">
            <div class="wz-sum">
              <div class="wz-dev-line"><span class="wz-di sm" data-wz-sumico></span><div><b data-wz-sumdev>—</b><small data-wz-summodel>—</small></div></div>
              <ul data-wz-sumlist></ul>
              <div class="wz-total"><span>Estimated cost</span><b>{price()}</b></div>
              <p class="wz-note">Pricing is confirmed by our technician after diagnosis, before any work starts.</p>
            </div>
            <div class="wz-time">
              <h4>Estimated completion</h4>
              <div class="wz-t"><span class="wz-ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span><div><b>Doorstep</b><small>{coverage.doorstep.eta}</small></div></div>
              <div class="wz-t" data-wz-pickup><span class="wz-ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg></span><div><b>Pickup &amp; service</b><small>{coverage.pickup.eta}</small></div></div>
              <p class="wz-onsite" data-wz-onsite hidden>This service is done on-site, so it is booked as a doorstep visit.</p>
              <div class="wz-acts">
                <button type="button" class="wz-add" data-wz-add>+ Add to cart</button>
                <a class="wz-now" data-wz-now href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Book service now</a>
              </div>
            </div>
          </div>
        </div>

        <div class="wz-foot">
          <button type="button" class="wz-back" data-wz-back hidden>← Back</button>
          <span class="wz-crumb" data-wz-crumb></span>
          <button type="button" class="wz-next" data-wz-next disabled>Continue →</button>
        </div>

        <div class="wz-cart" data-wz-cart hidden>
          <span class="wz-cico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11h10.2L20 7H6.2"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg><b data-wz-cn>0</b></span>
          <div class="wz-citems" data-wz-citems></div>
          <a class="wz-cgo" data-wz-cgo href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Book cart on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
  <!-- ============ BOOKING ============ -->
  <section class="section tight" id="book">
    <div class="wrap book">
      <form class="book-form glass" data-book novalidate>
        <span class="eyebrow">Book a repair</span>
        <h2 class="h-lg">Four quick steps</h2>

        <fieldset>
          <legend><span>1</span>Service type</legend>
          <div class="seg" role="radiogroup">
            {serviceModes.map((m, i) => (
              <label class="seg-radio"><input type="radio" name="mode" value={m.id} checked={i === 0} /><span>{m.title}</span></label>
            ))}
          </div>
          <p class="hint" data-onsite-hint hidden>This device is installed on-site, so it is booked as Doorstep Service.</p>
        </fieldset>

        <fieldset>
          <legend><span>2</span>Your area</legend>
          <select name="area" required data-f-area></select>
        </fieldset>

        <fieldset>
          <legend><span>3</span>Your device</legend>
          <select name="category" required data-f-cat>
            <option value="">Device type</option>
            {categories.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
          <div class="two">
            <select name="brand" required data-f-brand disabled><option value="">Brand</option></select>
            <select name="model" required data-f-model disabled><option value="">Model</option></select>
          </div>
        </fieldset>

        <fieldset>
          <legend><span>4</span>What do you need?</legend>
          <div class="issues" data-f-issues><p class="hint">Pick a device type first.</p></div>
        </fieldset>

        <div class="two">
          <input name="name" placeholder="Your name" required autocomplete="name" />
          <input name="phone" placeholder="Phone number" required inputmode="tel" autocomplete="tel" />
        </div>

        <p class="form-msg" data-form-msg aria-live="polite"></p>
        <button type="submit" class="btn btn-primary">Request {price()} estimate</button>
      </form>

      <aside class="summary glass" aria-label="Booking summary">
        <h3>Your booking</h3>
        <dl>
          <div><dt>Service</dt><dd data-s-mode>Doorstep Service</dd></div>
          <div><dt>Area</dt><dd data-s-area>—</dd></div>
          <div><dt>Device</dt><dd data-s-device>—</dd></div>
          <div><dt>Needs</dt><dd data-s-issues>—</dd></div>
        </dl>
        <ul class="bill">
          <li><span>Repair estimate</span><span class="price-tag">{price()}</span></li>
          <li><span>Visit / pickup</span><span class="price-tag">{price()}</span></li>
          <li class="total"><span>Total</span><span class="price-tag">{price()}</span></li>
        </ul>
        <p class="bill-note">Prices are not live yet — every amount is shown as {price()}.</p>
      </aside>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section tight" id="faq">
    <div class="wrap faq">
      <div>
        <span class="eyebrow" data-reveal>FAQ</span>
        <h2 class="h-lg" data-reveal style="--d:.06s">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0} data-reveal style={`--d:${i * .05}s`}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import { price, site } from '../data/site';

  type Cat = { id: string; name: string; onsiteOnly: boolean; issues: string[]; brands: { id: string; name: string; models: string[] }[] };
  type Data = {
    categories: Cat[];
    coverage: Record<string, { eta: string; zones: { name: string; areas: string[] }[] }>;
  };
  const data: Data = JSON.parse(document.getElementById('svc-data')!.textContent!);
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const titles: Record<string, string> = { doorstep: 'Doorstep Service', pickup: 'Pickup & Service' };
  const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);

  const form = $<HTMLFormElement>('[data-book]');
  const fArea = $<HTMLSelectElement>('[data-f-area]');
  const fCat = $<HTMLSelectElement>('[data-f-cat]');
  const fBrand = $<HTMLSelectElement>('[data-f-brand]');
  const fModel = $<HTMLSelectElement>('[data-f-model]');
  const fIssues = $('[data-f-issues]');
  const areaSearch = $<HTMLInputElement>('[data-area-search]');

  let mode = 'doorstep';
  const cat = () => data.categories.find((c) => c.id === fCat.value);

  // ---------- service mode + coverage ----------
  const fillAreas = () => {
    const keep = fArea.value;
    fArea.innerHTML = '<option value="">Select your area</option>' + data.coverage[mode].zones
      .map((z) => `<optgroup label="${esc(z.name)}">${z.areas.map((a) => `<option>${esc(a)}</option>`).join('')}</optgroup>`)
      .join('');
    fArea.value = data.coverage[mode].zones.some((z) => z.areas.includes(keep)) ? keep : '';
  };

  const filterAreas = () => {
    const q = norm(areaSearch.value);
    const panel = $(`[data-zones="${mode}"]`);
    let hits = 0;
    $$<HTMLButtonElement>('.area', panel).forEach((b) => {
      const match = !!q && norm(b.dataset.area!).includes(q);
      b.classList.toggle('hit', match);
      b.classList.toggle('dim', !!q && !match);
      if (match) hits++;
    });
    const out = $('[data-cov-result]');
    if (!q) out.textContent = '';
    else if (hits) out.innerHTML = `<b>Yes</b> — ${titles[mode]} reaches ${hits === 1 ? 'this area' : hits + ' matching areas'}.`;
    else {
      const other = mode === 'doorstep' ? 'pickup' : 'doorstep';
      const inOther = data.coverage[other].zones.some((z) => z.areas.some((a) => norm(a).includes(q)));
      out.innerHTML = inOther
        ? `Not on the ${titles[mode]} list, but <button type="button" class="linkish" data-switch="${other}">${titles[other]}</button> covers it.`
        : 'Not listed yet — book anyway and we will confirm.';
    }
  };

  // Branch tabs inside each mode's coverage
  const setZone = (box: HTMLElement, k: string) => {
    box.querySelectorAll<HTMLElement>('[data-ztab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.ztab === k)));
    box.querySelectorAll<HTMLElement>('[data-zpanel]').forEach((p) => (p.hidden = p.dataset.zpanel !== k));
    box.querySelectorAll<HTMLElement>('[data-zmap]').forEach((p) => (p.hidden = p.dataset.zmap !== k));
  };
  $$('[data-zones]').forEach((box) => box.querySelectorAll<HTMLElement>('[data-ztab]').forEach((t) => t.addEventListener('click', () => setZone(box, t.dataset.ztab!))));
  areaSearch.addEventListener('input', () => {
    const box = $(`[data-zones="${mode}"]`);
    const hit = box.querySelector<HTMLElement>('.area.hit');
    if (hit) setZone(box, hit.closest<HTMLElement>('[data-zpanel]')!.dataset.zpanel!);
  });

  const setMode = (m: string) => {
    if (!data.coverage[m]) return;
    // CCTV and networking are installed on-site: they can only be doorstep.
    if (m === 'pickup' && cat()?.onsiteOnly) m = 'doorstep';
    mode = m;
    $$('[data-mode]').forEach((c) => {
      c.setAttribute('aria-checked', String(c.dataset.mode === m));
      const ch = c.querySelector('[data-choose]');
      if (ch) ch.textContent = c.dataset.mode === m ? 'Selected' : 'Choose';
    });
    $$('[data-zones]').forEach((z) => (z.hidden = z.dataset.zones !== m));
    $('[data-cov-title]').textContent = titles[m];
    $('[data-cov-eta]').textContent = data.coverage[m].eta;
    $$<HTMLInputElement>('input[name="mode"]').forEach((r) => (r.checked = r.value === m));
    fillAreas();
    filterAreas();
    summary();
  };

  $$('[data-mode]').forEach((c) => c.addEventListener('click', () => setMode(c.dataset.mode!)));
  $$<HTMLInputElement>('input[name="mode"]').forEach((r) => r.addEventListener('change', () => setMode(r.value)));
  areaSearch.addEventListener('input', filterAreas);
  $('[data-cov-result]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-switch]');
    if (b) setMode(b.dataset.switch!);
  });
  $$<HTMLButtonElement>('.area').forEach((b) => b.addEventListener('click', () => {
    fArea.value = b.dataset.area!;
    summary();
    $$('.area').forEach((x) => x.classList.toggle('picked', x === b));
  }));

  // ---------- booking ----------
  const fillBrands = (keep = '') => {
    const c = cat();
    fBrand.disabled = !c;
    fBrand.innerHTML = '<option value="">Brand</option>' + (c?.brands.map((b) => `<option value="${b.id}">${esc(b.name)}</option>`).join('') ?? '');
    fBrand.value = keep;
    fIssues.innerHTML = c
      ? c.issues.map((iss) => `<label class="issue-chk"><input type="checkbox" name="issue" value="${esc(iss)}" /><span>${esc(iss)}</span></label>`).join('')
      : '<p class="hint">Pick a device type first.</p>';
    const onsite = !!c?.onsiteOnly;
    $<HTMLInputElement>('input[name="mode"][value="pickup"]').disabled = onsite;
    $('[data-onsite-hint]').hidden = !onsite;
    if (onsite && mode === 'pickup') setMode('doorstep');
  };
  const fillModels = (keep = '') => {
    const brand = cat()?.brands.find((b) => b.id === fBrand.value);
    fModel.disabled = !brand;
    fModel.innerHTML = '<option value="">Model</option>' + (brand?.models.map((m) => `<option>${esc(m)}</option>`).join('') ?? '');
    fModel.value = keep;
  };
  fCat.addEventListener('change', () => { fillBrands(); fillModels(); summary(); });
  fBrand.addEventListener('change', () => { fillModels(); summary(); });


  // ---------- booking wizard: 1 device → 2 brand & model → 3 issues → 4 estimate ----------
  const wz = $('[data-wz]');
  const wzState = { step: 1, cat: '', brand: '', model: '', issues: new Set<string>() };
  const wzCart: { cat: string; device: string; model: string; issues: string[] }[] = [];
  const tel = site.phone.tel.replace('+', '');
  const waUrl = (m: string) => `https://wa.me/${tel}?text=${encodeURIComponent(m)}`;
  const wzCat = () => data.categories.find((c) => c.id === wzState.cat);
  const wzSearch = $<HTMLInputElement>('[data-model-search]', wz);

  const canNext = () => (wzState.step === 1 ? !!wzState.cat : wzState.step === 2 ? true : wzState.step === 3 ? wzState.issues.size > 0 : false);
  const wzGo = (n: number) => {
    if (n > 1 && !wzState.cat) n = 1;
    if (n > 3 && !wzState.issues.size) n = 3;
    wzState.step = n;
    $$('[data-wz-panel]', wz).forEach((p) => { const on = p.dataset.wzPanel === String(n); p.hidden = !on; p.classList.toggle('on', on); });
    $$('[data-wz-dot]', wz).forEach((d) => { const k = Number(d.dataset.wzDot); d.classList.toggle('on', k === n); d.classList.toggle('done', k < n); });
    $('[data-wz-fill]', wz).style.width = `${((n - 1) / 3) * 100}%`;
    $('[data-wz-back]', wz).hidden = n === 1;
    const next = $<HTMLButtonElement>('[data-wz-next]', wz);
    next.hidden = n === 4;
    next.disabled = !canNext();
    next.textContent = n === 2 && !wzState.model ? 'Skip model →' : 'Continue →';
    const c = wzCat();
    $('[data-wz-crumb]', wz).textContent = [c?.name, wz.querySelector<HTMLElement>(`[data-wz-brand="${wzState.brand}"]`)?.dataset.name, wzState.model].filter(Boolean).join(' › ');
    if (n === 4) renderEstimate();
    if (wz.getBoundingClientRect().top < 0) wz.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // step 1
  const setWzCat = (id: string) => {
    if (wzState.cat !== id) { wzState.brand = ''; wzState.model = ''; wzState.issues.clear(); }
    wzState.cat = id;
    $$('[data-wz-cat]', wz).forEach((b) => b.classList.toggle('on', b.dataset.wzCat === id));
    const c = wzCat()!;
    $('[data-wz-catname]', wz).textContent = c.name.replace(/s( &.*)?$/, '').replace(/ Installation$/, ' system').toLowerCase();
    $$('[data-wz-brand]', wz).forEach((b) => { b.hidden = b.dataset.wzBrandCat !== id; b.classList.toggle('on', b.dataset.wzBrand === wzState.brand); });
    $$('[data-wz-issues]', wz).forEach((g) => (g.hidden = g.dataset.wzIssues !== id));
    $$<HTMLButtonElement>('.wz-iss', wz).forEach((b) => b.setAttribute('aria-pressed', 'false'));
    wzSearch.value = '';
    showWzModels();
  };
  $$('[data-wz-cat]', wz).forEach((b) => b.addEventListener('click', () => { setWzCat(b.dataset.wzCat!); wzGo(2); }));

  // step 2
  const showWzModels = () => {
    const q = norm(wzSearch.value);
    let n = 0;
    $$<HTMLElement>('.wz-model', wz).forEach((m) => {
      const ok = m.dataset.modelCat === wzState.cat && (q ? m.dataset.q!.includes(q) : !!wzState.brand && m.dataset.modelBrand === wzState.brand);
      m.parentElement!.hidden = !ok;
      m.classList.toggle('on', ok && m.dataset.model === wzState.model);
      if (ok) n++;
    });
    $('[data-wz-mhint]', wz).textContent = q ? (n ? `${n} match${n === 1 ? '' : 'es'}` : 'No match — try a shorter word, or skip.') : wzState.brand ? `${n} models` : 'Pick a brand to see its models.';
  };
  $$('[data-wz-brand]', wz).forEach((b) => b.addEventListener('click', () => {
    wzState.brand = b.dataset.wzBrand!; wzState.model = '';
    $$('[data-wz-brand]', wz).forEach((x) => x.classList.toggle('on', x === b));
    wzSearch.value = '';
    showWzModels(); wzGo(2);
  }));
  wzSearch.addEventListener('input', showWzModels);
  $$('.wz-model', wz).forEach((m) => m.addEventListener('click', () => {
    wzState.model = m.dataset.model!; wzState.brand = m.dataset.modelBrand!;
    $$('[data-wz-brand]', wz).forEach((x) => x.classList.toggle('on', x.dataset.wzBrand === wzState.brand));
    showWzModels(); wzGo(3);
  }));
  $('[data-wz-skip]', wz).addEventListener('click', () => { wzState.model = ''; wzGo(3); });

  // step 3
  $$<HTMLButtonElement>('.wz-iss', wz).forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.iss!;
    wzState.issues.has(v) ? wzState.issues.delete(v) : wzState.issues.add(v);
    b.setAttribute('aria-pressed', String(wzState.issues.has(v)));
    $<HTMLButtonElement>('[data-wz-next]', wz).disabled = !canNext();
  }));

  // step 4
  const brandName = () => wz.querySelector<HTMLElement>(`[data-wz-brand="${wzState.brand}"]`)?.dataset.name ?? '';
  const renderEstimate = () => {
    const c = wzCat()!;
    $('[data-wz-sumico]', wz).innerHTML = wz.querySelector(`[data-wz-cat="${c.id}"] .wz-di`)!.innerHTML;
    $('[data-wz-sumdev]', wz).textContent = c.name;
    $('[data-wz-summodel]', wz).textContent = [brandName(), wzState.model].filter(Boolean).join(' · ') || 'Model not specified';
    $('[data-wz-sumlist]', wz).innerHTML = [...wzState.issues].map((i) => `<li><span>${esc(i)}</span><b>${price()}</b></li>`).join('');
    $('[data-wz-pickup]', wz).hidden = c.onsiteOnly;
    $('[data-wz-onsite]', wz).hidden = !c.onsiteOnly;
    $<HTMLAnchorElement>('[data-wz-now]', wz).href = waUrl(`Hi Danat, I want to book:\n${lineFor(currentItem())}`);
  };
  const currentItem = () => ({ cat: wzState.cat, device: wzCat()!.name, model: [brandName(), wzState.model].filter(Boolean).join(' '), issues: [...wzState.issues] });
  const lineFor = (it: { device: string; model: string; issues: string[] }) => `• ${it.issues.join(', ')} — ${it.model || it.device}`;
  const renderWzCart = () => {
    const box = $('[data-wz-cart]', wz);
    box.hidden = !wzCart.length;
    $('[data-wz-cn]', wz).textContent = String(wzCart.length);
    $('[data-wz-citems]', wz).innerHTML = wzCart.map((it, i) => `<span class="wz-chip"><b>${esc(it.model || it.device)}</b>${esc(it.issues.join(', '))}<button type="button" data-wz-rm="${i}" aria-label="Remove">×</button></span>`).join('');
    $<HTMLAnchorElement>('[data-wz-cgo]', wz).href = waUrl(`Hi Danat, I want to book these repairs:\n${wzCart.map(lineFor).join('\n')}`);
  };
  $('[data-wz-add]', wz).addEventListener('click', () => {
    wzCart.push(currentItem());
    renderWzCart();
    // start again for the next device
    wzState.cat = ''; wzState.brand = ''; wzState.model = ''; wzState.issues.clear();
    $$('[data-wz-cat]', wz).forEach((b) => b.classList.remove('on'));
    $$<HTMLButtonElement>('.wz-iss', wz).forEach((b) => b.setAttribute('aria-pressed', 'false'));
    wzGo(1);
  });
  $('[data-wz-citems]', wz).addEventListener('click', (e) => {
    const r = (e.target as HTMLElement).closest<HTMLElement>('[data-wz-rm]');
    if (r) { wzCart.splice(Number(r.dataset.wzRm), 1); renderWzCart(); }
  });

  // footer + progress
  $('[data-wz-back]', wz).addEventListener('click', () => wzGo(wzState.step - 1));
  $('[data-wz-next]', wz).addEventListener('click', () => { if (canNext()) wzGo(wzState.step + 1); });
  $$('[data-wz-goto]', wz).forEach((b) => b.addEventListener('click', () => { const n = Number(b.dataset.wzGoto); if (n <= wzState.step || canNext()) wzGo(n); }));

  // deep links: ?cat=printer  ?q=Samsung (brand)  ?q=S24 (model search)
  function wzDeepLink(cat: string | null, q: string | null) {
    if (cat && data.categories.some((c) => c.id === cat)) { setWzCat(cat); wzGo(2); }
    if (!q) return;
    const nq = norm(q);
    const tile = $$('[data-wz-brand]', wz).find((b) => (!wzState.cat || b.dataset.wzBrandCat === wzState.cat) && norm(b.dataset.name!).startsWith(nq));
    if (tile) { setWzCat(tile.dataset.wzBrandCat!); tile.click(); return; }
    const m = $$('.wz-model', wz).find((x) => (!wzState.cat || x.dataset.modelCat === wzState.cat) && x.dataset.q!.includes(nq));
    if (m) { setWzCat(m.dataset.modelCat!); wzSearch.value = q; showWzModels(); wzGo(2); }
  }
  wzGo(1);

  function summary() {
    $('[data-s-mode]').textContent = titles[mode];
    $('[data-s-area]').textContent = fArea.value || '—';
    const c = cat();
    const brand = c?.brands.find((b) => b.id === fBrand.value);
    $('[data-s-device]').textContent = c ? [c.name, brand?.name, fModel.value].filter(Boolean).join(' · ') : '—';
    const iss = $$<HTMLInputElement>('input[name="issue"]:checked').map((i) => i.value);
    $('[data-s-issues]').textContent = iss.length ? iss.join(', ') : '—';
  }
  form.addEventListener('change', summary);

  // Cart → booking: device from the first item, tick every item of that device.
  document.addEventListener('cart:checkout', (e) => {
    const lines = (e as CustomEvent<{ cat: string; name: string }[]>).detail;
    if (!lines.length) return;
    fCat.value = lines[0].cat;
    fillBrands();
    fillModels();
    const names = new Set(lines.filter((l) => l.cat === lines[0].cat).map((l) => l.name));
    $$<HTMLInputElement>('input[name="issue"]').forEach((i) => (i.checked = names.has(i.value)));
    summary();
    $('#book').scrollIntoView({ behavior: 'smooth' });
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = $('[data-form-msg]');
    const fd = new FormData(form);
    const missing = ['area', 'category', 'brand', 'model', 'name', 'phone'].filter((k) => !String(fd.get(k) ?? '').trim());
    if (!fd.getAll('issue').length) missing.push('what you need');
    if (missing.length) {
      msg.className = 'form-msg err';
      msg.textContent = `Please add: ${missing.join(', ')}.`;
      return;
    }
    msg.className = 'form-msg ok';
    msg.textContent = `Thanks, ${fd.get('name')}. Your ${titles[mode].toLowerCase()} request for ${fd.get('model')} is noted — estimate ${price()}. (Demo: bookings are not sent anywhere yet.)`;
  });

  // Deep links from the home page and nav menu: ?mode=pickup, ?cat=printer, ?q=Samsung
  const q = new URLSearchParams(location.search);
  wzDeepLink(q.get('cat'), q.get('q'));
  const startMode = q.get('mode');
  setMode(startMode && data.coverage[startMode] ? startMode : 'doorstep');
  // ?area= from the home-page location search: pre-check coverage and pre-fill the booking
  // Links from the menu land on a section; re-scroll once the page has laid out.
  if (location.hash) requestAnimationFrame(() => document.querySelector(location.hash)?.scrollIntoView());
  const startArea = q.get('area');
  if (startArea) {
    areaSearch.value = startArea;
    filterAreas();
    if ([...fArea.options].some((o) => o.value === startArea)) { fArea.value = startArea; summary(); }
  }
</script>

<style>
  .cart-lead { margin: 12px 0 28px; }
  .faq { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 40px; align-items: start; }
  .faq h2 { margin-top: 14px; }
  .faq-list { display: grid; gap: 10px; }
  .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); }
  .faq-item summary { padding: 18px 20px; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--violet); font-size: 20px; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { padding: 0 20px 18px; color: var(--ink-2); }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } }
  .page-head { padding: clamp(48px, 8vw, 100px) 0 20px; }
  .page-head h1 { margin: 18px 0 20px; max-width: 16ch; }
  .section.tight { padding: clamp(48px, 7vw, 88px) 0; }


  /* step headings */
  .step-head { display: flex; align-items: center; gap: 18px; margin-bottom: 26px; }
  .step-head h2 { margin-top: 6px; font-size: clamp(28px, 3.4vw, 42px); }
  .sh2 { margin-top: 64px; }
  .step-no { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 16px; background: var(--grad); color: var(--on-accent); font-family: var(--display); font-size: 24px; font-weight: 800; flex: none; box-shadow: 0 14px 30px -14px rgba(var(--a1), .7); }

  /* mode cards */
  .mode-pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .mode-card {
    position: relative; display: flex; flex-direction: column; gap: 18px; text-align: left;
    padding: 28px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 26px; box-shadow: var(--shadow);
    transition: border-color .3s, box-shadow .3s, transform .3s;
  }
  .mode-card:hover { transform: translateY(-3px); }
  .mode-card[aria-checked='true'] { border-color: var(--violet); box-shadow: 0 26px 56px -28px rgba(var(--a1), .6); }
  .mode-card[aria-checked='true']::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(420px circle at 0% 0%, var(--accent-soft), transparent 60%); pointer-events: none; }
  .mode-card > * { position: relative; }
  .mode-card > .mode-radio { position: absolute; top: 26px; right: 26px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ink-3); transition: border-color .2s, box-shadow .2s; }
  [aria-checked='true'] > .mode-radio { border-color: var(--violet); box-shadow: inset 0 0 0 4px var(--surface), inset 0 0 0 12px var(--violet); }
  .mc-top { display: flex; align-items: center; gap: 16px; padding-right: 36px; }
  .mode-icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: var(--tint-2); flex: none; transition: background .3s, color .3s; }
  [aria-checked='true'] .mode-icon { background: var(--grad); color: var(--on-accent); }
  .mode-icon svg { width: 30px; height: 30px; }
  .mc-titles { display: grid; gap: 2px; }
  .mode-title { font-family: var(--display); font-size: 24px; font-weight: 800; }
  .mode-short { color: var(--ink-2); font-size: 15px; }
  .mc-eta { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--violet); font-size: 13px; font-weight: 700; }
  .mc-eta svg { width: 16px; height: 16px; }
  .mc-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); position: relative; }
  .mc-steps::before { content: ''; position: absolute; left: 16%; right: 16%; top: 15px; height: 2px; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 12px); }
  [aria-checked='true'] .mc-steps::before { background: repeating-linear-gradient(90deg, var(--violet) 0 6px, transparent 6px 12px); }
  .mc-steps li { position: relative; display: grid; justify-items: center; gap: 8px; text-align: center; font-size: 13px; color: var(--ink-2); line-height: 1.3; }
  .mc-steps b { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); font-size: 13px; color: var(--ink-2); }
  [aria-checked='true'] .mc-steps b { border-color: var(--violet); color: var(--violet); }
  .mc-for { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px dashed var(--line); }
  .mc-for small { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); flex: none; }
  .mc-icons { display: flex; flex-wrap: wrap; gap: 6px; }
  .mc-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--tint); color: var(--ink-2); }
  .mc-ic svg { width: 17px; height: 17px; }
  .mc-foot { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--ink-3); }
  .mc-choose { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--violet); }
  .mc-choose svg { width: 16px; height: 16px; transition: transform .2s; }
  .mode-card:hover .mc-choose svg { transform: translateX(3px); }
  @media (max-width: 820px) { .mode-pick { grid-template-columns: 1fr; } }

  /* coverage: branch tabs · areas · map */
  .coverage { padding: clamp(20px, 3vw, 30px); background: var(--surface); border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--shadow); }
  .cov-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cov-eta { color: var(--ink-2); font-weight: 600; }
  .cov-result { margin: 12px 0 0; color: var(--ink-2); font-size: 14px; }
  .cov-result:empty { display: none; }
  .cov-result :global(b) { color: var(--lime); }
  .cov-result :global(.linkish) { border: 0; background: none; padding: 0; color: var(--violet); text-decoration: underline; }
  .zones { display: grid; grid-template-columns: 230px minmax(0, 1fr) minmax(0, 1fr); gap: 22px; margin-top: 22px; animation: fadeUp .5s both; }
  .zones[hidden] { display: none; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } }
  .z-tabs { display: grid; gap: 8px; align-content: start; }
  .z-tab { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); text-align: left; transition: border-color .2s, background .2s; }
  .z-tab b { display: block; font-size: 15px; }
  .z-tab small { font-size: 12px; color: var(--ink-3); }
  .z-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--line); flex: none; transition: background .2s, box-shadow .2s; }
  .z-tab[aria-selected='true'] { border-color: var(--violet); background: var(--accent-soft); }
  .z-tab[aria-selected='true'] .z-dot { background: var(--violet); box-shadow: 0 0 0 4px rgba(var(--a1), .2); }
  .zone { animation: fadeUp .35s both; }
  .zone[hidden] { display: none; }
  .zone h3 { font-family: var(--body); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 12px; }
  .areas { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 14px; }
  .area { justify-self: stretch; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 0; border-radius: 10px; background: none; font-size: 14px; color: var(--ink-2); text-align: left; transition: background .15s, color .15s; }
  .area::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--line); flex: none; }
  .area:hover { background: var(--tint); color: var(--ink); }
  .area.hit { background: rgba(18, 161, 80, .1); color: var(--lime); font-weight: 700; }
  .area.hit::before { background: var(--lime); }
  .area.picked { background: var(--accent-soft); color: var(--violet); font-weight: 700; }
  .area.picked::before { background: var(--violet); }
  .area.dim { opacity: .35; }
  .z-map iframe { display: block; width: 100%; height: 100%; min-height: 300px; border: 0; border-radius: 18px; background: var(--tint); }
  .z-map iframe[hidden] { display: none; }
  .trust { list-style: none; margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .trust li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--ink-2); }
  .trust span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-soft); color: var(--violet); font-size: 12px; font-weight: 800; flex: none; }
  @media (max-width: 1000px) { .zones { grid-template-columns: 1fr; } .z-tabs { grid-template-columns: repeat(3, 1fr); } .trust { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .z-tabs { grid-template-columns: 1fr; } .trust { grid-template-columns: 1fr; } }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 48px;
    min-width: min(340px, 100%);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color .2s;
  }
  .search:focus-within { border-color: var(--violet); }
  .search svg { width: 18px; height: 18px; color: var(--ink-3); flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: var(--ink); font: inherit; }

  /* booking wizard */
  .cat-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 26px; }
  .cat-head h2 { margin-top: 14px; }
  .wz { background: var(--surface); border: 1px solid var(--line); border-radius: 28px; box-shadow: var(--shadow); overflow: hidden; }
  .wz-steps { position: relative; list-style: none; margin: 0; padding: 26px 40px 22px; display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); background: var(--tint); }
  .wz-rail { position: absolute; left: calc(40px + 12.5% - 0px); right: calc(40px + 12.5%); top: 45px; height: 3px; border-radius: 3px; background: var(--line); z-index: 0; }
  .wz-rail i { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--violet); transition: width .5s cubic-bezier(.2,.8,.2,1); }
  .wz-step { position: relative; z-index: 1; display: grid; justify-items: center; }
  .wz-step button { display: grid; justify-items: center; gap: 8px; border: 0; background: none; padding: 0; font-size: 13.5px; font-weight: 600; color: var(--ink-3); }
  .wz-step b { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); font-size: 15px; color: var(--ink-3); transition: all .3s; }
  .wz-tick { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; }
  .wz-tick svg { width: 18px; height: 18px; }
  .wz-step.on b { border-color: var(--violet); color: var(--violet); box-shadow: 0 0 0 5px rgba(var(--a1), .15); }
  .wz-step.on button { color: var(--ink); }
  .wz-step.done b { background: var(--violet); border-color: var(--violet); color: transparent; }
  .wz-step.done .wz-tick { opacity: 1; color: var(--on-accent); }
  .wz-step.done button { color: var(--ink-2); }

  .wz-panel { padding: 28px 32px; min-height: 380px; animation: wzIn .4s cubic-bezier(.2,.8,.2,1); }
  .wz-panel[hidden] { display: none; }
  @keyframes wzIn { from { opacity: 0; transform: translateX(16px); } }
  .wz-q { font-size: 22px; margin-bottom: 18px; }
  .wz-q small { font-size: 14px; font-weight: 500; color: var(--ink-3); margin-left: 6px; }

  .wz-devs { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .wz-dev { display: grid; justify-items: center; gap: 8px; padding: 22px 14px; border: 1.5px solid var(--line); border-radius: 20px; background: var(--surface); text-align: center; transition: transform .25s, border-color .25s, box-shadow .25s; }
  .wz-dev:hover { transform: translateY(-4px); border-color: hsl(var(--h) 60% 50% / .5); box-shadow: 0 18px 30px -20px rgba(0,0,0,.35); }
  .wz-dev.on { border-color: var(--violet); background: var(--accent-soft); }
  .wz-di { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); }
  .wz-di svg { width: 30px; height: 30px; }
  .wz-di.sm { width: 46px; height: 46px; border-radius: 14px; background: var(--accent-soft); color: var(--violet); }
  .wz-di.sm :global(svg) { width: 24px; height: 24px; }
  .wz-dev b { font-size: 15px; }
  .wz-dev small { font-size: 12.5px; color: var(--ink-3); }

  .wz-bm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; }
  .wz-brands { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; align-content: start; }
  .wz-brand { display: flex; align-items: center; gap: 10px; padding: 12px; border: 1.5px solid var(--line); border-radius: 16px; background: var(--surface); text-align: left; transition: border-color .2s, transform .2s; }
  .wz-brand:hover { transform: translateY(-2px); }
  .wz-brand.on { border-color: var(--violet); background: var(--accent-soft); }
  .wz-brand b { display: block; font-size: 14px; line-height: 1.2; }
  .wz-brand small { font-size: 12px; color: var(--ink-3); }
  .wz-mono { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); font-weight: 800; flex: none; }
  .wz-models { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 14px; border-radius: 20px; background: var(--tint); }
  .wz-search { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .wz-search:focus-within { border-color: var(--violet); }
  .wz-search svg { width: 18px; height: 18px; color: var(--ink-3); }
  .wz-search input { flex: 1; min-width: 0; border: 0; outline: none; background: none; font: inherit; color: var(--ink); }
  .wz-mhint { font-size: 12.5px; color: var(--ink-3); padding: 0 4px; }
  .wz-mlist { list-style: none; margin: 0; padding: 0; max-height: 300px; overflow-y: auto; display: grid; gap: 4px; }
  .wz-mlist li[hidden] { display: none; }
  .wz-model { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 0; border-radius: 10px; background: var(--surface); text-align: left; transition: background .15s; }
  .wz-model span { font-weight: 600; font-size: 14px; }
  .wz-model small { display: block; font-weight: 500; font-size: 12px; color: var(--ink-3); }
  .wz-model i { font-style: normal; color: var(--violet); opacity: 0; transition: opacity .15s, transform .15s; }
  .wz-model:hover i, .wz-model.on i { opacity: 1; transform: translateX(2px); }
  .wz-model.on { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--violet); }
  .wz-skip { align-self: flex-start; border: 0; background: none; padding: 4px; font-size: 13px; font-weight: 700; color: var(--violet); }

  .wz-issues { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
  .wz-issues[hidden] { display: none; }
  .wz-iss { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1.5px solid var(--line); border-radius: 18px; background: var(--surface); text-align: left; transition: border-color .2s, background .2s, transform .2s; }
  .wz-iss:hover { transform: translateY(-2px); }
  .wz-iss[aria-pressed='true'] { border-color: var(--violet); background: var(--accent-soft); }
  .wz-ii { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); flex: none; }
  .wz-ii :global(svg) { width: 22px; height: 22px; }
  .wz-in { flex: 1; min-width: 0; }
  .wz-in b { display: block; font-size: 14.5px; }
  .wz-in small { font-size: 12.5px; color: var(--ink-3); }
  .wz-ck { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--line); color: transparent; flex: none; transition: all .2s; }
  .wz-ck svg { width: 13px; height: 13px; }
  .wz-iss[aria-pressed='true'] .wz-ck { background: var(--violet); border-color: var(--violet); color: var(--on-accent); }

  .wz-est { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 20px; }
  .wz-sum, .wz-time { padding: 22px; border: 1px solid var(--line); border-radius: 20px; }
  .wz-dev-line { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .wz-dev-line b { display: block; font-size: 16px; }
  .wz-dev-line small { font-size: 13px; color: var(--ink-3); }
  .wz-sum ul { list-style: none; margin: 12px 0; padding: 0; display: grid; gap: 8px; }
  .wz-sum ul :global(li) { display: flex; justify-content: space-between; font-size: 14.5px; }
  .wz-sum ul :global(b) { color: var(--lime); }
  .wz-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 12px; border-top: 1px dashed var(--line); font-weight: 700; }
  .wz-total b { font-family: var(--display); font-size: 30px; color: var(--lime); }
  .wz-note { margin-top: 10px; font-size: 12.5px; color: var(--ink-3); }
  .wz-time h4 { font-size: 16px; margin-bottom: 12px; }
  .wz-t { display: flex; align-items: center; gap: 12px; padding: 10px 0; }
  .wz-t[hidden] { display: none; }
  .wz-t b { display: block; font-size: 14.5px; }
  .wz-t small { font-size: 13px; color: var(--ink-2); }
  .wz-ti { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--accent-soft); color: var(--violet); flex: none; }
  .wz-ti svg { width: 20px; height: 20px; }
  .wz-onsite { font-size: 12.5px; color: var(--ink-3); }
  .wz-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .wz-add, .wz-now { display: flex; align-items: center; justify-content: center; gap: 8px; height: 52px; border-radius: 14px; font-weight: 700; font-size: 14.5px; transition: transform .2s; }
  .wz-add { border: 1.5px solid var(--violet); background: var(--surface); color: var(--violet); }
  .wz-now { background: #25d366; color: #fff; box-shadow: 0 12px 24px -12px rgba(37,211,102,.9); }
  .wz-now svg { width: 20px; height: 20px; }
  .wz-add:hover, .wz-now:hover { transform: translateY(-2px); }

  .wz-foot { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 16px 32px; border-top: 1px solid var(--line); }
  .wz-back { justify-self: start; border: 1px solid var(--line); background: var(--surface); padding: 11px 18px; border-radius: 999px; font-weight: 700; font-size: 14px; color: var(--ink-2); }
  .wz-back[hidden] { visibility: hidden; display: block; }
  .wz-crumb { justify-self: center; font-size: 13.5px; font-weight: 600; color: var(--ink-3); text-align: center; }
  .wz-next { justify-self: end; border: 0; background: var(--violet); color: var(--on-accent); padding: 12px 24px; border-radius: 999px; font-weight: 700; font-size: 14.5px; transition: opacity .2s; }
  .wz-next:disabled { opacity: .4; cursor: not-allowed; }
  .wz-next[hidden] { visibility: hidden; display: block; }

  .wz-cart { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 14px 32px; border-top: 1px solid var(--line); background: var(--accent-soft); }
  .wz-cart[hidden] { display: none; }
  .wz-cico { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--surface); color: var(--violet); }
  .wz-cico svg { width: 21px; height: 21px; }
  .wz-cico b { position: absolute; right: -6px; top: -6px; display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--violet); color: var(--on-accent); font-size: 11px; }
  .wz-citems { display: flex; gap: 8px; overflow-x: auto; }
  .wz-citems :global(.wz-chip) { display: inline-flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 12.5px; color: var(--ink-2); white-space: nowrap; }
  .wz-citems :global(.wz-chip b) { color: var(--ink); }
  .wz-citems :global(.wz-chip button) { width: 20px; height: 20px; border: 0; border-radius: 50%; background: var(--tint-2); line-height: 1; }
  .wz-cgo { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 999px; background: #25d366; color: #fff; font-weight: 700; font-size: 14px; white-space: nowrap; }
  .wz-cgo svg { width: 18px; height: 18px; }

  @media (max-width: 900px) {
    .wz-steps { padding: 20px 12px 16px; }
    .wz-rail { left: 12.5%; right: 12.5%; top: 39px; }
    .wz-step button span:last-child { font-size: 11.5px; }
    .wz-panel { padding: 22px 18px; }
    .wz-bm, .wz-est { grid-template-columns: 1fr; }
    .wz-foot, .wz-cart { padding: 14px 18px; }
    .wz-cart { grid-template-columns: auto 1fr; }
    .wz-cgo { grid-column: 1 / -1; justify-content: center; }
    .wz-crumb { display: none; }
  }

  /* booking */
  .book { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .book-form { padding: clamp(22px, 3vw, 36px); display: grid; gap: 22px; }
  .book-form h2 { margin-top: -8px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; min-width: 0; }
  legend { display: flex; align-items: center; gap: 10px; font-weight: 600; margin-bottom: 10px; }
  legend span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--grad); color: var(--on-accent); font-size: 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  select, .book-form input:not([type='radio']):not([type='checkbox']) {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    outline: none;
  }
  select:focus, .book-form input:focus { border-color: var(--violet); }
  select:disabled { opacity: .5; }
  .hint { font-size: 13px; color: var(--ink-3); }
  .seg-radio { position: relative; }
  .seg-radio input { position: absolute; opacity: 0; }
  .seg-radio span { display: block; padding: 9px 16px; border-radius: 999px; font-size: 14px; color: var(--ink-2); cursor: pointer; }
  .seg-radio input:checked + span { background: var(--ink); color: var(--bg); }
  .seg-radio input:disabled + span { opacity: .4; cursor: not-allowed; text-decoration: line-through; }
  .seg-radio input:focus-visible + span { outline: 2px solid var(--violet); }
  .issues { display: flex; flex-wrap: wrap; gap: 8px; }
  .issues :global(.issue-chk) { position: relative; }
  .issues :global(.issue-chk input) { position: absolute; opacity: 0; }
  .issues :global(.issue-chk span) { display: block; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: 14px; color: var(--ink-2); cursor: pointer; transition: all .2s; }
  .issues :global(.issue-chk input:checked + span) { background: rgba(var(--a1), .1); border-color: var(--violet); color: var(--ink); }
  .issues :global(.issue-chk input:focus-visible + span) { outline: 2px solid var(--violet); }
  .form-msg { font-size: 14px; }
  .form-msg.err { color: #be123c; }
  .form-msg.ok { color: var(--lime); }
  .book-form .btn { justify-self: start; }

  .summary { padding: 28px; position: sticky; top: 100px; }
  .summary h3 { font-size: 20px; margin-bottom: 16px; }
  dl { margin: 0; display: grid; gap: 12px; }
  dl div { display: grid; grid-template-columns: 80px 1fr; gap: 10px; font-size: 14px; }
  dt { color: var(--ink-3); }
  dd { margin: 0; }
  .bill { list-style: none; padding: 16px 0 0; margin: 20px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; }
  .bill li { display: flex; justify-content: space-between; color: var(--ink-2); }
  .bill .total { padding-top: 10px; border-top: 1px dashed var(--line); color: var(--ink); font-weight: 600; font-size: 18px; }
  .bill .total .price-tag { font-size: 26px; }
  .bill-note { margin-top: 14px; font-size: 12px; color: var(--ink-3); }
  @media (max-width: 900px) {
    .book { grid-template-columns: 1fr; }
    .summary { position: static; }
  }
  @media (max-width: 480px) { .two { grid-template-columns: 1fr; } }

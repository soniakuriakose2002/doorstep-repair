---
import '../styles/global.css';
import { site, nav, price } from '../data/site';
import MegaMenu from '../components/MegaMenu.astro';
import Popups from '../components/Popups.astro';
import Engage from '../components/Engage.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.tagline} — screens, batteries and more for every major phone brand.` } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Services mega menu. Every link lands on the Services page — the site stays three pages.
---

<!doctype html>
<html lang="en" data-theme="danat" data-menu="1" data-reviews="1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jakarta.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const ok = ['danat', 'green', 'blue', 'red', 'teal', 'yellow', 'orange', 'slate'];
        let t = new URLSearchParams(location.search).get('theme');
        try { if (t && ok.includes(t)) localStorage.setItem('theme', t); else t = localStorage.getItem('theme'); } catch {}
        if (t === 'green') delete document.documentElement.dataset.theme;
        else if (t && ok.includes(t)) document.documentElement.dataset.theme = t;
        // Menu style 1–6 (client comparison): ?menu=N, remembered
        let m = new URLSearchParams(location.search).get('menu');
        try { if (m && /^[1-6]$/.test(m)) localStorage.setItem('menu', m); else m = localStorage.getItem('menu'); } catch {}
        if (m && /^[1-6]$/.test(m)) document.documentElement.dataset.menu = m;
        let rv = new URLSearchParams(location.search).get('reviews');
        try { if (rv && /^[1-4]$/.test(rv)) localStorage.setItem('reviews', rv); else rv = localStorage.getItem('reviews'); } catch {}
        if (rv && /^[1-4]$/.test(rv)) document.documentElement.dataset.reviews = rv;
      })();
    </script>
  </head>
  <body>
    <Popups />
    <Engage />
    <div class="aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="grid"></span>
    </div>

    <header class="nav">
      <div class="wrap nav-inner glass">
        <a href="/" class="logo">
          <picture class="logo-img">
            <source srcset="/brand/danat-logo.webp" type="image/webp" />
            <img src="/brand/danat-logo.png" alt="" width="40" height="40" />
          </picture>
          {site.name}
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => n.href === '/services' ? (
              <li class="has-mega">
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined} aria-haspopup="true">
                  {n.label}
                  <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </a>
                <div class="mega"><MegaMenu /></div>
              </li>
            ) : (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/services#catalog" class="nav-search" aria-label="Search devices and models"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a>
        <a href="/services#book" class="btn btn-primary nav-cta">Book a repair</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <a href="/" class="logo">{site.name}</a>
          <p class="muted">{site.tagline}. Doorstep repair and pickup across {site.country} since {site.since} — branches in {site.branches.join(', ')}.</p>
          <ul class="contact">
            <li><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>{site.address}</li>
          </ul>
        </div>
        <ul class="footer-nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="wrap footer-base">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>All estimates shown as {price()} — pricing to be announced.</span>
      </div>
    </footer>

    <div class="theme-pick" data-theme-pick>
      <button type="button" class="theme-toggle" aria-expanded="false" aria-label="Change colour theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.6 0-.5-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4.1-4-7.6-9-7.6z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10.5" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/></svg>
        Theme
      </button>
      <div class="theme-menu" role="group" aria-label="Colour theme" hidden>
        {[
          ['danat', 'Danat', '#2e8b46', '#f4f6f2'],
          ['green', 'Green', '#2fd07f', '#07120e'],
          ['blue', 'Blue', '#1d4ed8', '#f4f7fc'],
          ['red', 'Red', '#e11d2e', '#faf7f7'],
          ['teal', 'Teal', '#0d9488', '#f2f8f7'],
          ['yellow', 'Yellow', '#f5b400', '#17171a'],
          ['orange', 'Orange', '#ff5a1f', '#f7f4ee'],
          ['slate', 'Slate', '#2f6bff', '#e6eaf0'],
        ].map(([id, label, a, b]) => (
          <button type="button" data-theme-id={id} aria-pressed="false">
            <span class="sw" style={`--a:${a};--b:${b}`}></span>{label}
          </button>
        ))}
        <div class="menu-group">
          <p>Menu style</p>
          <div class="mnums">{[1, 2, 3, 4, 5, 6].map((n) => <button type="button" data-menu-id={String(n)} aria-pressed="false">{n}</button>)}</div>
        </div>
        <div class="menu-group">
          <p>Offer popup</p>
          <div class="mnums three"><button type="button" data-offer-id="slot" aria-pressed="false">Slot</button><button type="button" data-offer-id="spin" aria-pressed="false">Spin</button><button type="button" data-offer-id="flash" aria-pressed="false">Flash</button></div>
        </div>
        <div class="menu-group">
          <p>Reviews style</p>
          <div class="mnums">{[1, 2, 3, 4].map((n) => <button type="button" data-reviews-id={String(n)} aria-pressed="false">{n}</button>)}</div>
        </div>
      </div>
    </div>

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Services menu. Opens on hover, but not when a page loads with the
      // pointer already over it (arms after the pointer has been outside once);
      // closes on click. Inside the visible style, hovering a device ([data-d])
      // swaps the matching panels ([data-dp]) after a short hover intent.
      const megaLi = document.querySelector<HTMLElement>('.has-mega');
      if (megaLi) {
        let t = 0;
        let armed = false;
        const close = () => { clearTimeout(t); megaLi.classList.remove('open'); };
        document.addEventListener('pointermove', (e) => { if (!megaLi.contains(e.target as Node)) armed = true; }, { passive: true });
        megaLi.addEventListener('pointerenter', () => { if (!armed) return; clearTimeout(t); t = window.setTimeout(() => megaLi.classList.add('open'), 60); });
        megaLi.addEventListener('pointerleave', () => { clearTimeout(t); t = window.setTimeout(close, 160); });
        megaLi.addEventListener('focusin', () => megaLi.classList.add('open'));
        megaLi.addEventListener('focusout', (e) => { if (!megaLi.contains(e.relatedTarget as Node)) close(); });
        megaLi.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        megaLi.querySelectorAll<HTMLElement>('[data-mv]').forEach((mv) => {
          const items = mv.querySelectorAll<HTMLElement>('[data-d]');
          const show = (id: string) => {
            items.forEach((x) => x.classList.toggle('on', x.dataset.d === id));
            mv.querySelectorAll<HTMLElement>('[data-dp]').forEach((x) => x.classList.toggle('on', x.dataset.dp === id));
          };
          let dt = 0;
          items.forEach((x) => {
            x.addEventListener('pointerenter', () => { clearTimeout(dt); dt = window.setTimeout(() => { if (x.matches(':hover')) show(x.dataset.d!); }, 90); });
            x.addEventListener('pointerleave', () => clearTimeout(dt));
            x.addEventListener('focus', () => show(x.dataset.d!));
          });
        });
        megaLi.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => {
          close();
          armed = false;
          (document.activeElement as HTMLElement | null)?.blur();
        }));
      }

      // Theme switcher
      const pick = document.querySelector<HTMLElement>('[data-theme-pick]')!;
      const menu = pick.querySelector<HTMLElement>('.theme-menu')!;
      const toggle = pick.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const current = () => document.documentElement.dataset.theme ?? 'green';
      const mark = () => menu.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.themeId === current())));
      mark();
      const markMenu = () => menu.querySelectorAll<HTMLButtonElement>('[data-menu-id]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.menuId === (document.documentElement.dataset.menu ?? '1')))) ||
        menu.querySelectorAll<HTMLButtonElement>('[data-reviews-id]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.reviewsId === (document.documentElement.dataset.reviews ?? '1')))) ||
        menu.querySelectorAll<HTMLButtonElement>('[data-offer-id]').forEach((b) => {
          let t = 'slot'; try { const v = localStorage.getItem('welcome-popup'); if (v === 'spin' || v === 'flash') t = v; } catch {}
          b.setAttribute('aria-pressed', String(b.dataset.offerId === t));
        });
      markMenu();
      toggle.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        toggle.setAttribute('aria-expanded', String(!menu.hidden));
      });
      menu.addEventListener('click', (e) => {
        const ob = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-offer-id]');
        if (ob) {
          try { localStorage.setItem('welcome-popup', ob.dataset.offerId!); } catch {}
          markMenu();
          (window as any).__openOffer?.();
          return;
        }
        const rb = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-reviews-id]');
        if (rb) {
          document.documentElement.dataset.reviews = rb.dataset.reviewsId!;
          try { localStorage.setItem('reviews', rb.dataset.reviewsId!); } catch {}
          const u = new URL(location.href);
          u.searchParams.set('reviews', rb.dataset.reviewsId!);
          history.replaceState(null, '', u);
          markMenu();
          return;
        }
        const mb = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-menu-id]');
        if (mb) {
          document.documentElement.dataset.menu = mb.dataset.menuId!;
          try { localStorage.setItem('menu', mb.dataset.menuId!); } catch {}
          const u = new URL(location.href);
          u.searchParams.set('menu', mb.dataset.menuId!);
          history.replaceState(null, '', u);
          markMenu();
          return;
        }
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-id]');
        if (!b) return;
        const t = b.dataset.themeId!;
        if (t === 'green') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch {}
        const u = new URL(location.href);
        u.searchParams.set('theme', t);
        history.replaceState(null, '', u);
        mark();
      });
    </script>
  </body>
</html>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .35;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .o1 { width: 40vw; height: 40vw; right: -8vw; top: -12vw; background: var(--glow); }
  @keyframes drift {
    to { transform: translate3d(6vw, 4vh, 0) scale(1.12); }
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(15, 27, 45, .09) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 70%);
  }

  /* Default green theme: engineering grid like the hero mockup */
  :global(:root:not([data-theme])) .grid {
    background-image:
      linear-gradient(rgba(47, 208, 127, .06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 208, 127, .06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(#000, transparent 85%);
  }
  :global(:root:not([data-theme])) .nav-inner { background: rgba(13, 28, 23, .85); border-color: rgba(255,255,255,.08); backdrop-filter: blur(12px); }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    transition: padding .3s;
  }
  .nav.scrolled { padding: 8px 0; }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 10px 10px 10px 20px;
    border-radius: 999px;
    background: var(--surface);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -.02em;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--grad);
    color: var(--on-accent);
  }
  .logo-mark svg { width: 22px; height: 22px; }
  .logo-img img { display: block; width: 40px; height: 40px; border-radius: 10px; background: #fff; object-fit: contain; }
  .contact { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 6px; font-size: 14px; color: rgba(255,255,255,.75); }
  .contact a:hover { color: #fff; text-decoration: underline; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink-2);
    transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--violet); background: var(--accent-soft); font-weight: 600; }
  .nav-cta { padding: 11px 20px; }

  @media (max-width: 720px) {
    .nav-inner { flex-wrap: wrap; border-radius: 22px; gap: 8px; padding: 10px 12px; }
    nav { order: 3; width: 100%; margin: 0; }
    nav ul { justify-content: space-between; }
    nav a { padding: 8px 10px; font-size: 14px; }
    .nav-cta { margin-left: auto; padding: 9px 14px; font-size: 14px; }
  }

  .footer { margin-top: 40px; background: var(--navy); color: #fff; border-radius: 32px 32px 0 0; }
  .footer .logo { color: #fff; }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: 48px 0 32px;
  }
  .muted { color: rgba(255,255,255,.6); margin-top: 10px; max-width: 42ch; }
  .footer-nav { list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; color: rgba(255,255,255,.75); }
  .footer-nav a:hover { color: var(--violet); }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 0 32px;
    font-size: 13px;
    color: rgba(255,255,255,.5);
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .theme-pick { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 16px; border-radius: 999px; border: 0;
    background: var(--ink); color: var(--bg); font-weight: 600; font-size: 14px;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, .45);
  }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-menu {
    order: -1; display: grid; gap: 4px; padding: 8px; min-width: 170px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow);
  }
  .theme-menu button {
    display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 0; border-radius: 10px;
    background: none; font-size: 14px; font-weight: 500; color: var(--ink-2); text-align: left;
  }
  .theme-menu button:hover { background: var(--tint-2); color: var(--ink); }
  .theme-menu button[aria-pressed='true'] { background: var(--accent-soft); color: var(--ink); font-weight: 700; }
  .sw { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  /* Services mega menu — six styles live in MegaMenu.astro; this is the shell */
  .nav-inner { position: relative; }
  .has-mega > a { display: inline-flex; align-items: center; gap: 4px; }
  .caret { width: 14px; height: 14px; transition: transform .25s; }
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 12px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 30px 70px -30px rgba(15, 27, 45, .38), var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .2s, transform .25s cubic-bezier(.2,.8,.2,1), visibility 0s .25s;
    z-index: 70;
    text-align: left;
  }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
  .has-mega.open .mega { opacity: 1; visibility: visible; transform: none; transition: opacity .2s, transform .25s cubic-bezier(.2,.8,.2,1); }
  .has-mega.open .caret { transform: rotate(180deg); }
  .nav-search { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink-2); flex: none; transition: color .15s, border-color .15s; }
  .nav-search:hover { color: var(--violet); border-color: var(--violet); }
  .nav-search svg { width: 18px; height: 18px; }
  .menu-group { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 8px; }
  .menu-group p { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); padding: 0 10px 6px; }
  .menu-group .mnums { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; padding: 0 6px; }
  .menu-group .mnums.two { grid-template-columns: 1fr 1fr; }
  .menu-group .mnums.three { grid-template-columns: repeat(3, 1fr); }
  .theme-menu .mnums button { justify-content: center; padding: 7px 0; font-weight: 700; }
  @media (max-width: 1100px) { .mega { display: none; } .caret { display: none; } }
</style>

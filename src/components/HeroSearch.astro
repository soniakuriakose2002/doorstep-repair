---
// Hero actions: "What are you looking for?" search, Find my location (browser
// geolocation → nearest covered area + branch, computed on the device), and
// Track your repair (sends the reference to Danat on WhatsApp — there is no
// booking system yet, so no status is shown that we cannot know).
import { site } from '../data/site';
import { coverage } from '../data/coverage';
import { categories } from '../data/devices';

const doorstep = coverage.doorstep.zones.flatMap((z) => z.areas);
const pickup = coverage.pickup.zones.flatMap((z) => z.areas);

// APPROXIMATE centre points for the coverage areas (town/district level), used
// only to find the nearest one to the visitor. Not addresses.
const areaGeo: Record<string, [number, number]> = {
  Ruwi: [23.593, 58.545], Muttrah: [23.617, 58.567], 'Wadi Kabir': [23.573, 58.578], Darsait: [23.607, 58.555],
  'Al Wattayah': [23.595, 58.498], Qurum: [23.605, 58.478], 'Al Khuwair': [23.593, 58.426], 'Madinat Sultan Qaboos': [23.588, 58.448],
  'Al Ghubrah': [23.585, 58.395], Bausher: [23.555, 58.395], 'Al Azaiba': [23.583, 58.362], 'Al Hail': [23.645, 58.285],
  'Al Mawaleh': [23.628, 58.25], 'Al Khoudh': [23.61, 58.18], Seeb: [23.67, 58.19], Mabellah: [23.63, 58.13],
  'Al Amerat': [23.52, 58.49], Qurayyat: [23.26, 58.92],
  Sohar: [24.347, 56.709], 'Falaj Al Qabail': [24.4, 56.63], 'Al Hambar': [24.33, 56.73], Liwa: [24.53, 56.57],
  Shinas: [24.74, 56.47], Saham: [24.17, 56.89], 'Al Khaburah': [23.97, 57.1], Barka: [23.68, 57.89], 'Al Suwaiq': [23.85, 57.44],
  Salalah: [17.019, 54.089], 'Al Saada': [17.05, 54.13], 'Al Dahariz': [17.03, 54.14], Awqad: [17.03, 54.06],
  Taqah: [17.04, 54.4], Mirbat: [16.99, 54.69], Raysut: [16.95, 53.99],
};
const branchGeo = [
  { name: 'Ruwi (Muscat)', at: [23.593, 58.556] },
  { name: 'Sohar', at: [24.347, 56.709] },
  { name: 'Salalah', at: [17.019, 54.089] },
];

const suggestions = [
  ...categories.map((c) => c.name),
  ...new Set(categories.flatMap((c) => c.brands.map((b) => b.name))),
  ...categories.flatMap((c) => c.brands.flatMap((b) => b.models)),
];
const popular = [
  { label: 'Laptop Repair', href: '/services?cat=laptop#catalog' },
  { label: 'iPhone Repair', href: '/services?cat=mobile&q=iPhone#catalog' },
  { label: 'Printer Repair', href: '/services?cat=printer#catalog' },
  { label: 'CCTV Installation', href: '/services?cat=cctv#catalog' },
  { label: 'Data Recovery', href: '/services?cat=data#catalog' },
];
const catIndex = categories.map((c) => ({ id: c.id, words: [c.name, c.short, ...c.name.split(/[\s&]+/)].map((w) => w.toLowerCase()) }));
const tel = site.phone.tel.replace('+', '');
const waIcon = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>';
---

<div class="hs" data-hs data-tel={tel} data-cats={JSON.stringify(catIndex)} data-geo={JSON.stringify({ areaGeo, branchGeo, doorstep, pickup })}>
  <form class="hs-row" data-hs-find>
    <label class="hs-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input name="q" list="hs-things" placeholder="What are you looking for?" autocomplete="off" aria-label="What are you looking for" />
    </label>
    <button type="submit" class="hs-btn hs-icon" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </button>
  </form>
  <datalist id="hs-things">{suggestions.map((s) => <option value={s} />)}</datalist>

  <div class="hs-actions">
    <button type="button" class="hs-act" data-hs-locate>
      <span class="hs-ai"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
      <span><b>Find my location</b><small>Check if we cover your area</small></span>
    </button>
    <button type="button" class="hs-act" data-hs-track>
      <span class="hs-ai"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg></span>
      <span><b>Track your repair</b><small>Get your repair status</small></span>
    </button>
  </div>
  <div class="hs-result" data-hs-result aria-live="polite" hidden></div>

  <div class="hs-popular">
    <span>Popular:</span>
    {popular.map((p) => <a href={p.href} data-href={p.href} class="hs-chip" data-hs-chip>{p.label}</a>)}
  </div>
</div>

<!-- Track your repair -->
<div class="tr" data-tr hidden>
  <div class="tr-bg" data-tr-x></div>
  <div class="tr-card" role="dialog" aria-modal="true" aria-labelledby="tr-title">
    <button type="button" class="tr-x" data-tr-x aria-label="Close">×</button>
    <span class="tr-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg></span>
    <h2 id="tr-title">Track your repair</h2>
    <p>Enter your booking reference or the phone number you booked with. Our team replies on WhatsApp with the latest status.</p>
    <ol class="tr-steps" aria-label="Repair stages">
      <li>Booked</li><li>Picked up / visited</li><li>Diagnosed</li><li>Repairing</li><li>Ready / delivered</li>
    </ol>
    <form class="tr-form" data-tr-form novalidate>
      <input name="ref" placeholder="Booking ref or phone" autocomplete="tel" aria-label="Booking reference or phone" />
      <button type="submit"><Fragment set:html={waIcon} />Check status</button>
    </form>
    <p class="tr-msg" data-tr-msg aria-live="polite"></p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-hs]');
  if (root) {
    const tel = root.dataset.tel!;
    const cats: { id: string; words: string[] }[] = JSON.parse(root.dataset.cats!);
    const geo = JSON.parse(root.dataset.geo!) as { areaGeo: Record<string, [number, number]>; branchGeo: { name: string; at: [number, number] }[]; doorstep: string[]; pickup: string[] };
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const result = root.querySelector<HTMLElement>('[data-hs-result]')!;
    let area = '';
    try { area = localStorage.getItem('area') ?? ''; } catch {}

    // Carry the area into Services links.
    const withArea = (href: string) => {
      if (!area) return href;
      const u = new URL(href, location.origin);
      u.searchParams.set('area', area);
      return u.pathname + u.search + u.hash;
    };
    const linkify = () => root.querySelectorAll<HTMLAnchorElement>('[data-hs-chip]').forEach((a) => (a.href = withArea(a.dataset.href!)));

    // search
    const findForm = root.querySelector<HTMLFormElement>('[data-hs-find]')!;
    findForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = (findForm.elements.namedItem('q') as HTMLInputElement).value.trim();
      const q = norm(raw);
      const cat = q && cats.find((c) => c.words.some((w) => w === q || (q.length > 3 && w.startsWith(q))));
      location.href = withArea(!q ? '/services#catalog' : cat ? `/services?cat=${cat.id}#catalog` : `/services?q=${encodeURIComponent(raw)}#catalog`);
    });

    // ---- Find my location (computed on the device; nothing is sent to us) ----
    const km = (a: [number, number], b: [number, number]) => {
      const R = 6371, r = Math.PI / 180;
      const dLa = (b[0] - a[0]) * r, dLo = (b[1] - a[1]) * r;
      const h = Math.sin(dLa / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLo / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    };
    const show = (html: string, cls: string) => { result.hidden = false; result.className = `hs-result ${cls}`; result.innerHTML = html; };
    const locBtn = root.querySelector<HTMLButtonElement>('[data-hs-locate]')!;
    locBtn.addEventListener('click', () => {
      if (!navigator.geolocation) { show('Your browser can\'t share location. Try the search above instead.', 'warn'); return; }
      locBtn.classList.add('busy');
      show('<span class="spin"></span> Finding your location…', 'wait');
      navigator.geolocation.getCurrentPosition((pos) => {
        locBtn.classList.remove('busy');
        const me: [number, number] = [pos.coords.latitude, pos.coords.longitude];
        const near = Object.entries(geo.areaGeo).map(([n, at]) => ({ n, d: km(me, at) })).sort((a, b) => a.d - b.d)[0];
        const br = geo.branchGeo.map((b) => ({ ...b, d: km(me, b.at) })).sort((a, b) => a.d - b.d)[0];
        const covered = near.d <= 12;
        if (covered) {
          area = near.n;
          try { localStorage.setItem('area', area); } catch {}
          linkify();
          const modes = [geo.doorstep.includes(near.n) && 'Doorstep', geo.pickup.includes(near.n) && 'Pickup'].filter(Boolean).join(' & ');
          show(`<b>📍 You're near ${esc(near.n)}</b><span>✓ We cover your area — ${modes} available. Nearest branch: ${esc(br.name)} (${Math.round(br.d)} km).</span><a href="${withArea('/services#catalog')}">Book a repair here →</a>`, 'ok');
        } else {
          show(`<b>📍 Nearest branch: ${esc(br.name)} — ${Math.round(br.d)} km away</b><span>Your spot isn't on our coverage list yet. Message us and we'll confirm if we can reach you.</span><a href="https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat, do you cover my location? https://maps.google.com/?q=${me[0].toFixed(5)},${me[1].toFixed(5)}`)}" target="_blank" rel="noopener">Ask on WhatsApp →</a>`, 'warn');
        }
      }, (err) => {
        locBtn.classList.remove('busy');
        show(err.code === 1 ? 'Location permission was blocked. Allow location for this site in your browser, or search for your service above.' : 'Couldn\'t get your location right now — please try again.', 'warn');
      }, { enableHighAccuracy: false, timeout: 12000, maximumAge: 60000 });
    });

    // ---- Track your repair ----
    const tr = document.querySelector<HTMLElement>('[data-tr]')!;
    const openTr = () => { tr.hidden = false; requestAnimationFrame(() => tr.classList.add('in')); tr.querySelector<HTMLInputElement>('input')!.focus(); };
    const closeTr = () => { tr.classList.remove('in'); setTimeout(() => (tr.hidden = true), 300); };
    root.querySelector('[data-hs-track]')!.addEventListener('click', openTr);
    document.querySelectorAll('[data-track-open]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); openTr(); }));
    tr.querySelectorAll('[data-tr-x]').forEach((b) => b.addEventListener('click', closeTr));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !tr.hidden) closeTr(); });
    tr.querySelector<HTMLFormElement>('[data-tr-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = String(new FormData(e.target as HTMLFormElement).get('ref') ?? '').trim();
      const msg = tr.querySelector<HTMLElement>('[data-tr-msg]')!;
      if (v.length < 4) { msg.className = 'tr-msg err'; msg.textContent = 'Please enter your booking reference or phone number.'; return; }
      window.open(`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat, please share the status of my repair. Reference / phone: ${v}`)}`, '_blank', 'noopener');
      msg.className = 'tr-msg ok';
      msg.textContent = 'Opening WhatsApp — send the message and our team will reply with your status.';
    });

    linkify();
  }
</script>

<style>
  .hs { display: grid; gap: 14px; margin-top: 26px; max-width: 600px; }
  .hs-row { display: flex; border-radius: 14px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); transition: border-color .2s; }
  .hs-row:focus-within { border-color: var(--violet); }
  .hs-field { flex: 1; display: flex; align-items: center; gap: 12px; padding: 0 16px; min-width: 0; }
  .hs-field svg { width: 20px; height: 20px; color: var(--ink-3); flex: none; }
  .hs-field input { flex: 1; min-width: 0; height: 56px; border: 0; background: none; outline: none; font: inherit; font-size: 16px; color: var(--ink); }
  .hs-btn { border: 0; background: var(--violet); color: var(--on-accent); transition: filter .2s; }
  .hs-btn:hover { filter: brightness(1.08); }
  .hs-icon { width: 76px; display: grid; place-items: center; }
  .hs-icon svg { width: 22px; height: 22px; }

  .hs-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .hs-act { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--ink); text-align: left; box-shadow: var(--shadow); transition: transform .2s, border-color .2s; }
  .hs-act:hover { transform: translateY(-2px); border-color: var(--violet); }
  .hs-ai { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--accent-soft); color: var(--violet); flex: none; }
  .hs-ai svg { width: 21px; height: 21px; }
  .hs-act b { display: block; font-size: 15px; }
  .hs-act small { font-size: 12.5px; color: var(--ink-3); }
  .hs-act.busy .hs-ai svg { animation: hsPulse .9s ease-in-out infinite; }
  @keyframes hsPulse { 50% { transform: translateY(-3px); } }

  .hs-result { display: grid; gap: 4px; padding: 14px 16px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; color: var(--ink-2); animation: hsIn .3s ease; }
  .hs-result[hidden] { display: none; }
  @keyframes hsIn { from { opacity: 0; transform: translateY(6px); } }
  .hs-result.ok { border-color: var(--lime); }
  .hs-result :global(b) { color: var(--ink); font-size: 15px; }
  .hs-result.ok :global(span) { color: var(--lime); font-weight: 600; }
  .hs-result :global(a) { justify-self: start; margin-top: 4px; font-weight: 700; color: var(--violet); }
  .hs-result :global(.spin) { display: inline-block; width: 14px; height: 14px; margin-right: 6px; vertical-align: -2px; border: 2px solid var(--line); border-top-color: var(--violet); border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .hs-popular { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 2px; }
  .hs-popular span { font-size: 14px; font-weight: 700; color: var(--violet); margin-right: 4px; }
  .hs-chip { padding: 8px 14px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; color: var(--ink-2); transition: border-color .2s, color .2s; }
  .hs-chip:hover { border-color: var(--violet); color: var(--violet); }
  @media (max-width: 480px) { .hs-actions { grid-template-columns: 1fr; } .hs-icon { width: 56px; } }

  .tr { position: fixed; inset: 0; z-index: 92; display: grid; place-items: center; padding: 16px; color: var(--ink); }
  .tr[hidden] { display: none; }
  .tr-bg { position: absolute; inset: 0; background: rgba(8, 14, 12, .55); backdrop-filter: blur(5px); opacity: 0; transition: opacity .3s; }
  .tr.in .tr-bg { opacity: 1; }
  .tr-card { position: relative; width: min(480px, 100%); display: grid; gap: 14px; padding: 30px 28px 26px; background: var(--surface); border-radius: 26px; box-shadow: 0 40px 100px -30px rgba(0,0,0,.6); transform: translateY(24px) scale(.96); opacity: 0; transition: transform .45s cubic-bezier(.2,1.2,.3,1), opacity .3s; }
  .tr.in .tr-card { transform: none; opacity: 1; }
  .tr-x { position: absolute; right: 14px; top: 14px; width: 34px; height: 34px; border: 0; border-radius: 50%; background: var(--tint-2); font-size: 20px; line-height: 1; color: var(--ink); }
  .tr-ico { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--accent-soft); color: var(--violet); }
  .tr-ico svg { width: 28px; height: 28px; }
  .tr-card h2 { font-size: 26px; }
  .tr-card > p { font-size: 14.5px; color: var(--ink-2); }
  .tr-steps { list-style: none; margin: 4px 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; counter-reset: s; }
  .tr-steps li { position: relative; display: grid; justify-items: center; gap: 6px; font-size: 11px; color: var(--ink-3); text-align: center; line-height: 1.25; counter-increment: s; }
  .tr-steps li::before { content: counter(s); display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--line); font-size: 12px; font-weight: 700; color: var(--ink-3); background: var(--surface); }
  .tr-form { display: flex; gap: 8px; }
  .tr-form input { flex: 1; min-width: 0; height: 52px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; outline: none; font: inherit; background: var(--surface); color: var(--ink); }
  .tr-form input:focus { border-color: var(--violet); }
  .tr-form button { display: inline-flex; align-items: center; gap: 8px; padding: 0 18px; border: 0; border-radius: 12px; background: #25d366; color: #fff; font-weight: 700; white-space: nowrap; }
  .tr-form button :global(svg) { width: 18px; height: 18px; }
  .tr-msg { font-size: 13px; min-height: 1em; }
  .tr-msg.err { color: #be123c; }
  .tr-msg.ok { color: var(--lime); }
</style>

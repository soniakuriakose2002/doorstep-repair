---
import Base from '../layouts/Base.astro';
import MediaFrame from '../components/MediaFrame.astro';
import HeroSearch from '../components/HeroSearch.astro';
import { site, price, whatsappLink, branchList, brandsCarried } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';

// "How we operate" — the three ways in, as on fixsquad.ae
const ways = [
  {
    title: 'Pickup & Delivery',
    body: 'A rider collects your device from home or office, our lab repairs it, and it comes back to the same address.',
    more: 'Check pickup areas', href: '/services?mode=pickup#modes', msg: 'Hello Danat — I would like a pickup for my',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>',
  },
  {
    title: 'Doorstep Repair',
    body: 'A technician comes to you with parts and tools and repairs it on the spot. CCTV and networking are installed on-site.',
    more: 'Check doorstep areas', href: '/services?mode=doorstep#modes', msg: 'Hello Danat — I would like a doorstep repair for my',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>',
  },
  {
    title: 'In-Store Visit',
    body: 'Walk into any of our branches in Ruwi, Sohar or Salalah for a diagnosis and repair over the counter.',
    more: 'Find a branch', href: '#branches', msg: 'Hello Danat — I would like to bring in my',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9M3 9h18M3 9v11h18V9M9 20v-6h6v6"/></svg>',
  },
];

const formats = [
  { id: 'image', label: 'Image' },
  { id: 'post', label: 'Post' },
  { id: 'video', label: 'Video' },
] as const;
const angles = [
  { id: 'flat', label: '0° Flat' },
  { id: 'tilt', label: '15° Tilt' },
  { id: 'iso', label: '3D Isometric' },
] as const;
---

<Base>
  <!-- ============ HERO + MEDIA ANGLE LAB ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" data-reveal>Doorstep electronics repair</span>
        <h1 class="h-xl" data-reveal style="--d:.08s">
          Technology, <span class="grad-text">repaired right.</span>
        </h1>
        <p class="devices-line" data-reveal style="--d:.12s">Phone &bull; Laptop &bull; Computer &bull; Printer &bull; CCTV &bull; Networking</p>
        <p class="lead" data-reveal style="--d:.16s">
          A technician comes to your door, or we pick it up and bring it back repaired.
          The estimate is <span class="price-tag">{price()}</span>.
        </p>
        <div data-reveal style="--d:.2s"><HeroSearch /></div>
        <div class="hero-cta" data-reveal style="--d:.24s">
          <a href={whatsappLink()} class="btn btn-wa" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp us</a>
          <a href={`tel:${site.phone.tel}`} class="btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> {site.phone.display}</a>
          <a href="/services#book" class="btn btn-primary">Book a repair</a>
        </div>
        <ul class="hero-facts" data-reveal style="--d:.32s">
          <li><b>{totals.categories}</b> device types</li>
          <li><b>{totals.models}+</b> models</li>
          <li><b>{price()}</b> estimate</li>
        </ul>
      </div>

      <div class="lab" id="lab" data-format="video" data-angle="tilt" data-reveal style="--d:.2s">
        <MediaFrame />
        <div class="lab-panel glass">
          <div class="lab-row">
            <span class="lab-label">Format</span>
            <div class="seg" role="group" aria-label="Media format">
              {formats.map((f) => <button type="button" data-set-format={f.id} aria-pressed={f.id === 'video' ? 'true' : 'false'}>{f.label}</button>)}
            </div>
          </div>
          <div class="lab-row">
            <span class="lab-label">Angle</span>
            <div class="seg" role="group" aria-label="Media angle">
              {angles.map((a) => <button type="button" data-set-angle={a.id} aria-pressed={a.id === 'tilt' ? 'true' : 'false'}>{a.label}</button>)}
            </div>
          </div>
          <div class="lab-foot">
            <span class="lab-now">Showing <b data-now>Video · 15° Tilt</b></span>
            <button type="button" class="lab-link" data-copy>Copy link to this look</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BRANDS WE WORK WITH (Fixsquad: partner strip) ============ -->
  <section class="partners" aria-label="Brands we work with">
    <div class="wrap partners-inner">
      <span class="partners-label">Brands we service &amp; supply</span>
      <div class="marquee">
        <div class="marquee-track">
          {[...brandsCarried, ...brandsCarried].map((b, i) => <span class="marquee-item" aria-hidden={i >= brandsCarried.length ? 'true' : undefined}>{b}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DEVICE GRID (Fixsquad: "We Fix Things Close To Your Heart") ============ -->
  <section class="section tight-top">
    <div class="wrap center-head">
      <span class="eyebrow" data-reveal>What we fix</span>
      <h2 class="h-lg" data-reveal style="--d:.06s">We fix the tech you rely on</h2>
      <p class="lead" data-reveal style="--d:.1s">Pick your device to see every brand and model we repair — all at {price()} while pricing is being finalised.</p>
    </div>
    <div class="wrap">
      <ul class="dev-grid">
        {categories.map((c, i) => (
          <li data-reveal style={`--d:${i * .05}s; --h:${c.hue}`}>
            <a href={`/services?cat=${c.id}#catalog`} class="dev">
              <span class="dev-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
              <b>{c.name}</b>
              <small>{c.brands.length} brands · {c.brands.reduce((n, b) => n + b.models.length, 0)} models</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ STATS (Fixsquad: numbers strip) — only facts we can stand behind ============ -->
  <section class="stats-band" aria-label="Danat in numbers">
    <div class="wrap stats">
      <div data-reveal><b>{site.since}</b><span>Serving {site.country} since</span></div>
      <div data-reveal style="--d:.06s"><b>{site.branches.length}</b><span>Branches — Ruwi, Sohar, Salalah</span></div>
      <div data-reveal style="--d:.12s"><b>{totals.categories}</b><span>Device types repaired</span></div>
      <div data-reveal style="--d:.18s"><b>{totals.models}+</b><span>Models covered</span></div>
    </div>
  </section>

  <!-- ============ HOW WE OPERATE (Fixsquad: three approaches) ============ -->
  <section class="section">
    <div class="wrap center-head">
      <span class="eyebrow" data-reveal>How we operate</span>
      <h2 class="h-lg" data-reveal style="--d:.06s">Three ways to get it fixed</h2>
    </div>
    <div class="wrap ways">
      {ways.map((w, i) => (
        <article class="way" data-reveal style={`--d:${i * .08}s`}>
          <span class="way-ico" aria-hidden="true" set:html={w.icon} />
          <h3>{w.title}</h3>
          <p>{w.body}</p>
          <div class="way-cta">
            <a class="btn btn-wa" href={whatsappLink(w.msg)} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp</a>
            <a class="btn" href={`tel:${site.phone.tel}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> Call</a>
          </div>
          <a class="way-more" href={w.href}>{w.more} →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ BRANCHES (Fixsquad: service centres + city tabs + map) ============ -->
  <section class="section branches-sec" id="branches">
    <div class="wrap center-head">
      <span class="eyebrow" data-reveal>Visit us</span>
      <h2 class="h-lg" data-reveal style="--d:.06s">You're welcome at any of our branches</h2>
    </div>
    <div class="wrap">
      <div class="br-tabs" role="tablist" aria-label="Branch city">
        {branchList.map((b, i) => <button type="button" role="tab" data-br-tab={b.id} aria-selected={i === 0 ? 'true' : 'false'}>{b.tab}</button>)}
      </div>
      {branchList.map((b, i) => (
        <div class="br-panel" data-br-panel={b.id} hidden={i !== 0} role="tabpanel">
          <div class="br-card">
            {b.head && <span class="br-badge">Head office</span>}
            <h3>{b.name}</h3>
            <p class="br-city">{b.city}</p>
            <dl>
              <div><dt>Address</dt><dd>{b.address ?? 'Street address to be confirmed'}</dd></div>
              <div><dt>Phone</dt><dd>{b.phone ? <a href={`tel:${b.tel}`}>{b.phone}</a> : <a href={`tel:${site.phone.tel}`}>{site.phone.display} (head office)</a>}</dd></div>
              <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            </dl>
            <div class="way-cta">
              <a class="btn btn-primary" href={`https://www.google.com/maps/search/?api=1&query=${b.lat},${b.lon}`} target="_blank" rel="noopener">Get directions</a>
              <a class="btn btn-wa" href={whatsappLink(`Hello Danat ${b.tab} — I need a repair for my`)} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp</a>
            </div>
            {!b.precise && <p class="br-note">Map shows the city — the exact shop location is being confirmed.</p>}
          </div>
          <iframe
            class="br-map"
            title={`Map of ${b.name}`}
            loading="lazy"
            src={`https://www.openstreetmap.org/export/embed.html?bbox=${b.lon - (b.precise ? .012 : .06)}%2C${b.lat - (b.precise ? .008 : .04)}%2C${b.lon + (b.precise ? .012 : .06)}%2C${b.lat + (b.precise ? .008 : .04)}&layer=mapnik${b.precise ? `&marker=${b.lat}%2C${b.lon}` : ''}`}
          ></iframe>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="cta glass" data-reveal>
        <h2 class="h-lg">Something broken? <span class="grad-text">Stay home.</span></h2>
        <p class="lead">Pick doorstep or pickup, choose your device, and we take it from there.</p>
        <a href="/services#book" class="btn btn-primary">Start a booking</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const lab = document.getElementById('lab')!;
  const names: Record<string, string> = { image: 'Image', post: 'Post', video: 'Video', flat: '0° Flat', tilt: '15° Tilt', iso: '3D Isometric' };
  const FORMATS = ['image', 'post', 'video'];
  const ANGLES = ['flat', 'tilt', 'iso'];

  // Videos only load and play while they are on screen and displayed.
  const onScreen = new Set<HTMLVideoElement>();
  const syncVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((v) => {
      const shown = v.offsetParent !== null && onScreen.has(v);
      if (shown) {
        if (!v.src) v.src = v.dataset.src!;
        v.play().catch(() => {});
      } else if (!v.paused) v.pause();
    });
  };
  const vio = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      e.isIntersecting ? onScreen.add(v) : onScreen.delete(v);
    });
    syncVideos();
  });
  document.querySelectorAll('video[data-src]').forEach((v) => vio.observe(v));

  const press = (sel: string, attr: string, val: string) =>
    document.querySelectorAll<HTMLButtonElement>(`[${sel}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(sel) === val)));

  const apply = (format: string, angle: string, writeUrl = true) => {
    if (!FORMATS.includes(format)) format = 'video';
    if (!ANGLES.includes(angle)) angle = 'tilt';
    lab.dataset.format = format;
    lab.dataset.angle = angle;
    press('data-set-format', 'aria-pressed', format);
    press('data-set-angle', 'aria-pressed', angle);
    document.querySelector('[data-now]')!.textContent = `${names[format]} · ${names[angle]}`;

    if (writeUrl) {
      const u = new URL(location.href);
      u.searchParams.set('format', format);
      u.searchParams.set('angle', angle);
      history.replaceState(null, '', u);
    }
    requestAnimationFrame(syncVideos);
  };

  const q = new URLSearchParams(location.search);
  apply(q.get('format') ?? 'video', q.get('angle') ?? 'tilt', q.has('format') || q.has('angle'));

  document.querySelectorAll<HTMLButtonElement>('[data-set-format]').forEach((b) =>
    b.addEventListener('click', () => apply(b.dataset.setFormat!, lab.dataset.angle!)));
  document.querySelectorAll<HTMLButtonElement>('[data-set-angle]').forEach((b) =>
    b.addEventListener('click', () => apply(lab.dataset.format!, b.dataset.setAngle!)));

  // Branch city tabs
  document.querySelectorAll<HTMLButtonElement>('[data-br-tab]').forEach((t) => t.addEventListener('click', () => {
    document.querySelectorAll('[data-br-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    document.querySelectorAll<HTMLElement>('[data-br-panel]').forEach((p) => (p.hidden = p.dataset.brPanel !== t.dataset.brTab));
  }));

  const copy = document.querySelector<HTMLButtonElement>('[data-copy]')!;
  copy.addEventListener('click', async () => {
    const u = new URL(location.href);
    u.searchParams.set('format', lab.dataset.format!);
    u.searchParams.set('angle', lab.dataset.angle!);
    u.hash = 'lab';
    try {
      await navigator.clipboard.writeText(u.href);
      copy.textContent = 'Link copied';
    } catch {
      copy.textContent = u.search;
    }
    setTimeout(() => (copy.textContent = 'Copy link to this look'), 1800);
  });
</script>

<style>
  .hero { padding: clamp(24px, 3vw, 40px) 0 40px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .hero-copy h1 { margin: 16px 0 18px; font-size: clamp(36px, 4.6vw, 64px); line-height: 1.02; }
  .devices-line { font-size: clamp(15px, 1.3vw, 18px); font-weight: 600; color: var(--ink); margin: -6px 0 16px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hero-facts {
    display: flex;
    gap: 28px;
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    color: var(--ink-3);
    font-size: 14px;
  }
  .hero-facts b { display: block; font-family: var(--display); font-size: 26px; color: var(--ink); }

  .lab { display: flex; flex-direction: column; gap: 18px; }
  .lab-panel { padding: 16px; display: grid; gap: 12px; }
  .lab-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .lab-label { width: 56px; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .lab-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 12px; }
  .lab-now b { color: var(--ink); font-weight: 600; }
  .lab-link { border: 0; background: none; padding: 0; color: var(--cyan); font-size: 13px; }
  .lab-link:hover { text-decoration: underline; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .lab-label { width: 100%; }
    .seg button { padding: 8px 12px; font-size: 13px; }
  }

  /* modes */
  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .mode {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
    overflow: hidden;
    transition: transform .35s, border-color .35s;
  }
  .mode::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: radial-gradient(600px circle at 0% 0%, rgba(var(--a1), .22), transparent 45%);
    opacity: .7;
    pointer-events: none;
  }
  .mode:nth-child(2)::before { background: radial-gradient(600px circle at 100% 0%, rgba(var(--a2), .2), transparent 45%); }
  .mode:hover { transform: translateY(-6px); border-color: rgba(20, 22, 60, .2); }
  .mode p { color: var(--ink-2); }
  .mode-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--grad); color: var(--on-accent); }
  .mode-icon svg { width: 28px; height: 28px; }
  .mode-steps { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .mode-steps li { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; background: rgba(20, 22, 60, .05); font-size: 14px; }
  .mode-steps span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: rgba(20, 22, 60, .12); font-size: 12px; font-weight: 600; }
  .mode-foot { margin-top: auto; padding-top: 8px; color: var(--cyan); font-weight: 600; }
  @media (max-width: 760px) { .modes { grid-template-columns: 1fr; } }

  /* brands + issues */
  .brands-band { padding-top: 40px; }
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 22px 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .marquee-track { display: flex; gap: 56px; width: max-content; animation: marquee 40s linear infinite; }
  .marquee-item { font-family: var(--display); font-size: clamp(22px, 3vw, 34px); font-weight: 600; color: var(--ink-3); white-space: nowrap; transition: color .3s; }
  .marquee-item:hover { color: var(--ink); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .issues { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 48px; align-items: center; }
  .issues h2 { margin: 14px 0 14px; }
  .issues .btn { margin-top: 28px; }
  .issue-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .issue { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 16px; transition: transform .25s, border-color .25s; }
  .issue:hover { transform: translateY(-3px); border-color: hsl(var(--h) 70% 55% / .5); }

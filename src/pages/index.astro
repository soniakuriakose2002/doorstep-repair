---
import Base from '../layouts/Base.astro';
import MediaFrame from '../components/MediaFrame.astro';
import HeroSearch from '../components/HeroSearch.astro';
import { reviews, sample } from '../data/reviews';
import Testimonials from '../components/Testimonials.astro';
import { serviceModes, price, site } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';

const allBrands = [...new Set(categories.flatMap((c) => c.brands.map((b) => b.name)))];

const formats = [
  { id: 'image', label: 'Image' },
  { id: 'post', label: 'Post' },
  { id: 'video', label: 'Video' },
] as const;
const angles = [
  { id: 'flat', label: '0° Flat' },
  { id: 'tilt', label: '15° Tilt' },
  { id: 'iso', label: '3D Isometric' },
] as const;
---

<Base>
  <!-- ============ HERO + MEDIA ANGLE LAB ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" data-reveal>Doorstep electronics repair</span>
        <h1 class="h-xl" data-reveal style="--d:.08s">
          Technology, <span class="grad-text">repaired right.</span>
        </h1>
        <p class="devices-line" data-reveal style="--d:.12s">Phone &bull; Laptop &bull; Computer &bull; Printer &bull; CCTV &bull; Networking</p>
        <p class="lead" data-reveal style="--d:.16s">
          A technician comes to your door, or we pick it up and bring it back repaired.
          The estimate is <span class="price-tag">{price()}</span>.
        </p>
        <div data-reveal style="--d:.2s"><HeroSearch /></div>
        <div class="hero-cta" data-reveal style="--d:.24s">
          <a href="/services#book" class="btn btn-primary">
            Book doorstep repair
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/services" class="btn">See brands & areas</a>
        </div>
        <ul class="hero-facts" data-reveal style="--d:.32s">
          <li><b>{totals.categories}</b> device types</li>
          <li><b>{totals.models}+</b> models</li>
          <li><b>{price()}</b> estimate</li>
        </ul>
      </div>

      <div class="lab" id="lab" data-format="video" data-angle="tilt" data-reveal style="--d:.2s">
        <MediaFrame />
        <div class="lab-panel glass">
          <div class="lab-row">
            <span class="lab-label">Format</span>
            <div class="seg" role="group" aria-label="Media format">
              {formats.map((f) => <button type="button" data-set-format={f.id} aria-pressed={f.id === 'video' ? 'true' : 'false'}>{f.label}</button>)}
            </div>
          </div>
          <div class="lab-row">
            <span class="lab-label">Angle</span>
            <div class="seg" role="group" aria-label="Media angle">
              {angles.map((a) => <button type="button" data-set-angle={a.id} aria-pressed={a.id === 'tilt' ? 'true' : 'false'}>{a.label}</button>)}
            </div>
          </div>
          <div class="lab-foot">
            <span class="lab-now">Showing <b data-now>Video · 15° Tilt</b></span>
            <button type="button" class="lab-link" data-copy>Copy link to this look</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICE MODES ============ -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Two ways to repair</span>
      <h2 class="h-lg" data-reveal style="--d:.06s">Choose how we reach you</h2>
      <div class="modes">
        {serviceModes.map((m, i) => (
          <a href={`/services?mode=${m.id}#modes`} class="mode glass" data-reveal style={`--d:${.1 + i * .1}s`}>
            <span class="mode-icon" aria-hidden="true">
              {m.id === 'doorstep' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>
              )}
            </span>
            <h3 class="h-md">{m.title}</h3>
            <p>{m.body}</p>
            <ol class="mode-steps">
              {m.steps.map((s, n) => <li><span>{n + 1}</span>{s}</li>)}
            </ol>
            <span class="mode-foot">Check your area <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BRAND MARQUEE + ISSUES ============ -->
  <section class="section brands-band">
    <div class="marquee" aria-label="Brands we repair">
      <div class="marquee-track">
        {[...allBrands, ...allBrands].map((b) => <span class="marquee-item">{b}</span>)}
      </div>
    </div>
    <div class="wrap issues">
      <div>
        <span class="eyebrow" data-reveal>What we fix</span>
        <h2 class="h-lg" data-reveal style="--d:.06s">Every device, all at {price()}</h2>
        <p class="lead" data-reveal style="--d:.12s">Pricing is not live yet, so every repair shows a zero estimate for now.</p>
        <a href="/services#catalog" class="btn" data-reveal style="--d:.18s">Browse all brands & models</a>
      </div>
      <ul class="issue-grid">
        {categories.map((c, i) => (
          <li data-reveal style={`--d:${i * .05}s; --h:${c.hue}`}>
            <a href={`/services?cat=${c.id}#catalog`} class="issue glass">
              <span class="issue-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
              <span class="issue-text"><b>{c.name}</b><small>{c.short}</small></span>
              <span class="price-tag">{price()}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ WHAT OUR CLIENTS SAY ============ -->
  <section class="section" id="reviews">
    <Testimonials />
    <div class="wrap rv4">
      <div class="tst" data-tst>
        <div class="tst-intro">
          <span class="tst-eyebrow">Testimonials</span>
          <h2>What our clients say</h2>
          <p>Doorstep visits, pickups and installs across {site.country} — in our customers’ words.</p>
          {sample && <span class="tst-sample">Sample reviews — real ones coming soon</span>}
          <div class="tst-ctrl">
            <button type="button" data-tst-prev aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
            <button type="button" data-tst-next aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
            <span class="tst-count"><b data-tst-n>01</b> / {String(reviews.length).padStart(2, '0')}</span>
          </div>
          <div class="tst-bar"><i data-tst-bar></i></div>
        </div>

        <div class="tst-stage">
          <div class="tst-deck" aria-live="polite">
            {reviews.map((r, i) => (
              <figure class="tq" data-tq={i}>
                <svg class="tq-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 10C11 13 6 20 6 29v9h14V24h-8c0-6 3-9 9-11zM42 10c-9 3-14 10-14 19v9h14V24h-8c0-6 3-9 9-11z" /></svg>
                <span class="tq-tag">{r.service}</span>
                <blockquote>{r.text}</blockquote>
                <figcaption>
                  <span class="tq-av">{r.area[0]}</span>
                  <span class="tq-who"><b>{r.name}</b><small>{r.area}</small></span>
                  <span class="tq-stars" aria-label={`${r.rating} out of 5`}>
                    {[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 24 24" class:list={[{ off: n > r.rating }]}><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>)}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class="tst-tabs" role="tablist" aria-label="Choose a review">
            {reviews.map((r, i) => <button type="button" role="tab" data-tst-go={i}>{r.service}</button>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============ CTA ============ -->  <section class="section">
    <div class="wrap">
      <div class="cta glass" data-reveal>
        <h2 class="h-lg">Something broken? <span class="grad-text">Stay home.</span></h2>
        <p class="lead">Pick doorstep or pickup, choose your device, and we take it from there.</p>
        <a href="/services#book" class="btn btn-primary">Start a booking</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const lab = document.getElementById('lab')!;
  const names: Record<string, string> = { image: 'Image', post: 'Post', video: 'Video', flat: '0° Flat', tilt: '15° Tilt', iso: '3D Isometric' };
  const FORMATS = ['image', 'post', 'video'];
  const ANGLES = ['flat', 'tilt', 'iso'];

  // Videos only load and play while they are on screen and displayed.
  const onScreen = new Set<HTMLVideoElement>();
  const syncVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((v) => {
      const shown = v.offsetParent !== null && onScreen.has(v);
      if (shown) {
        if (!v.src) v.src = v.dataset.src!;
        v.play().catch(() => {});
      } else if (!v.paused) v.pause();
    });
  };
  const vio = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      e.isIntersecting ? onScreen.add(v) : onScreen.delete(v);
    });
    syncVideos();
  });
  document.querySelectorAll('video[data-src]').forEach((v) => vio.observe(v));

  const press = (sel: string, attr: string, val: string) =>
    document.querySelectorAll<HTMLButtonElement>(`[${sel}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(sel) === val)));

  const apply = (format: string, angle: string, writeUrl = true) => {
    if (!FORMATS.includes(format)) format = 'video';
    if (!ANGLES.includes(angle)) angle = 'tilt';
    lab.dataset.format = format;
    lab.dataset.angle = angle;
    press('data-set-format', 'aria-pressed', format);
    press('data-set-angle', 'aria-pressed', angle);
    document.querySelector('[data-now]')!.textContent = `${names[format]} · ${names[angle]}`;

    if (writeUrl) {
      const u = new URL(location.href);
      u.searchParams.set('format', format);
      u.searchParams.set('angle', angle);
      history.replaceState(null, '', u);
    }
    requestAnimationFrame(syncVideos);
  };

  const q = new URLSearchParams(location.search);
  apply(q.get('format') ?? 'video', q.get('angle') ?? 'tilt', q.has('format') || q.has('angle'));

  document.querySelectorAll<HTMLButtonElement>('[data-set-format]').forEach((b) =>
    b.addEventListener('click', () => apply(b.dataset.setFormat!, lab.dataset.angle!)));
  document.querySelectorAll<HTMLButtonElement>('[data-set-angle]').forEach((b) =>
    b.addEventListener('click', () => apply(lab.dataset.format!, b.dataset.setAngle!)));

  // Testimonials deck: auto-advance, pause on hover, arrows, tabs
  const tst = document.querySelector<HTMLElement>('[data-tst]');
  if (tst) {
    const cards = [...tst.querySelectorAll<HTMLElement>('[data-tq]')];
    const tabs = [...tst.querySelectorAll<HTMLButtonElement>('[data-tst-go]')];
    const bar = tst.querySelector<HTMLElement>('[data-tst-bar]')!;
    const MS = 6000;
    let cur = 0, timer = 0, left = MS, started = 0, paused = false;
    const n = cards.length;
    const render = (prev?: number) => {
      cards.forEach((c, i) => {
        const pos = (i - cur + n) % n;
        c.dataset.pos = i === prev ? 'out' : pos < 3 ? String(pos) : 'hidden';
        c.setAttribute('aria-hidden', String(pos !== 0));
      });
      if (prev !== undefined) setTimeout(() => { const pos = (prev - cur + n) % n; cards[prev].dataset.pos = pos < 3 ? String(pos) : 'hidden'; }, 650);
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === cur)));
      tst.querySelector('[data-tst-n]')!.textContent = String(cur + 1).padStart(2, '0');
      bar.classList.remove('run'); void bar.offsetWidth; bar.classList.add('run');
    };
    const go = (i: number) => { const prev = cur; cur = (i + n) % n; render(prev !== cur && i === prev + 1 ? prev : undefined); schedule(MS); };
    const schedule = (ms: number) => { clearTimeout(timer); left = ms; started = Date.now(); if (!paused) timer = window.setTimeout(() => go(cur + 1), ms); };
    tst.style.setProperty('--tst-ms', `${MS}ms`);
    tst.addEventListener('pointerenter', () => { paused = true; clearTimeout(timer); left -= Date.now() - started; });
    tst.addEventListener('pointerleave', () => { paused = false; schedule(Math.max(left, 400)); });
    tst.querySelector('[data-tst-next]')!.addEventListener('click', () => go(cur + 1));
    tst.querySelector('[data-tst-prev]')!.addEventListener('click', () => go(cur - 1));
    tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    render();
    schedule(MS);
  }
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]')!;
  copy.addEventListener('click', async () => {
    const u = new URL(location.href);
    u.searchParams.set('format', lab.dataset.format!);
    u.searchParams.set('angle', lab.dataset.angle!);
    u.hash = 'lab';
    try {
      await navigator.clipboard.writeText(u.href);
      copy.textContent = 'Link copied';
    } catch {
      copy.textContent = u.search;
    }
    setTimeout(() => (copy.textContent = 'Copy link to this look'), 1800);
  });
</script>

<style>
  .hero { padding: clamp(24px, 3vw, 40px) 0 40px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .hero-copy h1 { margin: 16px 0 18px; font-size: clamp(36px, 4.6vw, 64px); line-height: 1.02; }
  .devices-line { font-size: clamp(15px, 1.3vw, 18px); font-weight: 600; color: var(--ink); margin: -6px 0 16px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hero-facts {
    display: flex;
    gap: 28px;
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    color: var(--ink-3);
    font-size: 14px;
  }
  .hero-facts b { display: block; font-family: var(--display); font-size: 26px; color: var(--ink); }

  .lab { display: flex; flex-direction: column; gap: 18px; }
  .lab-panel { padding: 16px; display: grid; gap: 12px; }
  .lab-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .lab-label { width: 56px; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .lab-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 12px; }
  .lab-now b { color: var(--ink); font-weight: 600; }
  .lab-link { border: 0; background: none; padding: 0; color: var(--cyan); font-size: 13px; }
  .lab-link:hover { text-decoration: underline; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .lab-label { width: 100%; }
    .seg button { padding: 8px 12px; font-size: 13px; }
  }

  /* modes */
  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .mode {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
    overflow: hidden;
    transition: transform .35s, border-color .35s;
  }
  .mode::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: radial-gradient(600px circle at 0% 0%, rgba(var(--a1), .22), transparent 45%);
    opacity: .7;
    pointer-events: none;
  }
  .mode:nth-child(2)::before { background: radial-gradient(600px circle at 100% 0%, rgba(var(--a2), .2), transparent 45%); }
  .mode:hover { transform: translateY(-6px); border-color: rgba(20, 22, 60, .2); }
  .mode p { color: var(--ink-2); }
  .mode-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--grad); color: var(--on-accent); }
  .mode-icon svg { width: 28px; height: 28px; }
  .mode-steps { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .mode-steps li { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; background: rgba(20, 22, 60, .05); font-size: 14px; }
  .mode-steps span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: rgba(20, 22, 60, .12); font-size: 12px; font-weight: 600; }
  .mode-foot { margin-top: auto; padding-top: 8px; color: var(--cyan); font-weight: 600; }
  @media (max-width: 760px) { .modes { grid-template-columns: 1fr; } }

  /* brands + issues */
  .brands-band { padding-top: 40px; }
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 22px 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    margin-bottom: clamp(56px, 8vw, 96px);
  }
  .marquee-track { display: flex; gap: 56px; width: max-content; animation: marquee 40s linear infinite; }
  .marquee-item { font-family: var(--display); font-size: clamp(22px, 3vw, 34px); font-weight: 600; color: var(--ink-3); white-space: nowrap; transition: color .3s; }
  .marquee-item:hover { color: var(--ink); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .issues { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 48px; align-items: center; }
  .issues h2 { margin: 14px 0 14px; }
  .issues .btn { margin-top: 28px; }
  .issue-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .issue { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 16px; transition: transform .25s, border-color .25s; }
  .issue:hover { transform: translateY(-3px); border-color: hsl(var(--h) 70% 55% / .5); }
  .issue-icon { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: hsl(var(--h) 70% var(--chip-l)); color: hsl(var(--h) 65% var(--chip-ink-l)); }
  .issue-icon svg { width: 22px; height: 22px; }
  .issue-text { display: grid; line-height: 1.3; flex: 1; min-width: 0; }
  .issue-text small { color: var(--ink-3); font-size: 13px; }
  @media (max-width: 860px) {
    .issues { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) { .issue-grid { grid-template-columns: 1fr; } }

  .cta {
    text-align: center;
    padding: clamp(40px, 7vw, 80px) 24px;
    display: grid;
    justify-items: center;
    gap: 18px;
    background:
      radial-gradient(circle at 20% 0%, rgba(var(--a1), .3), transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(var(--a2), .25), transparent 50%),
      var(--glass);
  }
  /* reviews — style 4: stacked deck on a bold panel (styles 1–3 in Testimonials.astro) */
  .rv4 { display: none; }
  :global(:root[data-reviews='4']) .rv4 { display: block; }
  .tst {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 48px; align-items: center;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 36px; color: #fff;
    background:
      radial-gradient(600px circle at 0% 0%, rgba(255,255,255,.14), transparent 55%),
      radial-gradient(500px circle at 100% 100%, rgba(255,255,255,.10), transparent 55%),
      linear-gradient(135deg, color-mix(in srgb, var(--violet) 88%, #000), color-mix(in srgb, var(--violet) 52%, #000));
  }
  .tst::after { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: radial-gradient(rgba(255,255,255,.12) 1px, transparent 1.4px); background-size: 22px 22px;
    mask-image: linear-gradient(90deg, #000, transparent 60%); }
  .tst-intro { position: relative; z-index: 1; display: grid; gap: 16px; justify-items: start; }
  .tst-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; opacity: .75; }
  .tst h2 { font-size: clamp(36px, 4.6vw, 60px); line-height: 1.02; color: #fff; }
  .tst-intro p { font-size: 17px; opacity: .8; max-width: 34ch; }
  .tst-sample { padding: 5px 12px; border-radius: 999px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25); font-size: 12px; font-weight: 600; }
  .tst-ctrl { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
  .tst-ctrl button { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; border: 1px solid rgba(255,255,255,.35); background: transparent; color: #fff; transition: background .2s, color .2s, transform .2s; }
  .tst-ctrl button:hover { background: #fff; color: var(--violet); transform: scale(1.06); }
  .tst-ctrl svg { width: 20px; height: 20px; }
  .tst-count { margin-left: 10px; font-size: 14px; opacity: .75; font-variant-numeric: tabular-nums; }
  .tst-count b { font-size: 22px; opacity: 1; }
  .tst-bar { width: 160px; height: 3px; border-radius: 3px; background: rgba(255,255,255,.2); overflow: hidden; }
  .tst-bar i { display: block; height: 100%; width: 0; background: #fff; }
  .tst-bar i.run { animation: tstBar var(--tst-ms, 6000ms) linear forwards; }
  .tst:hover .tst-bar i.run { animation-play-state: paused; }
  @keyframes tstBar { to { width: 100%; } }

  .tst-stage { position: relative; z-index: 1; display: grid; gap: 22px; }
  .tst-deck { position: relative; height: 300px; margin-top: 56px; }
  .tq {
